---
// /prototypes/air-exchange-rate-mobile — the MOBILE presentation of Option B.
// Not a fork: it is the same smaqmd-aer-wizard component in its `mobile` variant,
// so the steps, the fields and the whole calc engine are literally the same code
// as the wizard view and cannot drift from it. The variant drops the isometric
// scene (it needs width a phone has not got, and it is secondary to the answer)
// and steps every sizable esa-* lego up to `lg` for touch.
//
// Registered in src/data/prototypes.ts as its own entry rather than living behind
// Option B's view toggle: it is a device target, not another presentation of the
// same page, and it is the one view that should be opened directly on a phone.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmaqmdAerWizard from '../../components/smaqmd-aer-wizard.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../lib/base';
// .visually-hidden for the page h1 below. Imported on this page rather than in
// BaseLayout so the prototype pages that don't need it keep their exact output.
import '@esa/tokens/a11y.css';
---
<!-- manifest:
  layout: single flowed column (component-owned, no fixed overlay)
  sections:
    - back link          -> esa-button (href) to the prototype library
    - page h1            -> visually-hidden <h1> (the wizard's headings start at h2)
    - opening slide      -> smaqmd-aer-wizard (replaces esa-page-header)
    - wizard steps       -> smaqmd-aer-wizard variant="mobile" (no scene, lg controls)
-->
<BaseLayout title="Air Cleaner Calculator (Mobile) — SMAQMD">
  <main>
    <!-- THE PAGE h1. The wizard's headings all start at h2 (it is a section, and
         the same component also ships inside the standalone build, where a host
         page supplies the h1), and this page drops esa-page-header because the
         opening slide carries the visible title — so without this the document
         would have no top-level heading at all. Visually hidden rather than
         removed: it names the page for anyone navigating by heading, and it is
         first in reading order, ahead of the back link.
         .visually-hidden is the hub utility from @esa/tokens/a11y.css — the clip
         pattern is NOT hand-rolled here. -->
    <h1 class="visually-hidden">Air Cleaner Calculator</h1>
    <SmaqmdAerWizard variant="mobile">
      <!-- No esa-page-header here: its title and lede would restate the opening
           slide immediately above the same fold. The slide owns the question; the h1 above owns the
           document heading.

           No version toggle either. This is its own prototype now, not a fourth
           presentation of Option B, so the segmented switcher would offer three
           destinations that are all the desktop tool. BaseLayout ships no nav, so
           without SOMETHING here a phone has no way back out — hence the one link. -->
      <div slot="header">
        <EsaButton
          href={withBase('/')}
          variant="ghost"
          appearance="outline"
          size="lg"
          icon="arrow-left"
        >Prototype library</EsaButton>
      </div>
    </SmaqmdAerWizard>
  </main>
</BaseLayout>
