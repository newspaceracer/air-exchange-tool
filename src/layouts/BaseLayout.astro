---
// SMAQMD base layout — wires the hub tokens + the SMAQMD theme,
// loads the brand's fonts, and sets data-theme="smaqmd" so every
// inherited esa-* component re-skins to SMAQMD.
import '@esa/tokens/tokens.css';
import '@esa/tokens/component-tokens.css';
import '@esa/tokens/type-roles.css';
import '@esa/tokens/layouts.css';
import '../styles/theme-smaqmd.css';
// Runtime handoff inspector — dormant unless the current route has a bundle at
// public/handoff/<slug>/ (generated via `npx handoff`). Its own self-gate is a
// runtime fetch of that manifest, which logs a 404 on every route WITHOUT one;
// so we check at build/render time and mount it only where a bundle exists.
// The slug mirrors routeSlug() in @esa/handoff's inspector.client.ts.
import HandoffInspector from '@esa/handoff/HandoffInspector.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  title?: string;
}
const { title = 'SMAQMD' } = Astro.props;
const base = import.meta.env.BASE_URL;
let routePath = Astro.url.pathname;
if (routePath.startsWith(base)) routePath = routePath.slice(base.length);
const handoffSlug = routePath.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'index';
const hasHandoff = existsSync(join(process.cwd(), 'public', 'handoff', handoffSlug, 'manifest.json'));
---
<!doctype html>
<html lang="en" data-theme="smaqmd" data-a11y-assurance="wcag-aa">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300..700;1,300..700&family=Roboto+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--typography-font-family-sans, system-ui, sans-serif);
        font-weight: var(--typography-font-weight-regular, 350);
        color: var(--color-content-default, #3d3d3d);
        background: var(--color-background-elevation-raised, #fff);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--color-content-link, #43608a); text-decoration: none; }
      img { display: block; max-width: 100%; }
      button { font-family: inherit; cursor: pointer; background: none; border: 0; }
    </style>
  </head>
  <body>
    <slot />
    {hasHandoff && <HandoffInspector />}
  </body>
</html>
