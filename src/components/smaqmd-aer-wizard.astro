---
// smaqmd-aer-wizard — the WIZARD presentation of Option B. Identical math to
// smaqmd-aer-calculator-b (this file was forked from it), re-chromed from an
// always-open form into a gated linear flow:
// step 0 room → step 1 cleaners → step 2 target → step 3 result. Every field and
// the whole [data-result] subtree are byte-for-byte the classic view's, so the
// SAME calc script drives both — the differences are (a) the root is
// [data-aerb-wizard], (b) the inputs are wrapped in a smaqmd-wizard step shell,
// (c) a step-navigation block appended to the script, and (d) THE SCENE. Keep the
// calc/verdict logic in sync by porting changes across; presentation diverges on
// purpose, and since the interior rethink below so does the drawing: the older
// calculator-b and accordion views keep the house-exterior scene, and this file
// (plus its hand-ported vanilla mirror in public/aer-tool/) owns the interior one.
//
// A visual rethink built on a ROOM INTERIOR: the scene is a cutaway of the room
// itself — two back walls with windows and a door, an open floor you look down
// into, and furniture that fills the floor as the room grows. Each air cleaner is
// an appliance-sized unit standing on the floor near the front-right wall, sending
// soft concentric rings rippling outward across the floor and fading — a cleaning
// RADIUS pulsing once per air change, so you SEE the cadence the math describes
// without a literal in/out flow diagram. The cutaway resizes with the length/width/height you enter. The
// numbers (volume, air changes per hour, pass/fail vs target) come from the same
// workbook math as Option A (ACH = flow × 60 ÷ room volume).
//
// Composition: esa-card panels, esa-text-field inputs, esa-stat readouts,
// esa-alert-box verdict. The one bespoke part is the isometric room drawing —
// no esa-* lego renders a to-scale 3D scene, so it's a documented smaqmd- concern
// (see the bcn-lego-checked note on the .smaqmd-cityview markup; the class prefix
// predates the interior rethink and is kept so the vanilla mirror's stylesheet
// stays in lockstep). The scene is drawn from an array of cleaners (a ring pulse
// per unit), fed a single cleaner for now; the pulse is animated by rewriting plain
// SVG polygons on a rAF tick (no animation library yet) so GSAP/WAAPI can take over
// the motion later without touching the projection math.
// .visually-hidden for the step counter below — visible dots + step title carry
// the progress visually; the counter stays in the DOM for screen readers.
import '@esa/tokens/a11y.css';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-button.astro';
// "Where can I find this information?" — mounted TWICE below (cleaners step +
// result step) from ONE component so the two copies cannot drift apart.
import SmaqmdAerFindRatings from './smaqmd-aer-find-ratings.astro';

const MAX_CLEANERS = 4;
const CLEANER_IDS = [1, 2, 3, 4];
// Cleaner units split by SIDE, because the two sides paint at different depths
// (see the two unit blocks in the scene markup). The side assignment is FIXED by
// index and mirrored in layoutCleaners(): odd ids stand in the strip along the
// open front x=L edge, even ids against the back x=0 wall, directly across.
const FRONT_UNIT_IDS = CLEANER_IDS.filter((i) => i % 2 === 1);  // 1, 3 — x=L side
const BACK_UNIT_IDS = CLEANER_IDS.filter((i) => i % 2 === 0);   // 2, 4 — x=0 wall
const WINDOW_SLOTS = [1, 2];                    // per-wall window pool: one row, at most 2 per wall
const FURN_IDS = [1, 2, 3, 4, 5, 6, 7];         // floor-furniture pool, ordered BACK-TO-FRONT (see FURN_DEFS)
const roomMethods = [
  { label: 'Floor area + ceiling height', value: 'area' },
  { label: 'Length × width × height', value: 'dimensions' },
  { label: 'Room volume directly', value: 'volume' },
];
const unitOptions = [
  { label: 'Air flow rate / CADR in CFM (ft³/min)', value: 'airflow' },
  { label: 'Air changes per hour (ACH)', value: 'ach' },
];
// How the manufacturer's REFERENCE room is entered (ACH mode only). Same two
// shapes as the room step, minus "volume directly" — a spec sheet never quotes a
// reference volume. Area leads and is the default, matching the room step: spec
// sheets most often quote the test room as a coverage area ("up to 500 sq ft"),
// so the first option is the shape the user is most likely copying.
const refMethods = [
  { label: 'Floor area + ceiling height', value: 'area' },
  { label: 'Length × width × height', value: 'dimensions' },
];
// Step-2 fork: a shopper with no cleaner takes the "No" path straight to the
// minimum-CADR-to-buy result; a checker takes "Yes" and enters their cleaner(s).
const cleanerChoice = [
  { label: "Yes, I'll enter it", value: 'yes' },
  { label: 'No, show me what to buy', value: 'no' },
];
// Display-unit toggle for the result legend + diagram capacity label. Floor area
// (ft²) is the default relatable unit; ft³ is there for people who think in volume.
const unitToggle = [
  { label: 'ft²', value: 'ft2' },
  { label: 'ft³', value: 'ft3' },
];
// Which rating the "shop for" stat states. CADR is the default because it is the
// number printed on the box — the one you can actually compare products by. ACH is
// there for the boxes that advertise air changes instead; it restates the user's
// own target, qualified by the room it has to hold, because there is no standard
// test room to convert a CADR into an ACH claim against.
const ratingToggle = [
  { label: 'CADR', value: 'cadr' },
  { label: 'ACH', value: 'ach' },
];
// The target quick-set scale. 1–8 ACH in half steps covers every target this
// tool can sensibly recommend: below 1 is not a goal at all (the field's own
// error says so), above 8 is past any published guidance. The field stays the
// single source of truth — the slider only writes into it, and recompute()
// drives the thumb back from whatever the field ends up holding, so a typed 3
// parks the thumb at 3 rather than the slider claiming a number of its own.
const TARGET_MIN = 1;
const TARGET_MAX = 8;
// The three numbers this tool actually cites (CARB's floor, what box ratings
// assume, the wildfire-smoke band's top), labelled on the track below the
// slider. `at` is the ACH value; the CSS turns it into a track percentage.
// These labels are decoration for sighted scanning ONLY (aria-hidden): the
// slider's own label and the target field's help text already carry all three
// numbers to a screen reader, and a second static copy would just be noise.
const targetLandmarks = [
  { at: 2, label: '2 · CARB min' },
  { at: 5, label: '5 · box ratings' },
  { at: 6, label: '6 · wildfire' },
];

// THREE VARIANTS, two independent decisions. Same markup, same steps, same calc
// engine below in every one — so no view can drift from the wizard's maths.
//
//   variant       intro slide?   isometric scene?   controls
//   'default'     no             yes                md
//   'mobile'      yes            no (not rendered)  lg
//   'responsive'  yes            yes, wide only     lg
//
// The two decisions are therefore separate booleans, NOT `isMobile`:
//   hasIntro  — does the flow open on the fork slide (and so own the page's h1,
//               and so hide the hasCleaner radio the slide already answered)?
//   showScene — is the isometric scene RENDERED at all? It is a large animated
//               SVG with a rAF loop and a ResizeObserver, so the mobile variant
//               omits it from the document rather than hiding it with CSS.
//
// 'responsive' is the combined view: one page that behaves like the wizard on a
// wide screen and like the mobile flow below the 68rem breakpoint. Because a
// server-rendered variant cannot know the viewport, it ships the scene and hides
// it with CSS at narrow widths; the script pauses the rAF loop to match (see
// `sceneLive`). Its controls are `lg` at EVERY width — the variant must serve
// phones, `lg` is the touch-correct 44px choice, and swapping sizes at runtime
// would mean churning Lit props on every breakpoint crossing. It reads slightly
// larger than the wizard view on desktop; that is intentional.
interface Props {
  variant?: 'default' | 'mobile' | 'responsive';
}
const { variant = 'default' } = Astro.props;
const isMobile = variant === 'mobile';
/** Opening fork slide: mobile + responsive. Drives the control size. */
const hasIntro = variant !== 'default';
/** Is the scene in the document at all? Rendered for default + responsive. */
const showScene = !isMobile;
/** Control size for every lego that takes one. */
const ctl = hasIntro ? 'lg' : 'md';
/* HEADINGS: THE PAGE OWNS THE h1; THIS COMPONENT STARTS AT h2.
   Every heading in here — the intro title, the step title, the verdict headline —
   is an h2, in every variant. The component is a section of a page, not a page,
   and it is embedded in three different hosts (the three prototype pages, plus
   the standalone vanilla build in public/aer-tool/); a section that claims the h1
   either fights its host for the level or forces every host to go without one.
   So the host supplies the h1 and these slot underneath it:
     - the default variant's page carries an esa-page-header, whose title is the h1
       (this was already the structure — the fork that used to promote these to h1
       on the intro variants is gone, so all three variants now match);
     - the mobile + responsive pages, which drop esa-page-header because the intro
       slide carries the visible title, add a visually-hidden h1 instead;
     - the vanilla build does the same, outside its embeddable region.
   Exactly one of the three is ever in the layout at once (data-phase swaps the
   intro against the steps; renderStep hides the step title on the result section,
   where the verdict headline is the heading), so the outline never doubles up.
   All three are styled by class, so the level is an outline decision only. */

// Isometric dot-lattice for the background "paper". A rectangular pattern tile
// of (2A × 2B) carries two lattice dots — (0,0) and (A,B) — which tiles into the
// full 30° iso dot grid these illustrations sit on. Fixed in screen space, so
// the paper stays put while the scene scales.
const DOT_SPACING = 26;
const A = +(Math.cos(Math.PI / 6) * DOT_SPACING).toFixed(3); // ≈ 22.5
const B = +(0.5 * DOT_SPACING).toFixed(3); // 13
---

<div class="smaqmd-aerb" data-aerb-wizard data-variant={variant}>
  {/* The scene is omitted entirely on the MOBILE variant — not hidden with CSS.
     It is a large animated SVG with a rAF loop and a ResizeObserver, and shipping
     it to a phone only to display:none it would cost the download and the work
     for something the user never sees. The script below detects its absence.
     The RESPONSIVE variant cannot make that call at build time (the same HTML
     serves both widths), so it ships the scene, hides it under 68rem with CSS
     everywhere but the result step, and pauses the loop from the script to
     match — see `sceneLive` / `syncSceneLive`. */}
  {showScene && (
  <!-- The room cutaway. bcn-lego-checked: no esa- lego draws a to-scale isometric
       room scene with animated flow (checked the catalog — esa-* has
       cards/stats/inputs but no 3D/flow viz; Beacon has no equivalent), and no
       esa- lego provides a full-viewport fixed illustration backdrop. This SVG
       projection is the reusable home for "see the air exchange", so it lives in
       its own smaqmd- block, driven from the shared calc script below. The
       __cityview class names predate the interior rethink and are deliberately
       kept: the hand-ported vanilla mirror in public/aer-tool/ shares them. -->
  <div class="smaqmd-aerb__stage smaqmd-cityview" data-cityview data-state="idle">
    <svg class="smaqmd-cityview__svg" viewBox="0 0 480 380" role="img"
         aria-label="Isometric cutaway of your room: the floor and two back walls with windows, a door, and furniture, and each air cleaner as a small unit on the floor with rings pulsing outward to show it cleaning the surrounding air. A dashed outline shows the largest room the cleaners could cover.">
      <defs>
        <pattern id="smaqmd-iso-dots" patternUnits="userSpaceOnUse" width={2 * A} height={2 * B}>
          <circle class="smaqmd-cityview__dot" cx="0" cy="0" r="1.1"></circle>
          <circle class="smaqmd-cityview__dot" cx={A} cy={B} r="1.1"></circle>
        </pattern>
        <!-- The room's floor quad, as a clip. The cleaners stand close to the
             walls, so a ring at full radius would otherwise spill off the floor
             slab and float over the walls and the dot paper. Every rings group
             clips to this, so a pulse reads as spreading across the FLOOR and
             stopping at its edges. JS rewrites the polygon to the current floor
             corners on every draw, so it tracks the eased room exactly. -->
        <clipPath id="smaqmd-floor-clip">
          <polygon data-floor-clip></polygon>
        </clipPath>
      </defs>
      <!-- Isometric dot paper — the lattice the whole drawing sits on. -->
      <rect class="smaqmd-cityview__paper" x="0" y="0" width="100%" height="100%" fill="url(#smaqmd-iso-dots)"></rect>

      <!-- Soft shadow pad the cutaway sits on — one step outside the room
           footprint, at the underside of the floor slab. -->
      <polygon class="smaqmd-cityview__ground" data-ground></polygon>

      <!-- CAPACITY GHOST, the BEHIND-THE-WALLS twin. The ghost scales uniformly,
           so its body (floor + two far faces) is either entirely inside the room
           or extends entirely beyond it. Beyond, its bottom borders lie on the
           far side of the back walls and must be OCCLUDED by them — so this twin
           group sits before the walls, and drawScene writes the body into it (and
           blanks the in-front twin at [data-capg]) whenever the ghost outgrows
           the room. Same classes; visibility toggled in lockstep with capG. -->
      <g class="smaqmd-cityview__capg" data-capg-back style="visibility:hidden">
        <polygon class="smaqmd-cityview__cap-face" data-cap="left"></polygon>
        <polygon class="smaqmd-cityview__cap-face" data-cap="right"></polygon>
        <polygon class="smaqmd-cityview__cap-face" data-cap="floor"></polygon>
      </g>

      <!-- THE TWO BACK WALLS, drawn first so everything inside the room paints
           over them. Each wall contributes three faces: the INTERIOR face you
           look at (x=0 is the left wall, y=0 the right one), the thin top cap you
           see because the wall has thickness, and the cut edge where the cutaway
           slices the wall off at the near corner. -->
      <polygon class="smaqmd-cityview__room-face" data-room="left"></polygon>
      <polygon class="smaqmd-cityview__room-face" data-room="right"></polygon>
      <polygon class="smaqmd-cityview__wall-top" data-wall-top="left"></polygon>
      <polygon class="smaqmd-cityview__wall-top" data-wall-top="right"></polygon>
      <polygon class="smaqmd-cityview__wall-cap" data-wall-cap="left"></polygon>
      <polygon class="smaqmd-cityview__wall-cap" data-wall-cap="right"></polygon>

      <!-- Openings in those walls — part of the same bcn-lego-checked cityview
           block (windows on both walls, whose count scales with wall length, and
           a door on the y=0 wall). Pre-rendered pools only; JS toggles
           style.visibility (NOT display — the one show/hide idiom the whole
           scene uses) and sets points every draw so the openings morph in
           lockstep with the eased room. -->
      <g class="smaqmd-cityview__details" data-room-details style="visibility:hidden">
        {WINDOW_SLOTS.map((i) => (
          <polygon class="smaqmd-cityview__win" data-win-l={i} style="visibility:hidden"></polygon>
        ))}
        {WINDOW_SLOTS.map((i) => (
          <polygon class="smaqmd-cityview__win" data-win-r={i} style="visibility:hidden"></polygon>
        ))}
        <polygon class="smaqmd-cityview__door" data-door style="visibility:hidden"></polygon>
      </g>

      <!-- The floor slab: the floor plane you look down into, plus the two front
           edges you see because the slab has depth. -->
      <polygon class="smaqmd-cityview__room-face" data-room="floor"></polygon>
      <polygon class="smaqmd-cityview__floor-edge" data-floor-edge="left"></polygon>
      <polygon class="smaqmd-cityview__floor-edge" data-floor-edge="right"></polygon>

      <!-- Rug — a flat quad lying on the floor (z=0). Carries __details so it
           fades with the rest of the room dressing when the ghost reads inside. -->
      <polygon class="smaqmd-cityview__details smaqmd-cityview__rug" data-rug style="visibility:hidden"></polygon>

      <!-- Capacity ghost — a dashed outline of the largest room the cleaners can
           cover at the target, drawn from the room's far corner so it can grow
           toward the viewer past the cutaway. Static (scope-stamped) group; JS
           sets its face points + label each draw and toggles visibility (NOT
           display — the scene's one show/hide idiom). The data-cap-compare swap
           on the container makes the bigger box the more transparent one. -->
      <g class="smaqmd-cityview__capg" data-capg style="visibility:hidden">
        <polygon class="smaqmd-cityview__cap-face" data-cap="left"></polygon>
        <polygon class="smaqmd-cityview__cap-face" data-cap="right"></polygon>
        <polygon class="smaqmd-cityview__cap-face" data-cap="floor"></polygon>
      </g>

      <!-- CLEANING PULSE — the one airflow cue in the scene. Each cleaner sends
           soft concentric rings rippling OUTWARD across the floor and fading, a
           calm "this unit is working on the air around it" radius rather than a
           literal in/out flow diagram. Three rings per unit, evenly spaced
           through one cycle so a new one leaves the unit as the outermost one
           fades; one cycle = one air change for THAT cleaner (cadence from its
           own ACH share). Both the polygon points and the fading stroke-opacity
           are written by JS every frame.
           PAINT ORDER: after the floor, rug and capacity ghost so the rings read
           as lying ON the floor, and BEFORE the furniture and the unit boxes so
           a bed or the cleaner itself occludes the part of a ring passing behind
           it — which is what sells them as flat on the ground rather than
           floating over the scene. Clipped to the floor quad (see the defs
           note). Groups i>1 start hidden. -->
      {CLEANER_IDS.map((i) => (
        <g class="smaqmd-cityview__rings" data-rings={i} clip-path="url(#smaqmd-floor-clip)"
           style={i > 1 ? 'visibility:hidden' : undefined}>
          <polygon class="smaqmd-cityview__ring" data-ring="1"></polygon>
          <polygon class="smaqmd-cityview__ring" data-ring="2"></polygon>
          <polygon class="smaqmd-cityview__ring" data-ring="3"></polygon>
        </g>
      ))}

      <!-- BACK air-cleaner units (ids 2 and 4) — the pair standing against the
           x=0 wall, at the far side of the room from the viewer. They paint
           BEFORE the furniture because everything on the floor stands nearer the
           viewer than they do, so furniture must be free to occlude them. (The
           back zone they occupy is reserved against furniture in layoutDetails,
           so in practice they are never buried — this order only settles which
           one wins where the two do meet on screen.) Groups i>1 start hidden. -->
      {BACK_UNIT_IDS.map((i) => (
        <g class="smaqmd-cityview__unitg" data-unitg={i} style={i > 1 ? 'visibility:hidden' : undefined}>
          <polygon class="smaqmd-cityview__unit-face" data-unit="left"></polygon>
          <polygon class="smaqmd-cityview__unit-face" data-unit="right"></polygon>
          <polygon class="smaqmd-cityview__unit-face" data-unit="top"></polygon>
        </g>
      ))}

      <!-- Furniture standing on the floor — the same bcn-lego-checked cityview
           block. The pool is ordered BACK-TO-FRONT (by fx+fy in FURN_DEFS), so
           document order IS painter order and no runtime depth sort is needed.
           Each item is the same 3-face mini-box as a cleaner unit, and each
           toggles with style.visibility (never display). The group carries
           __details so furniture fades with the windows/door/rug. -->
      <g class="smaqmd-cityview__details" data-furniture style="visibility:hidden">
        {FURN_IDS.map((i) => (
          <g class="smaqmd-cityview__furn" data-furn={i} style="visibility:hidden">
            <polygon class="smaqmd-cityview__furn-face" data-furn-face="top"></polygon>
            <polygon class="smaqmd-cityview__furn-face" data-furn-face="left"></polygon>
            <polygon class="smaqmd-cityview__furn-face" data-furn-face="right"></polygon>
          </g>
        ))}
      </g>

      <!-- FRONT air-cleaner units (ids 1 and 3) — the pair standing in the strip
           along the near x=L edge the cutaway opens on, LAST so they paint in
           front of the furniture and the rings: nothing in the room stands
           between them and the viewer. Together with the back block above this
           static split IS the depth sort for the units, and it is correct
           because layoutCleaners() fixes each index to a side. Group 3 starts
           hidden (1 is always drawn). -->
      {FRONT_UNIT_IDS.map((i) => (
        <g class="smaqmd-cityview__unitg" data-unitg={i} style={i > 1 ? 'visibility:hidden' : undefined}>
          <polygon class="smaqmd-cityview__unit-face" data-unit="left"></polygon>
          <polygon class="smaqmd-cityview__unit-face" data-unit="right"></polygon>
          <polygon class="smaqmd-cityview__unit-face" data-unit="top"></polygon>
        </g>
      ))}

      <!-- The ghost's UPPER outline and its caption live OUTSIDE [data-capg],
           after the rings, furniture and units. The group's floor face must tuck
           under the furniture and its far faces sit behind the room — but the
           top-face outline runs at ceiling height and the near-corner vertical
           stands at the box's closest point, both in FRONT of everything on the
           floor: drawn inside the early group they ducked under the bed. Fill-less
           top face + that one vertical complete all 12 edges of the box. JS
           toggles this group in lockstep with [data-capg]. -->
      <g data-capg-top style="visibility:hidden">
        <polygon class="smaqmd-cityview__cap-face" data-cap="top"></polygon>
        <line class="smaqmd-cityview__cap-edge" data-cap-edge></line>
        <text class="smaqmd-cityview__dim smaqmd-cityview__cap-label" data-label="capacity" text-anchor="start">—</text>
      </g>

      <text class="smaqmd-cityview__dim" data-label="length" data-grip="length" text-anchor="middle">—</text>
      <text class="smaqmd-cityview__dim" data-label="width" data-grip="width" text-anchor="middle">—</text>
      <text class="smaqmd-cityview__dim" data-label="height" data-grip="height" text-anchor="middle">—</text>

      <!-- Drag grips — part of the same bcn-lego-checked cityview block: each edge
           drags its dimension and types into the form fields (inputs stay the
           source of truth). No esa- lego offers draggable diagram handles; the
           write-back goes through the esa-text-field legos. -->
      <!-- Each hit line sits immediately before its own handle so the hover/active
           CSS can scope to a single grip with the adjacent-sibling combinator (+).
           Interleaving (not hit,hit,hit,handle,handle,handle) is what prevents one
           edge's hover from darkening every chevron. -->
      <g data-grips>
        <line class="smaqmd-cityview__hit" data-grip="length"></line>
        <g class="smaqmd-cityview__handle" data-grip="length"><path class="smaqmd-cityview__chev" d="M -7 -4.5 L -12 0 L -7 4.5 M 7 -4.5 L 12 0 L 7 4.5"></path></g>
        <line class="smaqmd-cityview__hit" data-grip="width"></line>
        <g class="smaqmd-cityview__handle" data-grip="width"><path class="smaqmd-cityview__chev" d="M -7 -4.5 L -12 0 L -7 4.5 M 7 -4.5 L 12 0 L 7 4.5"></path></g>
        <line class="smaqmd-cityview__hit" data-grip="height"></line>
        <g class="smaqmd-cityview__handle" data-grip="height"><path class="smaqmd-cityview__chev" d="M -7 -4.5 L -12 0 L -7 4.5 M 7 -4.5 L 12 0 L 7 4.5"></path></g>
      </g>
    </svg>
    <!-- Invisible safe-area sentinel: CSS declares (per breakpoint) where the
         cutaway may live, clear of the panel + header; JS observes this rect
         and feeds it to the fit math. -->
    <div class="smaqmd-cityview__safe" data-safe aria-hidden="true"></div>
    <!-- Pause/play for the ring pulse (SC 2.2.2 — auto-playing, indefinite
         motion needs an explicit stop). The script swaps label + glyph together
         (syncPulseToggle); the play icon starts hidden and the initial sync
         corrects it for reduced-motion users, who begin paused.
         bcn-lego-checked: esa-button is compile-time (.astro) so it cannot swap
         icon/label at runtime, and the icon registry ships no pause/play
         glyphs; checked Beacon (no media-toggle control); .smaqmd-cityview__pause
         is the reusable home, mirrored in public/aer-tool. -->
    <button
      type="button"
      class="smaqmd-cityview__pause"
      data-pulse-toggle
      aria-label="Pause the air-cleaning animation"
      title="Pause the air-cleaning animation"
    >
      <svg data-icon="pause" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="14" y="4" width="4" height="16" rx="1"></rect><rect x="6" y="4" width="4" height="16" rx="1"></rect></svg>
      <svg data-icon="play" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
    </button>
  </div>
  )}

  <!-- Full-bleed backdrop + floating overlay composition. bcn-lego-checked:
       layouts.css primitives are flow-only (no fixed full-viewport backdrop or
       floating overlay); esa-dialog/esa-side-dialog are wrong here — their modal
       scrim would hide the scene and their focus trap is wrong for an
       always-open form. Panel chrome stays esa-card via the --card-bg hook; only
       the positioning is bespoke, so it lives in these smaqmd-aerb__ blocks.
       The wizard variant stacks the header + panel into a single fixed LEFT
       column (smaqmd-aerw__col) so the flow is the prominent element and the
       scene sits to its right — the scene is secondary, and useless when the
       user has no cleaner to check, so it must not dominate the page. -->
  <div class="smaqmd-aerw__col">
  <div class="smaqmd-aerb__header">
    <slot name="header" />
  </div>

  <!-- Wizard: one fixed panel, one step at a time. bcn-lego-checked: no esa- lego
       is a multi-step wizard/stepper (checked the catalog — esa-tab-layout is
       user-driven tabs, not a gated linear flow; esa-progress-bar is a bare bar;
       Beacon has no equivalent). The step shell + numbered progress dots are the
       bespoke smaqmd-wizard concern; every CONTROL inside stays an esa-* lego, and
       the fields + [data-result] subtree are byte-for-byte the classic view's, so
       the SAME calc engine drives both — only the chrome differs. -->
  <div class="smaqmd-aerb__panel smaqmd-aerw__panel">
    <EsaCard>
      <div class="smaqmd-wizard stack" data-gap="lg" data-wizard data-phase={hasIntro ? 'intro' : 'steps'}>
        {/* OPENING SLIDE (mobile + responsive), deliberately outside the step machinery:
            it carries no step number and no dot, because it asks nothing.

            It is also where the flow FORKS. This tool serves two people — someone
            checking a cleaner they own, and someone with none who wants to know what
            to buy — and that question used to sit at the top of step 2 as a radio
            group. Asking it here instead means the wizard already knows which person
            it is talking to before step 1, so it can drop the cleaners step entirely
            for the shopper (see PLAN in the step machinery) rather than walking them
            into a step whose only content is the answer they already gave. The radio
            group stays in the DOM as the single source of truth the engine reads —
            the buttons set it — and is hidden on the variants that have this slide.

            Copy worked to NN/g's informative-microcopy model — Clarity > Concision
            > Character, both strings inside the house limits (title 35/60,
            summary 52/160).

            CLARITY. Two earlier titles failed here and both failed the same way, by
            naming one of the two people. "Is your air cleaner powerful enough for
            your room?" told the shopper the tool was not for them. "How much clean
            air does your room need?" fixed the exclusion but bought it with an
            abstraction — a quantity of clean air is not a thing anyone came here
            wanting. The title now names the OUTCOME both people are after, which is
            the one thing they have in common. Note what it does NOT say: "make your
            room's air cleaner" reads as "your room's AIR CLEANER" in a tool whose
            whole subject is air cleaners, so the phrasing is avoided.

            The summary names the tool, says what it computes, and attributes it —
            requested directly (2026-08-28). This is text ABOUT the page, which
            design-principles bans on tool surfaces, and the exception is deliberate
            and narrow: a public agency's tool carries its provenance, and the
            opening slide of a standalone mobile flow is the only surface here with
            no page header, no nav and no other place for it to live. It does not
            earn a second appearance anywhere in the steps.
            It replaced a preparation line ("Two or three questions. Have your room's
            size handy."), so the "how long is this / what do I need" questions now
            go unanswered until step 1. Worth restoring as a second line if the slide
            can afford it.

            CHARACTER stays near zero on purpose. This is a public-health tool for
            residents checking their air during smoke season; warmth here would read
            as levity. Plain and useful IS the agency's voice.

            BUTTONS: each names an INTENT in the user's words, not a step in ours,
            and both start with a verb. The checking path leads because it is the
            larger audience during smoke season; the shopping path is the outline
            appearance because it is the less common one, not the lesser one. */}
        {hasIntro && (
          <div class="smaqmd-wizard__intro" data-intro>
            <h2 class="typography-heading-lg smaqmd-wizard__intro-title" data-intro-title tabindex="-1">
              How to get cleaner air in your room
            </h2>
            <p class="typography-body-md smaqmd-wizard__intro-lede">
              Use the air exchange rate tool to estimate how many times an hour an
              air cleaner can replace your room's air. This can help you improve
              the air quality in your room.
            </p>
            <div class="smaqmd-wizard__intro-actions stack" data-gap="sm">
              <span data-nav="check">
                <EsaButton size={ctl} type="button">Check my air cleaner</EsaButton>
              </span>
              <span data-nav="shop">
                <EsaButton size={ctl} variant="ghost" appearance="outline" type="button">Help me pick an air cleaner</EsaButton>
              </span>
            </div>
          </div>
        )}
        <!-- Progress head: numbered dots (the 3 input steps) + counter + title. -->
        <div class="smaqmd-wizard__head stack" data-gap="sm">
          <div class="smaqmd-wizard__dots cluster" data-gap="xs" aria-hidden="true">
            <span class="smaqmd-wizard__dot" data-dot="0"><span class="smaqmd-wizard__dot-num">1</span></span>
            <span class="smaqmd-wizard__dot" data-dot="1"><span class="smaqmd-wizard__dot-num">2</span></span>
            <span class="smaqmd-wizard__dot" data-dot="2"><span class="smaqmd-wizard__dot-num">3</span></span>
          </div>
          <p class="visually-hidden smaqmd-wizard__count" data-step-count>Step 1 of 3</p>
          <h2 class="typography-heading-md smaqmd-wizard__title" data-step-title tabindex="-1">What size is your room?</h2>
          <!-- The band's bottom EDGE, as the district's swoop rather than a straight
               rule. Two crossing waves, matching the agency's letterhead mark: the
               front one is the band's own colour and IS the band's edge (the flat
               1px border is gone), the back one is a step lighter and surfaces from
               under it toward the left. Inline SVG and not a CSS mask so the fill
               stays a token read and the shape needs no vendor prefixes; hangs below
               the band in the stack's own gap, so it costs no layout. -->
          <svg class="smaqmd-wizard__swoop" viewBox="0 0 390 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="smaqmd-wizard__swoop-back" d="M0,0 H390 V2 C284,30 92,0 0,20 Z" />
            <path class="smaqmd-wizard__swoop-front" d="M0,0 H390 V4 C296,24 104,-6 0,14 Z" />
          </svg>
        </div>

        <!-- Step bodies — all present in the DOM (the engine reads every field on
             every recompute); only the active step is shown. -->
        <div class="smaqmd-wizard__body">
          <!-- Step 0 — room -->
          <section class="stack" data-gap="md" data-step="0">
            <esa-radio-group size={ctl}
              data-field="roomMethod"
              aria-label="Choose how to enter your room size"
              value="area"
              options={JSON.stringify(roomMethods)}
            ></esa-radio-group>
            <div class="smaqmd-aerb__dims grid" data-gap="md">
              <div data-room="dimensions" hidden>
                <esa-text-field size={ctl} data-field="length" type="text" inputmode="decimal" label="Length (ft)" value="12"></esa-text-field>
              </div>
              <div data-room="dimensions" hidden>
                <esa-text-field size={ctl} data-field="width" type="text" inputmode="decimal" label="Width (ft)" value="10"></esa-text-field>
              </div>
              <div data-room="area">
                <esa-text-field size={ctl} data-field="area" type="text" inputmode="decimal" label="Floor area (ft²)" value="120"></esa-text-field>
              </div>
              <div data-room="dimensions area">
                <esa-text-field size={ctl} data-field="height" type="text" inputmode="decimal" label="Ceiling height (ft)" value="8"></esa-text-field>
              </div>
              <div data-room="volume" hidden>
                <esa-text-field size={ctl} data-field="volume" type="text" inputmode="decimal" label="Room volume (ft³)"></esa-text-field>
              </div>
            </div>
            <!-- Soft cap. A room past these bounds is almost always a typo (1200
                 for 120), so this WARNS rather than blocks: the arithmetic is
                 valid at any size and refusing to compute a real warehouse would
                 be wrong. The drag grips clamp to the same numbers. -->
            <div data-room-warn hidden data-alert>
              <EsaAlertBox variant="warning" title="That is a very large room">
                This tool is built for rooms up to <strong>100 ft</strong> per side
                and <strong>30 ft</strong> high. The result still uses what you
                entered — check the value for a typo.
              </EsaAlertBox>
            </div>
            <div data-room-hint hidden data-alert>
              <EsaAlertBox variant="info">Enter your room size to continue.</EsaAlertBox>
            </div>
          </section>

          <!-- Step 1 — air cleaners. Opens with the intent fork: a shopper answers
               "No" and the entry UI stays hidden (result → what to buy); a checker
               answers "Yes" and the cleaner form unfolds in place. Replaces the old
               pre-stamped blank block, which read as "fill this in" to people who
               had nothing to enter. -->
          <section class="stack" data-gap="md" data-step="1" hidden>
            <!-- "Where to find an air cleaner's ratings" — FIRST in the step, so
                 the reader knows what to grab off the box before the fields ask
                 for it, and OUTSIDE [data-cleaner-entry] so it stays available to
                 the shopper who answered "No" as well. Closed by default: it is
                 help, not instruction. The SAME component is mounted again on the
                 result step. -->
            <SmaqmdAerFindRatings />
            <esa-radio-group size={ctl}
              data-field="hasCleaner"
              label="Do you have an air cleaner to check?"
              value="yes"
              options={JSON.stringify(cleanerChoice)}
            ></esa-radio-group>
            <!-- Cleaner entry — revealed only on "Yes". -->
            <div class="stack" data-gap="md" data-cleaner-entry>
              <!-- Cleaner blocks stamped here by JS (template below) -->
              <div class="stack" data-gap="lg" data-cleaners></div>
              <div class="cluster" data-gap="sm">
                <span data-add-cleaner>
                  <EsaButton size={ctl} variant="ghost" appearance="outline" icon="plus" type="button">
                    Add air cleaner
                  </EsaButton>
                </span>
                <p class="typography-meta" data-cap-note hidden>You've added the maximum of {MAX_CLEANERS} air cleaners.</p>
              </div>
            </div>
          </section>

          <!-- Step 2 — target -->
          <section class="stack" data-gap="md" data-step="2" hidden>
            <!-- Quick-set scale ABOVE the field it fills: the shortcut is the
                 offer, the field is the answer. size={ctl} like every other
                 control in the step — the old three-button preset row had to drop
                 a rung because its labels overran the column, which a slider
                 cannot do, and a thumb is a drag target that wants to be BIGGER
                 on touch, not smaller (SC 2.5.8: lg is 24px outright; md clears
                 the bar on the spacing exception, nothing else is within 24px).
                 show-value is off — the field below IS the readout, and two live
                 numbers a row apart would just disagree while you drag.
                 bcn-lego-checked: esa-range-slider IS the slider and is used
                 unmodified — but it has no marks/ticks prop, so the labelled
                 landmark row is composed AROUND it here rather than by editing
                 the hub lego; checked Beacon (no marked-slider component);
                 .smaqmd-aerb__target-scale is the reusable home for that. -->
            <div class="smaqmd-aerb__target-scale">
              <!-- KNOWN HUB GAP (esa-range-slider): the lego exposes no marks/
                   ticks API, and no hook onto its inner <input> — that input
                   lives in shadow DOM, so aria-valuetext cannot be set on it
                   from here. The screen-reader experience of THIS slider is
                   therefore the bare number ("3.5"), while the hand-ported twin
                   in public/aer-tool announces "3.5 air changes per hour" and
                   names the landmark when it lands on one. Not an oversight:
                   closing it means a marks + valuetext API on the hub lego
                   (/request-lego), not reaching into its shadow root. -->
              <esa-range-slider
                data-field="targetSlider"
                size={ctl}
                label="Target air changes per hour"
                min={TARGET_MIN}
                max={TARGET_MAX}
                step="0.5"
                value="2"
                show-value="false"
              ></esa-range-slider>
              <!-- Landmarks, staggered onto two rows. "5 · box ratings" and
                   "6 · wildfire" are only 1 ACH apart — 14% of the track, ~60px
                   even on a wide desktop column — so a single row would overlap
                   them at EVERY width, not just narrow ones. Alternating rows
                   (2 and 6 up, 5 down) leaves the two on each row 57% of the
                   track apart, which clears at 320px without a media query.
                   Each label is paired with a notch drawn at the SAME percent:
                   the notch is what makes the stagger read as designed rather
                   than accidental — it draws the eye from the track down to
                   whichever row the label sits on. -->
              <div class="typography-meta smaqmd-aerb__target-marks" aria-hidden="true" style={`--_thumb: ${hasIntro ? '24px' : '20px'}`}>
                {targetLandmarks.map((m, i) => {
                  const at = ((m.at - TARGET_MIN) / (TARGET_MAX - TARGET_MIN)) * 100;
                  const row = i % 2 === 1 ? '2' : '1';
                  return (
                    <Fragment>
                      <span class="smaqmd-aerb__target-tick" data-row={row} style={`--_at: ${at}`}></span>
                      <span
                        class="smaqmd-aerb__target-mark"
                        data-row={row}
                        style={`--_at: ${at}`}
                      >{m.label}</span>
                    </Fragment>
                  );
                })}
              </div>
            </div>
            <esa-text-field size={ctl}
              data-field="target"
              type="text"
              inputmode="decimal"
              label="Or type an exact target"
              value="2"
              help-text="One air change means the cleaner has filtered a full room's worth of air. CARB recommends at least 2 per hour; most air-cleaner box ratings assume about 5; during wildfire smoke aim for 4–6."
            ></esa-text-field>
            <!-- Shown by recompute() only when the entered target drops below the
                 CARB-recommended 2, so a low target is an explicit choice. -->
            <div data-target-warn hidden data-alert>
              <EsaAlertBox variant="warning" title="Below the recommended minimum">
                The California Air Resources Board recommends at least <strong>2</strong>
                air changes per hour. A lower target may not clear the air enough.
              </EsaAlertBox>
            </div>
            <!-- A target of 0 (or less) is not a real goal — no cleaning at all. The
                 result is blocked until it's a positive number. -->
            <div data-target-invalid hidden data-alert="assertive">
              <EsaAlertBox variant="danger" title="Enter a target above 0">
                A target of 0 means no air cleaning at all. Enter how many times per
                hour you want the room's air replaced — at least <strong>1</strong>,
                ideally <strong>2</strong> or more.
              </EsaAlertBox>
            </div>
          </section>

          <!-- Step 3 — result. The SAME [data-result] subtree the classic view
               uses; the engine writes here regardless of which step is shown. -->
          <section class="stack" data-gap="md" data-step="3" hidden>
        <div class="stack" data-gap="md" data-result>
          <!-- ANSWER, then ACTION over evidence. The headline carries the diagnosis;
               everything after it is the prescription. On a fail the action alert
               leads, the CADR-to-shop-for is the only hero, and the delivered ACH
               demotes to a supporting evidence line. Pass shows the ACH hero alone
               (there is no action); shop shows only the CADR. -->
          <div class="stack smaqmd-aerb__answer" data-gap="sm" data-group="answer" hidden>
            <!-- Hidden holder for the verdict headline. recompute() writes it here;
                 renderStep() mirrors it into the header band's h2, which is THE
                 visible (and screen-reader) title on the result step. -->
            <span data-answer-title hidden>—</span>

            <!-- VERDICT CARD — the verdict spelled out. On a fail it carries the
                 fix and leads the metrics; in shop mode it explains what CADR is
                 and follows them (below). JS shows exactly one via
                 [data-verdict-card] and fills the readouts. Pass shows none. -->
            <!-- Action-first: the instruction leads the body at heading-md — the
                 same rung as the band title, never above it — and the fail-state
                 stat value is capped to match (below). No alert chrome and no
                 "Below your target" title: the headline already delivered the
                 diagnosis, and a box would frame the action as an aside instead
                 of the point. -->
            <div data-verdict-card="fail" hidden>
              <div class="stack" data-gap="xs">
                <p class="typography-heading-md smaqmd-aerb__action">
                  Add <strong data-r="moreunits">—</strong> more
                  <span data-r="unitnoun">air cleaners</span> like yours
                </p>
                <p class="typography-body-md">
                  Or swap in stronger cleaners.
                </p>
              </div>
            </div>
            <div class="smaqmd-aerb__heroes">
              <!-- The ACH sub is a live verdict line ("Below/Meets your N air changes
                   per hour target") written by recompute(), not static copy. -->
              <div data-metric="ach" hidden>
                <EsaStat value="—" label="air changes per hour" sub="—" accent />
              </div>
              <!-- The "shop for" stat, with the rating toggle under it. The toggle
                   sits INSIDE the [data-metric="fix"] wrapper so the existing
                   show/hide covers both — a toggle for a stat that is not on
                   screen would be an orphan control. recompute() rewrites the
                   value, the label AND the sub for the chosen mode (renderFix), so
                   the authored strings here are only the CADR default. Same
                   pattern as the units toggle in the secondary block below. -->
              <div class="stack" data-gap="sm" data-metric="fix" hidden>
                <EsaStat value="—" label="combined CADR to shop for"
                  sub="added up across all the air cleaners in the room" accent />
                <!-- ACH mode's equivalence list. A listing's (room size × ACH) claim
                     is the cleaner's CADR in disguise — every pair a manufacturer
                     quotes for one unit multiplies to the same constant — so a lone
                     "N ACH" target is meaningless (and misleading) on its own.
                     Instead the requirement is printed at the ACH levels listings
                     actually quote (1, 2, 4, 5, plus the user's own target); the
                     shopper matches whichever pair their listing gives. Rows are
                     computed by renderFix() from needCadr, so the user's real
                     ceiling height is already priced in. Hidden in CADR mode. -->
                <div class="stack" data-gap="2xs" data-ach-equiv hidden>
                  <p class="typography-body-md smaqmd-aerb__equiv-lede">
                    A listing qualifies if it claims any ONE of these:
                  </p>
                  <ul class="typography-body-md smaqmd-aerb__equiv" data-ach-equiv-rows></ul>
                  <p class="typography-body-md smaqmd-aerb__equiv-note">
                    Listing quotes a different ACH? Compare it against the next lower row.
                  </p>
                </div>
                <esa-button-toggle
                  class="smaqmd-aerb__rating"
                  data-field="rating"
                  size={hasIntro ? 'sm' : 'xs'}
                  label="Show the rating as"
                  value="cadr"
                  options={JSON.stringify(ratingToggle)}
                ></esa-button-toggle>
              </div>
            </div>
            <!-- Shop mode: the number IS the action, so the CADR stat leads and this
                 explainer supports it from below — same order as the fail screen, and
                 no alert chrome for what is plain supporting copy. -->
            <div data-verdict-card="shop" hidden>
              <!-- The place the unit is spelled out IN WORDS. CFM leads everywhere
                   (it's what the box says) with ft³/min as the parenthetical
                   secondary on labels and values; this sentence is where a reader
                   who has never met either abbreviation learns them. It also names
                   WHICH of the three CADR numbers on a box to compare against —
                   a real box lists tobacco smoke / dust / pollen, not one "CADR". -->
              <p class="typography-body-md smaqmd-aerb__footnote">
                CADR (Clean Air Delivery Rate) is the airflow rating printed on the air
                cleaner's box, measured in CFM — cubic feet of air moved per minute
                (ft³/min). Boxes usually list three CADR numbers — tobacco smoke, dust,
                and pollen. Compare against the Tobacco Smoke number (usually the
                lowest): match or beat it to reach your target.
              </p>
            </div>
            <!-- Evidence, below the action: the delivered rate vs the target. Fail
                 only — on a pass the ACH hero above carries the same numbers. -->
            <p class="typography-body-md smaqmd-aerb__footnote" data-ach-evidence hidden>
              Your setup delivers <strong data-r="ach">—</strong> air changes per hour,
              against your target of <strong data-r="target">2</strong>.
            </p>
            <!-- Over-700 caution: most consumer air cleaners top out around 700
                 CFM, so a required CADR above that isn't reachable with a single
                 unit. Shown by recompute() whenever the CADR-to-buy exceeds 700 —
                 a limit on PHYSICAL AIRFLOW, so it stays worded in CFM even when
                 the stat above is showing the ACH framing. Same alert pattern as
                 the target warnings: data-alert makes show() announce it. -->
            <div data-cadr-high hidden data-alert>
              <EsaAlertBox variant="warning" title="More than one air cleaner needed">
                Most air cleaners top out around <strong>700 CFM</strong>, so a
                single unit can't reach this rating. Combine two or more — their
                CADR ratings add together.
              </EsaAlertBox>
            </div>
            <!-- SECONDARY — the evidence for the number, as one legend sentence: what
                 the cleaner(s) cover vs how big the room is (floor area, the relatable
                 unit). Nested INSIDE the answer block (sm gap) so it reads as part of
                 the same result. Only shown with a cleaner delivering flow, so the
                 comparison is always complete. -->
            <div class="smaqmd-aerb__context" data-group="secondary" hidden>
              <p class="typography-body-md"><span data-r="coversubj">Your cleaner covers</span> a room up to <strong data-r="coverarea">—</strong>, while your room is about <strong data-r="roomarea">—</strong>.</p>
              <esa-button-toggle
                class="smaqmd-aerb__units"
                data-field="units"
                size={hasIntro ? 'sm' : 'xs'}
                label="Units"
                value="ft2"
                options={JSON.stringify(unitToggle)}
              ></esa-button-toggle>
              <!-- Why the coverage above can disagree with the box: AHAM's printed
                   "suggested closed room size" is smoke CADR × 1.55, which at an 8 ft
                   ceiling works out to ≈ 4.8 air changes per hour — hence "about 5".
                   Our number is sized to the user's OWN target, so at 2 or 6 the two
                   legitimately differ. Static: it is true at every target. -->
              <p class="typography-body-md">Box says something different? Air cleaner packaging lists a room size based on about 5 air changes per hour, so it won't match the coverage shown here unless that's your target too.</p>
            </div>
          </div>

          <div data-prompt="empty" hidden>
            <EsaAlertBox variant="info">
              Complete each step — a room size and a target above 0 — to see your result.
            </EsaAlertBox>
          </div>

          <!-- Polite announcer: a visually-hidden live region written by recompute()
               after a 600 ms debounce so drag gestures do not chatter. -->
        </div>

        <!-- The SECOND mount of "Where to find an air cleaner's ratings" (the first
             leads the cleaners step). Shown on every result, not just the shop one: a
             fail sends you shopping too, and on a pass it is a closed disclosure
             that costs nothing. OUTSIDE [data-result] for the same reason the tips
             are — the engine-shared subtree stays byte-for-byte the classic view's.
             Ordered before the tips: finding the rating comes before using the
             cleaner you buy with it. -->
        <SmaqmdAerFindRatings />

        <!-- Usage tips — closed by default so the verdict above stays the point;
             OUTSIDE [data-result] so the engine-shared subtree stays byte-for-byte
             the classic view's. -->
        <EsaCollapsible title="Getting the most from your air cleaner">
          <ul class="typography-body-md smaqmd-aerb__tips">
            <li>Remove all plastic wrapping from the filter before installing it.</li>
            <li>Keep windows and doors closed while it runs.</li>
            <li>Use it in the room where you spend the most time, usually a bedroom.</li>
            <li>Leave at least a foot of clearance around the air intake and outlet.</li>
            <li>Keep it out of corners — sitting mid-wall, it can pull air from more of the room.</li>
            <li>If you use more than one cleaner, place them on directly opposite sides of the room.</li>
            <li>Replace the filter on the schedule in your unit's manual — a clogged filter cleans less air.</li>
          </ul>
        </EsaCollapsible>
          </section>
        </div>

        <!-- Nav — Back sits left (margin-auto), the forward action right. Which
             forward button shows depends on the step; the script toggles them. -->
        <div class="smaqmd-wizard__nav">
          <span data-nav="back" hidden>
            <EsaButton size={ctl} variant="ghost" appearance="outline" type="button">Back</EsaButton>
          </span>
          <span data-nav="next">
            <EsaButton size={ctl} type="button">Next</EsaButton>
          </span>
          <span data-nav="result" hidden>
            <EsaButton size={ctl} icon="check" type="button">See my result</EsaButton>
          </span>
          <span data-nav="restart" hidden>
            <EsaButton size={ctl} variant="ghost" appearance="outline" icon="rotate-ccw" type="button">Start over</EsaButton>
          </span>
        </div>
      </div>
    </EsaCard>
  </div>
  </div>

  <!-- Cleaner-block template — cloned per cleaner. data-cleaner is stamped with
       the block's id on clone so each block's fields read/write independently.
       bcn-lego-checked: no esa- lego provides a repeating list-item template with
       remove animation; checked Beacon (none); .smaqmd-aerb__cleaner is the
       reusable home for the cleaner block chrome. -->
  <template data-cleaner-template>
    <div class="smaqmd-aerb__cleaner stack" data-gap="md" data-cleaner-block>
      <div class="smaqmd-aerb__cleaner-head repel">
        <h3 class="typography-title smaqmd-aerb__cleaner-title">Air cleaner</h3>
        <span data-remove-cleaner hidden>
          {/* md, not lg-to-match-the-inputs: the hub's esa-icon size fix means lg
              now really renders a 24px glyph in a 58px button — a row adornment
              at heading scale. md is the 20px/44px the vanilla twin ports. */}
          <EsaIconButton variant="chrome" iconOnly icon="trash-2" label="Remove this air cleaner" size={hasIntro ? 'md' : 'sm'} />
        </span>
      </div>
      <esa-radio-group size={ctl}
        data-field="unit"
        data-cleaner
        label="What does the box or manual list?"
        value="airflow"
        options={JSON.stringify(unitOptions)}
      ></esa-radio-group>

      <div data-unit-mode="airflow">
        <esa-text-field size={ctl}
          data-field="airflow"
          data-cleaner
          type="text"
          inputmode="decimal"
          label="Air flow rate or CADR in CFM (ft³/min)"
          help-text="CADR means Clean Air Delivery Rate, in CFM — cubic feet of air per minute (ft³/min). Use the lowest of the three CADR numbers (usually Tobacco Smoke)."
        ></esa-text-field>
      </div>

      <div class="stack" data-gap="md" data-unit-mode="ach" hidden>
        <esa-text-field size={ctl}
          data-field="ach"
          data-cleaner
          type="text"
          inputmode="decimal"
          label="Air changes per hour (ACH)"
        ></esa-text-field>
        <p class="typography-body-md smaqmd-aerb__cleaner-note">
          In what size room was that measured?
        </p>
        <!-- The reference room is entered the same two ways the user's OWN room is
             (step 0): dimensions or floor area + height. Not a second pattern —
             the wrappers here are [data-ref] to the room step's [data-room], and
             syncVisibility toggles them with the same one-line rule, but PER BLOCK
             so two cleaners can be entered two different ways. aria-label rather
             than a visible label: the "In what size room…" prompt above already
             names the group, and a second heading over the radios would say it
             twice. -->
        <esa-radio-group size={ctl}
          data-field="refMethod"
          data-cleaner
          aria-label="Choose how to enter that room's size"
          value="area"
          options={JSON.stringify(refMethods)}
        ></esa-radio-group>
        <div class="smaqmd-aerb__ref grid" data-gap="md">
          <div data-ref="area">
            <esa-text-field size={ctl} data-field="refArea" data-cleaner type="text" inputmode="decimal" label="Floor area (ft²)"></esa-text-field>
          </div>
          <div data-ref="dimensions" hidden>
            <esa-text-field size={ctl} data-field="refLength" data-cleaner type="text" inputmode="decimal" label="Length (ft)"></esa-text-field>
          </div>
          <div data-ref="dimensions" hidden>
            <esa-text-field size={ctl} data-field="refWidth" data-cleaner type="text" inputmode="decimal" label="Width (ft)"></esa-text-field>
          </div>
          <div data-ref="dimensions area">
            <esa-text-field size={ctl} data-field="refHeight" data-cleaner type="text" inputmode="decimal" label="Height (ft)" placeholder="8"></esa-text-field>
          </div>
        </div>
      </div>
    </div>
  </template>
</div>

<style>
  .smaqmd-aerb [hidden] { display: none !important; }
  .smaqmd-aerb__dims { --grid-min: 6.5rem; }
  .smaqmd-aerb__ref { --grid-min: 6.5rem; }
  /* Prompt labelling the reference-room fields (ACH mode). A question the user
     must answer → a real label: body-md (16px, the reading baseline) + secondary
     + semibold, not a faint 12px caption. */
  .smaqmd-aerb__cleaner-note {
    color: var(--color-content-default-secondary);
    font-weight: var(--typography-font-weight-semibold);
  }
  /* smaqmd-aerb__target-scale — the esa-range-slider plus a row of labelled
     landmarks under its track. bcn-lego-checked: esa-range-slider IS the control
     and is used unmodified; it exposes no marks/ticks API, so the labels are
     composed AROUND it here instead of being added to the hub lego. Checked
     Beacon (no marked-slider component). Positioning only — no track, thumb or
     focus chrome is redrawn, all of that stays the lego's. */
  .smaqmd-aerb__target-scale {
    position: relative;
    /* Inline-size containment makes 1cqw mean "1% of this block's width", which
       is what lets each mark clamp itself against the container edge below. */
    container-type: inline-size;
  }
  .smaqmd-aerb__target-marks {
    position: relative;
    /* A notch band, then two staggered rows of one line each — reserved up front
       so the absolutely positioned marks can never overlap the target field
       beneath them. 0.7em (notch + clearance) + 1.6em + 1.6em = 3.9em. */
    block-size: 3.9em;
    margin-block-start: var(--spacing-100, 0.25rem);
    color: var(--color-content-default-secondary);
  }
  .smaqmd-aerb__target-mark {
    position: absolute;
    inset-block-start: 0.7em;
    inset-inline-start: 0;
    inline-size: max-content;
    white-space: nowrap;
    /* Centre the label on where the THUMB actually sits at this value, not on
       the naive track percentage: a native thumb's centre travels from thumb/2
       to width - thumb/2, so the raw percent drifts up to half a thumb (~9px at
       the 2 mark) from what the eye aligns to. --_thumb is the lego's thumb
       size for the mounted control size, set inline on the marks row. Then
       clamp: the 0 floor stops the box at the container's leading edge and the
       100cqw - 100% ceiling at the trailing one, so an outermost label is
       nudged inward rather than spilling out of the card. */
    translate: clamp(0px, calc(var(--_thumb) / 2 + var(--_at) * (100cqw - var(--_thumb)) / 100 - 50%), calc(100cqw - 100%));
  }
  .smaqmd-aerb__target-mark[data-row='2'] { inset-block-start: 2.3em; }
  /* The notch that ties a label to its place on the track. It starts at the top
     of this row — spacing-100 under the lego's box, i.e. clear of the thumb's
     swept band — and runs down to just above its own label: 0.5em for row 1,
     1.9em for row 2. That difference is the whole point of the tick: the long
     run down to the lower row reads as a deliberate connector, where a bare
     two-row stagger reads as a layout accident. Decoration only — the parent
     row is aria-hidden and the numbers are all in the field's help text. */
  .smaqmd-aerb__target-tick {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    /* Drawn as a BORDER rather than a 2px background: a background-color is
       overridden in forced-colors mode (the notch would vanish), while a border
       is re-coloured to CanvasText and survives — no media query needed. */
    inline-size: 0;
    block-size: 0.5em;
    border-inline-start: 2px solid var(--color-border-default);
    pointer-events: none;
    /* Same thumb-travel math as the label, WITHOUT the clamp: a label may be
       nudged inward to stay in the card, but the notch is the position —
       moving it would point at the wrong value. */
    translate: calc(var(--_thumb) / 2 + var(--_at) * (100cqw - var(--_thumb)) / 100 - 50%);
  }
  .smaqmd-aerb__target-tick[data-row='2'] { block-size: 1.9em; }

  .smaqmd-aerb__context {
    color: var(--color-content-default-secondary);
    display: flex; flex-direction: column;
    gap: var(--spacing-200, 0.5rem);
    align-items: flex-start;
  }

  /* Answer headline — the direct yes/no, tinted by verdict: green pass, orange
     fail (matching the scene), neutral while only shopping for a rating. */
  /* Step headings are programmatic focus targets (tabindex=-1) for step-change
     announcement, not tab stops — suppress the ring that would flash on them after
     navigating (keyboard users never Tab here; the SR just reads the heading).
     a11y-checked: [data-step-title] carries tabindex="-1" and is focused only by
     renderStep(); it is unreachable by Tab, so no visible ring is ever needed. */
  [data-step-title]:focus { outline: none; }
  /* Result verdict recolors the header band (renderStep sets data-verdict on the
     wizard root). Fail swaps the sage band for the warning tint — the same orange
     ramp the alert and the scene's fail state already use — so the band itself
     says "below target" before the numbers do. Pass keeps the band and lifts the
     title to the ramp's green. Contrast on the bands (24px semibold = large text,
     AA is 3:1): warning #582d1d on the orange tint 9.29:1; earth-11 green on
     earth-4 5.55:1 — both clear even the 4.5:1 normal-text bar. */
  .smaqmd-wizard { --_warn-band: color-mix(in srgb, var(--color-border-utility-warning) 40%, var(--color-background-utility-warning-subtle)); }
  /* Pass speaks the band's own green (earth-11, 5.55:1 on the earth-4 band) —
     "target met" reads as green, not the neutral brand blue. */
  .smaqmd-wizard[data-verdict="pass"] .smaqmd-wizard__title { color: var(--smaqmd-color-content-secondary-brand); }
  .smaqmd-wizard[data-verdict="fail"] .smaqmd-wizard__title { color: var(--color-content-utility-warning); }
  .smaqmd-wizard[data-verdict="fail"] > .smaqmd-wizard__head { background: var(--_warn-band); }
  .smaqmd-wizard[data-verdict="fail"] .smaqmd-wizard__swoop-front { fill: var(--_warn-band); }
  .smaqmd-wizard[data-verdict="fail"] .smaqmd-wizard__swoop-back { fill: var(--color-background-utility-warning-subtle); }

  /* bcn-lego-checked: no esa- lego provides a CSS visually-hidden / sr-only
     utility; checked Beacon (uses a global .sr-only utility class not
     available in this spoke); this 7-property clip-path pattern is the
     only home for a polite live-region that stays off-screen. */

  /* Cleaner-block chrome — ported from Option A's .smaqmd-aer__cleaner* rules,
     renamed to .smaqmd-aerb__cleaner*. Top border + padding separate blocks
     visually; :first-of-type resets so the first block has no top chrome.
     bcn-lego-checked: no esa- lego provides a repeating list-item divider
     pattern; checked Beacon (none); the cleaner block is a spoke-level concern. */
  .smaqmd-aerb__cleaner {
    padding-block-start: var(--spacing-300, 0.75rem);
    border-block-start: 1px solid var(--color-border-default);
  }
  .smaqmd-aerb__cleaner:first-of-type {
    padding-block-start: 0;
    border-block-start: 0;
  }
  .smaqmd-aerb__cleaner-head { align-items: center; }
  /* Group heading for each cleaner block: typography-title (the 400 rung, same as
     the classic variants) so it OUTRANKS the label-lg question legends inside the
     block — at body-md it sat below its own children and the hierarchy inverted.
     Still a rung under the step's heading-md title. h3 under the step's h2. */
  .smaqmd-aerb__cleaner-title {
    margin: 0;
    color: var(--color-content-default);
  }
  /* The two hero stats (the ACH problem + the CADR fix) sit at EQUAL weight, side
     by side, wrapping only when the panel is too narrow. */
  .smaqmd-aerb__heroes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-400, 1rem) var(--spacing-600, 2rem);
  }
  /* The CADR/ACH toggle under the "shop for" stat hugs its own width: it shares a
     .stack with the stat, and a stack stretches its children. (The lego's own
     segment track is already fit-content; this keeps its LABEL from spanning the
     panel too, and is what the vanilla mirror's fieldset actually needs.) */
  .smaqmd-aerb__rating { align-self: flex-start; }
  /* Unit appended to a hero number (e.g. "240 CFM", "2 ACH") — quieter + about half the
     size of the number so the value stays the focus. The span is injected at
     runtime (innerHTML), so it never gets Astro's scope attribute — match it via
     :global() anchored under the (scoped) root. */
  .smaqmd-aerb :global(.smaqmd-aerb__unit) {
    font-size: 0.5em;
    font-weight: var(--typography-font-weight-medium, 500);
    color: var(--color-content-default-secondary);
  }
  /* Caution note under the CADR hero (e.g. the >700 CFM warning). */
  /* Result text is ONE color — the subtle gray-11 (content-default-secondary,
     5.6:1 on the gray-1 ground). Only the band title, the hero number, and the
     "Add N more…" action line carry color; every supporting line (stat labels,
     subs, evidence, caution, coverage) sits at the same quiet rung. */
  [data-result] p.typography-body-md,
  .smaqmd-aerb :global(.esa-stat__label),
  .smaqmd-aerb :global(.esa-stat__sub) { color: var(--color-content-default-secondary, #646464); }
  /* Hero numbers: the pass-state ACH keeps the primary brand hue; the CADR
     number reads in gray-12 (content-default) — quiet ink, not a brand accent.
     --stat-accent-color is esa-stat's consumer hook. */
  .smaqmd-aerb [data-metric="ach"] { --stat-accent-color: var(--color-background-brand); }
  .smaqmd-aerb [data-metric="fix"] { --stat-accent-color: var(--color-content-default); }
  /* On a FAIL the action statement above is the hero, so the CADR stat steps down
     a rung (heading-md scale) to stay subordinate to it. Shop mode keeps the full
     display-sm value — there the number IS the action. */
  .smaqmd-aerb__answer[data-verdict="fail"] [data-metric="fix"] {
    --stat-value-size: var(--typography-heading-md-font-size, 1.5rem);
  }
  /* Usage-tips list inside the collapsible: default bullets, tightened to the
     body padding the lego already provides; same quiet gray as the other
     supporting result text. */
  .smaqmd-aerb__tips {
    margin: 0;
    padding-inline-start: var(--spacing-500, 1.5rem);
    color: var(--color-content-default-secondary, #646464);
  }
  .smaqmd-aerb__tips li + li { margin-block-start: var(--spacing-200, 0.5rem); }
  /* ACH-mode equivalence list under the "shop for" stat — same quiet secondary
     treatment as the tips list, tighter rows (it's a scannable lookup table,
     not prose). */
  .smaqmd-aerb__equiv {
    margin: 0;
    padding-inline-start: var(--spacing-500, 1.5rem);
    color: var(--color-content-default-secondary, #646464);
  }
  .smaqmd-aerb__equiv li + li { margin-block-start: var(--spacing-100, 0.25rem); }
  .smaqmd-aerb__equiv-lede,
  .smaqmd-aerb__equiv-note {
    margin: 0;
    color: var(--color-content-default-secondary, #646464);
  }
  /* Hairline between the CADR stat and the supporting line below it — same
     token-driven divider the cleaner blocks use (border + breathing room above
     the text). Shared by the fail evidence line and the shop explainer. */
  .smaqmd-aerb__footnote {
    border-block-start: 1px solid var(--color-border-default);
    padding-block-start: var(--spacing-300, 0.75rem);
  }

  .smaqmd-aerb {
    position: relative; min-block-size: 100dvh;
    /* Wide-screen frame: cap the composition width so the scene + column stay a
       consistent, centered band on ultrawide monitors instead of the graphic
       ballooning full-bleed. --aer-gutter is the margin from the viewport edge to
       the frame; below --aer-frame it collapses to the normal spacing-500, so
       narrower desktops (and mobile) are unchanged. Every fixed child anchors to
       this gutter rather than the raw viewport edge. */
    --aer-frame: 90rem;
    --aer-gutter: max(var(--spacing-500, 1.5rem), calc((100vw - var(--aer-frame)) / 2));
  }

  /* smaqmd-cityview — the isometric room cutaway. bcn-lego-checked: bespoke SVG
     volume + flow drawing, no esa-/Beacon equivalent (see markup note); the
     fixed-inset full-viewport stage + invisible safe-area sentinel are likewise
     bespoke (no layouts.css primitive or esa- lego provides a fixed illustration
     backdrop). Token-driven fills: value-layered neutrals for the shadow, the
     walls, the floor slab and the furniture, brand accent for the cleaner unit +
     its cleaning-pulse rings, --color-border-default for edges. (The __cityview
     class names predate the interior rethink and stay put — public/aer-tool/
     mirrors them verbatim.) */
  .smaqmd-cityview {
    position: fixed; inset-block: 0; inset-inline: var(--aer-gutter); z-index: 0; pointer-events: none;
    /* The one accent the animation carries: brand while the setup meets target,
       warning orange when it doesn't (the [data-state="fail"] re-point below). */
    --pulse-color: var(--color-background-brand, #159a86);
  }
  .smaqmd-cityview[data-state="fail"] { --pulse-color: var(--color-background-utility-warning, #d9822b); }
  .smaqmd-cityview__svg { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }

  /* Safe area the cutaway fits into — CSS is the single source of truth; JS only measures. */
  /* Wizard puts its column on the LEFT, so the cutaway lives to the RIGHT: the
     left inset clears the column (32rem) + gaps; the other insets are small. */
  .smaqmd-cityview__safe {
    position: absolute;
    inset: var(--spacing-500, 1.5rem) var(--spacing-600, 2rem) 4.5rem calc(32rem + 2 * var(--spacing-500, 1.5rem));
    visibility: hidden;
  }

  /* Dot paper sits under everything; the translucent shadow pad lets it show
     through faintly so the scene reads as drawn ON the iso lattice. */
  .smaqmd-cityview__dot { fill: var(--color-border-default, #cfcfcf); }
  .smaqmd-cityview__ground {
    fill: color-mix(in srgb, var(--color-background-elevation-sunken, #f0f0f0) 45%, transparent);
    stroke: var(--color-border-default-subtle, #e0e0e0);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  /* One ripple of the cleaning pulse. Shape (points) and fade (stroke-opacity,
     set inline as the ring travels out) are JS's; everything constant about it
     lives here. The polygon is a projected circle on the floor, so it needs no
     linecap — but round joins keep the 28-gon reading as a smooth ellipse. */
  .smaqmd-cityview__ring {
    fill: none;
    stroke: var(--pulse-color);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  /* The pulse sits idle until there's a valid result, then fades in with the
     verdict. Shown/hidden per GROUP rather than per ring, so one state flip on
     the container carries all three ripples of every cleaner. */
  .smaqmd-cityview__rings {
    opacity: 0;
    transition: opacity 220ms ease;
  }
  /* "shop" is the third live state: no cleaner has been entered yet, but the room
     and the target are both known, so the pulse previews the RECOMMENDED setup
     rather than a measured one. It joins pass/fail here (a preview with no ripple
     would just be a static ghost) but deliberately NOT in the [data-state="fail"]
     recolours below — a recommendation isn't a shortfall, so it keeps the brand
     --pulse-color the container already carries. */
  .smaqmd-cityview[data-state="pass"] .smaqmd-cityview__rings,
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__rings,
  .smaqmd-cityview[data-state="shop"] .smaqmd-cityview__rings { opacity: 1; }
  /* A cleaner with no (or zero) flow contributes no air changes, so it gets no
     pulse even while the rest of the scene is live — JS flags its group. */
  .smaqmd-cityview__rings[data-lane-idle] { opacity: 0 !important; }

  .smaqmd-cityview__room-face {
    stroke: var(--color-border-default, #d0d0d0);
    stroke-width: 1.5;
    stroke-linejoin: round;
    transition: fill 200ms ease;
  }
  /* The floor is the SUNKEN surface of the value ramp — you are looking down into
     it — while the two interior wall faces keep the lit/shaded neutral pair. */
  .smaqmd-cityview__room-face[data-room="floor"] { fill: color-mix(in srgb, var(--color-background-elevation-sunken, #f0f0f0) 72%, transparent); }
  .smaqmd-cityview__room-face[data-room="left"]  { fill: color-mix(in srgb, var(--smaqmd-gray-3, #f0f0f0) 78%, transparent); }
  .smaqmd-cityview__room-face[data-room="right"] { fill: color-mix(in srgb, var(--smaqmd-gray-4, #e8e8e8) 78%, transparent); }

  /* The diorama's cut surfaces: the walls' top caps read as the near-white top of
     a solid wall, their cut edges and the floor slab's front edges one step down —
     the thickness that makes the cutaway read as a physical model. */
  .smaqmd-cityview__wall-top,
  .smaqmd-cityview__wall-cap,
  .smaqmd-cityview__floor-edge {
    stroke: var(--color-border-default, #d0d0d0);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .smaqmd-cityview__wall-top   { fill: color-mix(in srgb, var(--color-background-elevation-raised, #fff) 92%, transparent); }
  .smaqmd-cityview__wall-cap   { fill: color-mix(in srgb, var(--smaqmd-gray-4, #e8e8e8) 90%, transparent); }
  .smaqmd-cityview__floor-edge { fill: color-mix(in srgb, var(--smaqmd-gray-5, #e0e0e0) 92%, transparent); }

  /* Capacity ghost — dashed brand-tinted outline of the largest coverable room,
     drawn over the real room to compare sizes. Near-transparent brand fills so
     whichever box is BEHIND still reads through. The data-cap-compare swap makes
     the LARGER box the more transparent one:
       bigger  → capacity box is larger: cap fills stay very faint (default),
                 the solid room reads inside it.
       smaller → the user's room is larger: room faces drop to more-transparent
                 fills and the cap fills strengthen so the ghost reads inside. */
  .smaqmd-cityview__cap-face {
    stroke: color-mix(in srgb, var(--color-background-brand, #159a86) 55%, transparent);
    stroke-dasharray: 5 4;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .smaqmd-cityview__cap-face[data-cap="floor"] { fill: color-mix(in srgb, var(--color-background-brand, #159a86) 8%, transparent); }
  .smaqmd-cityview__cap-face[data-cap="left"]  { fill: color-mix(in srgb, var(--color-background-brand, #159a86) 10%, transparent); }
  .smaqmd-cityview__cap-face[data-cap="right"] { fill: color-mix(in srgb, var(--color-background-brand, #159a86) 12%, transparent); }
  /* The top face only contributes its outline — a fill up there would wash the
     whole scene under a brand tint. The near-corner edge matches the face strokes. */
  .smaqmd-cityview__cap-face[data-cap="top"] { fill: none; }
  .smaqmd-cityview__cap-edge {
    stroke: color-mix(in srgb, var(--color-background-brand, #159a86) 55%, transparent);
    stroke-dasharray: 5 4;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* smaller: the user's room is the bigger box, so make IT the more transparent
     one. The ghost keeps its default (low-alpha) fills in both cases. */
  .smaqmd-cityview[data-cap-compare="smaller"] .smaqmd-cityview__room-face[data-room="floor"] { fill: color-mix(in srgb, var(--color-background-elevation-sunken, #f0f0f0) 36%, transparent); }
  .smaqmd-cityview[data-cap-compare="smaller"] .smaqmd-cityview__room-face[data-room="left"]  { fill: color-mix(in srgb, var(--smaqmd-gray-3, #f0f0f0) 38%, transparent); }
  .smaqmd-cityview[data-cap-compare="smaller"] .smaqmd-cityview__room-face[data-room="right"] { fill: color-mix(in srgb, var(--smaqmd-gray-4, #e8e8e8) 38%, transparent); }

  .smaqmd-cityview__cap-label { fill: var(--color-background-brand, #159a86); }

  /* Room dressing — quiet, token-driven fills and thin --color-border-default
     strokes so the windows, door, rug and furniture read as what fills the room
     without competing with the room itself or the flow. One row of windows per
     wall, seen from inside; the count scales with wall length, and furniture
     accumulates with floor area. bcn-lego-checked: these are faces of the same
     bespoke SVG cutaway documented above — no esa-/Beacon lego draws them, and
     they carry no interaction, so there is nothing to promote to a lego. No
     pointer-events rules: the dressing inherits pointer-events:none from the
     stage. */
  .smaqmd-cityview__details { transition: opacity 200ms ease; }
  .smaqmd-cityview__win {
    fill: color-mix(in srgb, var(--color-background-brand, #159a86) 11%, transparent);
    stroke: var(--color-border-default, #cecece); stroke-width: 1; stroke-linejoin: round;
  }
  .smaqmd-cityview__win[data-win-r] { fill: color-mix(in srgb, var(--color-background-brand, #159a86) 15%, transparent); }
  .smaqmd-cityview__door {
    fill: color-mix(in srgb, var(--smaqmd-gray-6, #d9d9d9) 85%, transparent);
    stroke: var(--color-border-default, #cecece); stroke-width: 1; stroke-linejoin: round;
  }
  /* The rug is the one brand-tinted floor mark — barely there, so it reads as a
     surface under the furniture rather than as data. */
  .smaqmd-cityview__rug {
    fill: color-mix(in srgb, var(--color-background-brand, #159a86) 7%, transparent);
    stroke: color-mix(in srgb, var(--color-background-brand, #159a86) 25%, transparent);
    stroke-width: 1; stroke-linejoin: round;
  }
  /* Furniture keeps the three-face value ramp the rooftop units used: lit top,
     shaded left, shaded-darker right — the same light direction as the room. */
  .smaqmd-cityview__furn-face { stroke: var(--color-border-default, #cecece); stroke-width: 1; stroke-linejoin: round; }
  .smaqmd-cityview__furn-face[data-furn-face="top"]   { fill: color-mix(in srgb, var(--color-background-elevation-raised, #fcfcfc) 96%, transparent); }
  .smaqmd-cityview__furn-face[data-furn-face="left"]  { fill: color-mix(in srgb, var(--smaqmd-gray-4, #e8e8e8) 92%, transparent); }
  .smaqmd-cityview__furn-face[data-furn-face="right"] { fill: color-mix(in srgb, var(--smaqmd-gray-5, #e0e0e0) 92%, transparent); }
  .smaqmd-cityview[data-cap-compare="smaller"] .smaqmd-cityview__details { opacity: 0.45; }

  .smaqmd-cityview__unit-face {
    stroke: var(--color-background-brand-hover, #0f7e6e);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .smaqmd-cityview__unit-face[data-unit="top"]   { fill: color-mix(in srgb, var(--color-background-brand, #159a86) 72%, #fff); }
  .smaqmd-cityview__unit-face[data-unit="left"]  { fill: var(--color-background-brand, #159a86); }
  .smaqmd-cityview__unit-face[data-unit="right"] { fill: var(--color-background-brand-hover, #0f7e6e); }

  /* Cohesive FAIL palette — when below target, the capacity "ghost" (the largest
     room the cleaners could actually cover) and the air-cleaner units shift
     from brand to the spoke's warning ORANGE, matching the orange pulse rings +
     ACH readout so the whole scene reads "not passing" as one. The MAIN room stays
     neutral — it's the fixed reference; the ghost is what comes up short. */
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__cap-face,
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__cap-edge { stroke: color-mix(in srgb, var(--color-background-utility-warning, #d9822b) 55%, transparent); }
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__cap-face[data-cap="floor"] { fill: color-mix(in srgb, var(--color-background-utility-warning, #d9822b) 8%, transparent); }
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__cap-face[data-cap="left"]  { fill: color-mix(in srgb, var(--color-background-utility-warning, #d9822b) 10%, transparent); }
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__cap-face[data-cap="right"] { fill: color-mix(in srgb, var(--color-background-utility-warning, #d9822b) 12%, transparent); }
  /* Text-safe warning token, NOT the background token the faces above use: the
     label is 13px text on the near-white paper, where the orange background
     step lands ~2.9:1 — under the 4.5:1 SC 1.4.3 floor. KEEP IN SYNC with
     public/aer-tool/styles.css. */
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__cap-label { fill: var(--color-content-utility-warning, #582d1d); }
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__unit-face { stroke: var(--color-orange-10, #c15d10); }
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__unit-face[data-unit="top"]   { fill: color-mix(in srgb, var(--color-background-utility-warning, #d9822b) 72%, #fff); }
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__unit-face[data-unit="left"]  { fill: var(--color-background-utility-warning, #d9822b); }
  .smaqmd-cityview[data-state="fail"] .smaqmd-cityview__unit-face[data-unit="right"] { fill: var(--color-orange-10, #c15d10); }

  .smaqmd-cityview__dim {
    fill: var(--color-content-default-secondary, #555);
    font-size: 13px;
    font-weight: var(--typography-font-weight-medium, 500);
    font-family: var(--typography-font-family-sans, system-ui, sans-serif);
  }

  /* Drag grips re-enable hit-testing inside the pointer-events:none stage: each
     edge drags its dimension and writes back into the esa-text-field legos. */
  .smaqmd-cityview__hit {
    stroke: transparent; stroke-width: 28; stroke-linecap: round;
    pointer-events: stroke; cursor: grab; touch-action: none;
  }
  .smaqmd-cityview__dim[data-grip] {
    pointer-events: all; cursor: grab; touch-action: none;
    user-select: none; -webkit-user-select: none;
  }
  .smaqmd-cityview__handle { pointer-events: all; cursor: grab; touch-action: none; }
  .smaqmd-cityview__chev {
    fill: none;
    stroke: var(--color-content-default-secondary, #555);
    stroke-width: 2;
    stroke-linecap: round; stroke-linejoin: round;
    /* Scale around the chevron's own centre (its path is symmetric about 0,0). */
    transform-box: fill-box; transform-origin: center;
    transition: stroke 120ms ease, transform 120ms ease;
  }
  /* Hover: `+` (adjacent sibling) scopes the highlight to the hovered edge's own
     handle — `~` would darken every following handle, i.e. all of them. */
  .smaqmd-cityview__handle:hover .smaqmd-cityview__chev,
  .smaqmd-cityview__hit:hover + .smaqmd-cityview__handle .smaqmd-cityview__chev {
    stroke: var(--color-text, #1a1a1a); stroke-width: 2.5;
  }
  /* Active: press-down feedback (like a button :active) while the grip is held.
     Pointer capture keeps :active on the pressed hit/handle through the drag. */
  .smaqmd-cityview__handle:active .smaqmd-cityview__chev,
  .smaqmd-cityview__hit:active + .smaqmd-cityview__handle .smaqmd-cityview__chev {
    stroke: var(--color-text, #1a1a1a); transform: scale(0.97);
  }
  .smaqmd-cityview[data-dragging] .smaqmd-cityview__hit,
  .smaqmd-cityview[data-dragging] .smaqmd-cityview__handle,
  .smaqmd-cityview[data-dragging] .smaqmd-cityview__dim[data-grip] { cursor: grabbing; }

  /* Grips only make sense while entering length × width — the other room-entry
     modes have no draggable edges, so hide the handles and neutralize the
     label-drag affordance. The pointerdown handler guards the same condition. */
  .smaqmd-cityview:not([data-entry-mode="dimensions"]) [data-grips] { display: none; }
  .smaqmd-cityview:not([data-entry-mode="dimensions"]) .smaqmd-cityview__dim[data-grip] {
    pointer-events: none; cursor: default;
  }

  /* The pulse's pause/play control, lower right of the stage. The stage opts
     out of pointer events (only the grips opt back in), so the button re-enables
     its own; raised surface + border so the glyph reads over the dotted paper.
     Mirrors .smaqmd-btn--chrome/--icon in the vanilla twin (public/aer-tool). */
  .smaqmd-cityview__pause {
    position: absolute;
    inset-block-end: var(--spacing-500, 1.5rem);
    inset-inline-end: var(--spacing-500, 1.5rem);
    pointer-events: auto;
    display: inline-flex; align-items: center; justify-content: center;
    inline-size: 2.75rem; block-size: 2.75rem; padding: 0;
    border: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
    border-radius: var(--radius-md, 0.25rem);
    background: var(--color-background-elevation-raised, #fcfcfc);
    box-shadow: var(--elevation-1, 0 1px 4px 0 rgba(0, 0, 0, 0.03));
    color: var(--color-content-default-secondary, #646464);
    cursor: pointer;
  }
  .smaqmd-cityview__pause:hover {
    background: var(--color-background-elevation-sunken, #f0f0f0);
    color: var(--color-content-default, #121212);
  }
  .smaqmd-cityview__pause:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, #0073b2);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  /* The wizard's fixed LEFT column: header on top, wizard card below it. Sized to
     be the prominent element on the page; the scene fits into what's left (right). */
  .smaqmd-aerw__col {
    position: fixed; z-index: 1;
    inset-block: var(--spacing-500);
    inset-inline-start: var(--aer-gutter);
    inline-size: 32rem;
    max-inline-size: calc(100vw - 2 * var(--spacing-500, 1.5rem));
    display: flex; flex-direction: column;
    gap: var(--spacing-400, 1rem);
    max-block-size: calc(100dvh - 2 * var(--spacing-500, 1.5rem));
  }

  /* Header + panel are now static children of the fixed column above. */
  .smaqmd-aerb__header { max-inline-size: none; }
  /* The page's h1 lives in the header slot (see the host page). Slotted content is
     the PAGE's light DOM, so it never gets this file's scope attribute — match it
     through :global(), anchored under the scoped header. The gap between logo and
     title belongs to the host's own wrapper (a .cluster on the page).

     The hairline is the co-branding lockup's separator: the district's mark is
     itself a wordmark, so without it the header reads as two titles jammed
     together. The line marks where institution ends and instrument begins —
     neutral gray, never brand. Its height is the h1's own line box, so it
     brackets the title, not the taller logo. */
  .smaqmd-aerb__header :global(.smaqmd-aerb__page-title) { margin: 0; }
  /* The divider draws only when the title actually FOLLOWS the mark (the `+`),
     so a header composed without the logo — the standalone build documents
     deleting the anchor — loses the hairline with it instead of keeping a
     border that separates nothing. */
  .smaqmd-aerb__header :global(.smaqmd-logo-link + .smaqmd-aerb__page-title) {
    border-inline-start: 1px solid var(--color-border-default);
    padding-inline-start: var(--spacing-400, 1rem);
  }
  /* Once the pair wraps into two rows the divider separates nothing — a bare
     left border on a second line reads as a mistake. 31rem is where the row
     (logo + gaps + title) stops fitting the narrow layout's full-width header. */
  @media (max-width: 31rem) {
    .smaqmd-aerb__header :global(.smaqmd-logo-link + .smaqmd-aerb__page-title) {
      border-inline-start: none;
      padding-inline-start: 0;
    }
  }

  .smaqmd-aerb__panel {
    /* Fills only the height it needs and scrolls when the step is tall; the
       min-block-size:0 lets this flex child shrink below its content so the
       inner scroll (not the page) takes the overflow. */
    flex: 0 1 auto; min-block-size: 0;
    overflow-y: auto; overscroll-behavior: contain;
    /* esa-card draws its outline as an OUTSET box-shadow ring (0 0 0 1px), which a
       zero-padding scroll container clips at the padding box — slicing the card
       borders on the sides (always) and top/bottom (first/last or when scrolled).
       This padding gives the ring room to render. box-sizing is border-box, so the
       panel's fixed width/position is unchanged; only the inner content shrinks. */
    padding: var(--spacing-100, 0.25rem);
    --card-bg: color-mix(in srgb, var(--color-background-elevation-raised) 96%, transparent);  /* lego hook, inherits into cards */
    --card-border-color: var(--color-border-default-strong);  /* visible hairline over the scene (default #cecece reads too faint) */
  }
  /* Width comes from the column now; the panel just fills it. */
  .smaqmd-aerw__panel { inline-size: auto; }

  /* Ghost/outline buttons in the wizard sit on the frosted panel (96% raised +
     backdrop blur), so the lego's transparent rest state picks up the brand-blue
     scene bleeding through the blur. Ground them on the same gray-1 the site
     uses; hover/active restate the lego's sunken wash, which these higher-
     specificity rules would otherwise override. */
  .smaqmd-wizard :global(.esa-button--variant-ghost .esa-button__native) {
    background: var(--color-background-elevation-raised, #fcfcfc);
  }
  .smaqmd-wizard :global(.esa-button--variant-ghost .esa-button__native:hover:not(:disabled)),
  .smaqmd-wizard :global(.esa-button--variant-ghost.esa-button--active .esa-button__native) {
    background: var(--color-background-elevation-sunken, #f0f0f0);
  }

  /* smaqmd-wizard — the step shell. bcn-lego-checked: no esa- lego is a gated linear
     wizard/stepper (see the markup note); the numbered dots + step chrome are the
     bespoke home, composing esa-button / esa-* controls inside. Token-driven. */
  .smaqmd-wizard__dots { --cluster-align: center; }
  .smaqmd-wizard__dot {
    display: inline-grid; place-items: center;
    inline-size: 1.5rem; block-size: 1.5rem;
    border-radius: 999px;
    font-size: 0.75rem; font-weight: var(--typography-font-weight-medium, 500);
    /* Inherited body line-height (1.6) makes the digit's line box taller than the
       glyph, so the number rides high in the circle; hug the glyph instead. */
    line-height: 1;
    color: var(--smaqmd-color-content-secondary-brand);
    /* Idle sits ON the band; only the CURRENT step lifts to a white chip. That
       is the whole active/idle distinction, so it has to be the loud one. */
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--smaqmd-color-border-secondary-brand);
    transition: background 160ms ease, color 160ms ease, box-shadow 160ms ease;
  }
  /* Completed steps: filled brand; current step: brand ring + brand text. */
  .smaqmd-wizard__dot[data-done] {
    background: var(--smaqmd-color-background-secondary-brand);
    color: var(--smaqmd-color-content-on-secondary-brand);   /* 4.96:1 */
    box-shadow: none;
  }
  .smaqmd-wizard__dot[data-active] {
    color: var(--smaqmd-color-content-secondary-brand);      /* 7.09:1 on white */
    background: var(--color-background-elevation-raised, #fcfcfc);
    box-shadow: inset 0 0 0 2px var(--smaqmd-color-background-secondary-brand);
    font-weight: var(--typography-font-weight-semibold, 600);
  }
  /* Step header — a tinted SECTION band in the district's Earth Green (the
     guide's second Primary, which otherwise appears nowhere in the tool).
     A TINT and not the solid fill on purpose: design-principles keeps containers
     neutral and header bands white, so the hue reads clearly while the card stays
     a white container and the saturated brand stays reserved for the primary
     action. Bleeds to the card edges by cancelling esa-card's own --spacing-500
     padding, and matches its --radius-md top corners. */
  .smaqmd-wizard__head {
    margin-block-start: calc(var(--spacing-500, 1.5rem) * -1);
    margin-inline: calc(var(--spacing-500, 1.5rem) * -1);
    padding: var(--spacing-400, 1rem) var(--spacing-500, 1.5rem);
    background: var(--smaqmd-color-background-secondary-brand-muted);
    border-start-start-radius: var(--radius-md, 0.5rem);
    border-start-end-radius: var(--radius-md, 0.5rem);
    /* Anchors the swoop that forms the band's bottom edge. */
    position: relative;
  }
  /* Hangs BELOW the band, spanning the bled width, inside the wizard stack's own
     lg gap — so it never pushes the step content down or changes the card height.
     preserveAspectRatio="none" lets the 390-unit path stretch to any card width;
     the shape is decorative, so distorting it is the point. */
  .smaqmd-wizard__swoop {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    inline-size: 100%;
    block-size: 1.375rem;
    display: block;
  }
  .smaqmd-wizard__swoop-front { fill: var(--smaqmd-color-background-secondary-brand-muted); }
  .smaqmd-wizard__swoop-back  { fill: var(--smaqmd-color-background-secondary-brand-wash); }
  .smaqmd-wizard__count { color: var(--smaqmd-color-content-secondary-brand); }      /* 5.55:1 on the band */
  .smaqmd-wizard__title { color: var(--smaqmd-color-content-on-secondary-brand-muted); } /* 9.58:1 on the band */

  /* Stable frame — a genuinely FIXED height (not a min: a floor still lets tall
     states grow). Every step/result renders at this size, so the card never
     resizes and the nav never jumps. The body flex-grows to absorb slack on short
     steps (content top, nav pinned bottom) and scrolls internally when a state
     overflows (e.g. several cleaners). Clamped to the viewport so short screens
     shrink the frame rather than overflow it. */
  .smaqmd-wizard { block-size: min(40rem, calc(100dvh - 14rem)); }
  .smaqmd-wizard__body {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow: hidden auto;   /* clip the horizontal step-slide, scroll vertical overflow */
    /* A scroll container clips the 1px OUTSET ring that nested cards (the alert /
       info boxes) draw as their border. Bleed the clip box out by a hair with
       padding + equal negative margin: gives the ring room without shifting the
       content or misaligning it with the head/nav. The card's spacing-500 padding
       absorbs the negative margin. */
    padding: var(--spacing-100);
    margin: calc(-1 * var(--spacing-100));
  }
  /* Nav: forward action on the right, Back pushed to the left when present.
     justify-content handles the first step (no Back → no auto margin), where the
     lone forward button would otherwise sit left; the auto margin still governs
     once Back appears. */
  .smaqmd-wizard__nav {
    display: flex; align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-300, 0.75rem);
    margin-block-start: var(--spacing-200, 0.5rem);
  }
  .smaqmd-wizard__nav [data-nav="back"] { margin-inline-end: auto; }

  /* Step-change motion: the incoming step slides in from the direction of travel
     — from the right when moving forward (Next), from the left when moving back —
     so the animation reads as advancing/retreating through the flow, not just a
     generic content fade. Runs on the ecology house ease-in-out curve
     (--easing-in-out, easeInOutCubic — the token's documented use is "on-screen
     elements moving to a new position"). An animation (not a transition) is used
     because steps swap via the hidden attribute (display:none), which can't be
     transitioned; goStep() sets the direction class and re-triggers it. The card's
     own overflow:hidden clips the off-screen start so no scrollbar flashes. */
  .smaqmd-wizard__body [data-step].smaqmd-wizard__step--enter-fwd,
  .smaqmd-wizard__body [data-step].smaqmd-wizard__step--enter-back {
    animation: var(--duration-base, 200ms)
      var(--easing-in-out, cubic-bezier(0.645, 0.045, 0.355, 1)) both;
  }
  .smaqmd-wizard__body [data-step].smaqmd-wizard__step--enter-fwd  { animation-name: smaqmd-wizard-step-in-fwd; }
  .smaqmd-wizard__body [data-step].smaqmd-wizard__step--enter-back { animation-name: smaqmd-wizard-step-in-back; }
  @keyframes smaqmd-wizard-step-in-fwd {
    from { opacity: 0; transform: translateX(1.5rem); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes smaqmd-wizard-step-in-back {
    from { opacity: 0; transform: translateX(-1.5rem); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .smaqmd-wizard__body [data-step].smaqmd-wizard__step--enter-fwd,
    .smaqmd-wizard__body [data-step].smaqmd-wizard__step--enter-back { animation: none; }
    /* The usage-tips collapsible's caret rotation — esa-collapsible ships the
       transition ungated (hub gap); this spoke gates it so the shipped tool
       honors the preference either way. */
    .smaqmd-aerb :global(.esa-collapsible__summary)::after { transition: none; }
  }
  /* The panel is a .stack (flex column) with a max height: without this, short
     viewports shrink the cards (esa-card's overflow:hidden zeroes their flex
     minimum) and clip fields instead of letting the panel scroll. */
  .smaqmd-aerb__panel > :global(*) { flex-shrink: 0; }
  .smaqmd-aerb__panel :global(.esa-card) {
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  /* Result card — its own fixed pane pinned to the LEFT of the inputs panel, so
     the verdict is always on screen while the inputs scroll independently. Right
     edge sits one gap left of the inputs panel; same glass chrome as the panel. */
  .smaqmd-aerb__result {
    position: fixed; z-index: 1;
    inset-block-start: var(--spacing-500);
    inset-inline-end: calc(24rem + 2 * var(--spacing-500, 1.5rem));
    inline-size: 20rem;
    max-block-size: calc(100dvh - 2 * var(--spacing-500, 1.5rem));
    overflow-y: auto; overscroll-behavior: contain;
    padding: var(--spacing-100, 0.25rem);  /* room for esa-card's outset box-shadow ring — see .smaqmd-aerb__panel */
    --card-bg: color-mix(in srgb, var(--color-background-elevation-raised) 96%, transparent);  /* lego hook */
    --card-border-color: var(--color-border-default-strong);
  }
  .smaqmd-aerb__result :global(.esa-card) {
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .smaqmd-aerb__panel,
    .smaqmd-aerb__result { --card-bg: color-mix(in srgb, var(--color-background-elevation-raised) 96%, transparent); }
  }

  @media (max-width: 68rem) {
    .smaqmd-aerb { position: relative; min-block-size: 0; }
    /* Mobile flow: the script moves the page header ABOVE the graphic; header,
       then a 30dvh graphic band, then the card (at least ~70dvh) — the page scrolls. */
    .smaqmd-aerb__header {
      padding: var(--spacing-400, 1rem) var(--spacing-400, 1rem) 0;
      max-inline-size: none;
    }
    .smaqmd-cityview {
      display: block; position: relative; inset: auto; z-index: auto;
      block-size: 30dvh;
    }
    .smaqmd-cityview__safe { inset: var(--spacing-300, 0.75rem) var(--spacing-400, 1rem); }
    .smaqmd-cityview__pause {
      inset-block-end: var(--spacing-300, 0.75rem);
      inset-inline-end: var(--spacing-400, 1rem);
    }
    .smaqmd-aerw__col {
      position: relative; inset: auto;
      inline-size: auto; max-inline-size: none; max-block-size: none;
      min-block-size: 70dvh;
      gap: var(--spacing-400, 1rem);
      padding: var(--spacing-400, 1rem);
    }
    .smaqmd-aerb__panel { max-block-size: none; overflow: visible; }

    /* ----- RESPONSIVE VARIANT, narrow ----- */
    /* Below this breakpoint the responsive variant becomes the mobile flow. The
       rules above already collapsed the fixed-overlay composition (column,
       header, panel overflow) for every variant; what is left is the handful of
       MOBILE VARIANT decisions that are keyed to [data-variant='mobile'] and so
       do not reach here. They are DUPLICATED rather than shared because the
       mobile variant must apply them at EVERY width (it has no scene to lose)
       while responsive must apply them only here — and a JS-set layout attribute
       would flash the wrong layout before the deferred script runs.
       KEEP IN SYNC with the "===== MOBILE VARIANT =====" block below: each rule
       here mirrors one there, and the reasoning for each lives there. */

    /* Mirror: with the scene gone the card flows. display:none rather than
       absent, because the same HTML has to serve the wide layout too. The rAF
       loop is paused to match — the script's `sceneLive`, gated on this same
       68rem query. */
    .smaqmd-aerb[data-variant='responsive'] .smaqmd-cityview { display: none; }
    /* …except on the RESULT step, where the drawing IS part of the answer: the
       capacity ghost against the room is the picture of the verdict the numbers
       state. renderStep stamps data-section on the root (toIntro clears it) and
       sceneLive follows the same condition, so the rAF loop runs only while the
       band is on screen. The un-scoped narrow rules above (relative, 30dvh band,
       tightened safe area, caption hidden) already define how it presents here —
       this only lifts the hide. */
    .smaqmd-aerb[data-variant='responsive'][data-section='3'] .smaqmd-cityview { display: block; }
    /* Mirror: one frame height for every slide, as a MIN so tall steps can grow. */
    .smaqmd-aerb[data-variant='responsive'] .smaqmd-wizard {
      block-size: auto;
      min-block-size: 32rem;   /* = 512px */
    }
    .smaqmd-aerb[data-variant='responsive'] .smaqmd-wizard__body { overflow: visible; }
    /* Mirror: 44px radio rows (touch-target stopgap for esassoc/ecology#37). */
    .smaqmd-aerb[data-variant='responsive'] esa-radio-group {
      --typography-body-lg-line-height: 2.75rem;   /* -> 44px rows */
    }
    /* Mirror: the step nav sticks to the foot of the flowed card. */
    .smaqmd-aerb[data-variant='responsive'] .smaqmd-wizard__nav {
      position: sticky; inset-block-end: 0;
      background: var(--color-background-elevation-raised, #fcfcfc);
      padding-block: var(--spacing-300, 0.75rem);
    }
  }

  /* ===== MOBILE VARIANT =====
     With the scene gone there is no backdrop to float over, so the whole
     fixed-overlay composition collapses into ordinary document flow: one column,
     natural height, the page itself scrolls. The desktop wizard keeps its fixed
     frame (a card that never resizes as steps change); on a phone that same
     fixed frame would strand the Next button below the fold on tall steps, so
     the step card is allowed to grow and the page takes the overflow instead. */
  .smaqmd-aerb[data-variant='mobile'] {
    min-block-size: 0;
    --aer-gutter: var(--spacing-400, 1rem);
  }
  .smaqmd-aerb[data-variant='mobile'] .smaqmd-aerw__col {
    position: static; inset: auto; z-index: auto;
    inline-size: auto; max-inline-size: none; max-block-size: none;
    padding: var(--spacing-400, 1rem);
    gap: var(--spacing-400, 1rem);
  }
  /* ONE FRAME HEIGHT FOR EVERY SLIDE. The card sized to its content here, so the
     opening slide (~180px) and the target step (~394px) came in at under half the
     height of the cleaners step (~744px) and the card jumped on every Next.
     The floor is the ROOM step (~473px at every width measured, 320-600), not the
     cleaners step: pinning to the tallest state made a 744px card, which on a
     390x844 phone is most of the viewport and left the opening slide as a field of
     empty wash. This holds four of the five slides — intro, room, target, result —
     at one height, and lets the one genuinely tall step grow.
     A MIN and not the desktop's fixed block-size: this variant deliberately flows
     (the page scrolls, the card does not), so the cleaners step, a second cleaner,
     a wrapped label or a validation alert still has to be able to GROW the card.
     Fixing the height would put those states back behind an inner scrollbar. */
  .smaqmd-aerb[data-variant='mobile'] .smaqmd-wizard {
    block-size: auto;
    min-block-size: 30rem;   /* = 480px */
  }
  .smaqmd-aerb[data-variant='mobile'] .smaqmd-wizard__body { overflow: visible; }
  .smaqmd-aerb[data-variant='mobile'] .smaqmd-aerb__panel {
    max-block-size: none; overflow: visible;
  }
  /* The opening slide and the step machinery are mutually exclusive; the wizard
     root carries the phase so one attribute swaps the whole card. */
  .smaqmd-wizard__intro { display: none; }
  .smaqmd-wizard[data-phase='intro'] > .smaqmd-wizard__head,
  .smaqmd-wizard[data-phase='intro'] > .smaqmd-wizard__body,
  .smaqmd-wizard[data-phase='intro'] > .smaqmd-wizard__nav { display: none; }
  /* The opening slide is the one surface here that is allowed colour. It is a
     landing surface, not product UI, and design-principles splits exactly there:
     "product UI is austere; ... landing/showcase surfaces invite expressiveness".
     So the card fills with the brand wash (Dawn step 3) rather than staying the
     neutral white the step views keep. Blue, not the green used by the step
     header, so the two read as different moments: brand opens, green marks the
     steps. Cancels esa-card's --spacing-500 padding on all four sides to fill the
     card, then restores it as its own padding. */
  .smaqmd-wizard[data-phase='intro'] > .smaqmd-wizard__intro {
    display: flex;
    /* Grows into the shared min height above, so the wash fills the whole card
       instead of leaving white below a short slide. */
    flex: 1 1 auto;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-400, 1rem);
    margin: calc(var(--spacing-500, 1.5rem) * -1);
    padding: var(--spacing-500, 1.5rem);
    background: var(--smaqmd-color-background-intro-wash);
    border-radius: var(--radius-md, 0.5rem);
  }
  .smaqmd-wizard__intro-title {
    color: var(--smaqmd-color-content-intro-title);   /* 10.71:1 on the wash */
    margin: 0;
  }
  /* The two intent buttons sit at the foot of the slide — the same place the step
     nav occupies on every screen after it, so the forward action never moves. */
  .smaqmd-wizard__intro-actions { margin-block-start: auto; align-items: flex-start; }

  /* The fork is asked on the opening slide now, so the radio group that used to ask
     it at the top of the cleaners step would be a second copy of a question already
     answered. Hidden, not removed: it stays the single source of truth the engine
     reads (raw('hasCleaner')), and the intro buttons write to it. Only on the two
     variants that HAVE the opening slide (mobile + responsive) — the default
     wizard has no slide, so there it is still the real control. Responsive hides
     it at EVERY width, not just narrow ones: the slide it duplicates is likewise
     shown at every width, so the question is already answered on a desktop too. */
  .smaqmd-aerb:is([data-variant='mobile'], [data-variant='responsive']) [data-field='hasCleaner'] { display: none; }
  .smaqmd-wizard__intro-lede {
    margin: 0;
    color: var(--color-content-default-secondary);   /* 5.10:1 on the wash */
    /* A reading measure, not a phone constraint. This was 34ch, which is NARROWER
       than the ~300px card on a 390px phone, so it was forcing an extra wrap on
       the one screen this view exists for. 60ch is the normal measure and simply
       never binds at phone width — it only stops the line running full-bleed if
       the mobile view is opened on a desktop-width window. */
    max-inline-size: 60ch;
  }

  /* TOUCH TARGETS — stopgap, remove when esassoc/ecology#37 ships.
     esa-radio-group's option row is the <label> that carries the click handler,
     and at size=lg it measures 300x26px: past SC 2.5.8's 24px floor, well under
     the ~44px thumb convention. The lego exposes no ::part and no --radio-* hook,
     and --_radio-size is private, so the only legitimate lever is a PUBLIC token
     that inherits through the shadow boundary. The label is a typography
     composite, so its line box — and therefore the row height — follows this:
     Known limit: a label that WRAPS gets this leading on every line. The three
     groups here are single-line down to 320px (verified), which is why it is
     acceptable as a stopgap and not as the fix. */
  .smaqmd-aerb[data-variant='mobile'] esa-radio-group {
    --typography-body-lg-line-height: 2.75rem;   /* -> 44px rows */
  }

  /* The step nav is the primary action on a phone — keep it reachable without a
     scroll on every step by letting it sit at the end of the flowed card. */
  .smaqmd-aerb[data-variant='mobile'] .smaqmd-wizard__nav {
    position: sticky; inset-block-end: 0;
    background: var(--color-background-elevation-raised, #fcfcfc);
    padding-block: var(--spacing-300, 0.75rem);
  }

</style>

<script>
  import { announce as kitAnnounce, initAnnouncer } from '@esa/ecology/announcer';
  // Pre-mount the kit's two regions: a region that mounts and mutates in the same
  // tick does not announce, and recompute() can raise a validation alert on init.
  initAnnouncer();
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-radio-group';
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-range-slider';

  const root = document.querySelector<HTMLElement>('[data-aerb-wizard]');
  if (root) {
    // THE narrow-screen breakpoint, in JS. One MediaQueryList shared by both
    // consumers below (header placement, and the responsive variant's scene
    // pause) so they can never disagree about which side of 68rem we are on.
    // Must stay identical to the `@media (max-width: 68rem)` query in the style
    // block above — the CSS hides the scene, this decides whether it animates.
    const mqMobile = window.matchMedia('(max-width: 68rem)');

    // ---- responsive header placement ----
    // Desktop keeps the page header atop the card column; mobile moves it ABOVE
    // the graphic (its DOM node is relocated, not duplicated, so its listeners
    // ride along). Runs now (before paint) and on every breakpoint crossing.
    {
      const headerEl = root.querySelector<HTMLElement>('.smaqmd-aerb__header');
      const colEl = root.querySelector<HTMLElement>('.smaqmd-aerw__col');
      const placeHeader = () => {
        if (!headerEl) return;
        if (mqMobile.matches) {
          if (root.firstElementChild !== headerEl) root.prepend(headerEl);
        } else if (colEl && colEl.firstElementChild !== headerEl) {
          colEl.prepend(headerEl);
        }
      };
      placeHeader();
      mqMobile.addEventListener('change', placeHeader);
    }

    // ---- input plumbing (shared with the city drawing) ----
    // Namespaced field lookup: a bare name matches the shared (no data-cleaner)
    // field; passing a cleaner id matches that cleaner's per-block field. Grips
    // and room math use the shared fields; cleaner math passes the block id.
    const qa = (sel: string) => Array.from(root.querySelectorAll<HTMLElement>(sel));
    const field = (name: string, id?: string | number) => {
      const sel = id != null
        ? `[data-field="${name}"][data-cleaner="${id}"]`
        : `[data-field="${name}"]:not([data-cleaner])`;
      return root.querySelector<HTMLElement & { value?: string }>(sel);
    };
    const raw = (name: string, id?: string | number): string => {
      const el = field(name, id);
      return (el && el.value != null ? String(el.value) : '').trim();
    };
    const num = (name: string, id?: string | number): number => {
      const v = parseFloat(raw(name, id));
      return Number.isFinite(v) ? v : NaN;
    };
    const pos = (name: string, id?: string | number): number => {
      const v = num(name, id);
      return Number.isFinite(v) && v > 0 ? v : NaN;
    };
    const fmt = (v: number, digits = 0) =>
      v.toLocaleString('en-US', { maximumFractionDigits: digits, minimumFractionDigits: 0 });

    type Pt = [number, number];

    // ---- isometric projection ----
    // Project a 3D world point (x=length axis, y=width axis, z=up, all in ft) to
    // 2D. Classic 2:1 isometric: x runs right, y runs left, z runs up.
    const COS30 = Math.cos(Math.PI / 6);
    const SIN30 = 0.5;
    const project = (x: number, y: number, z: number): Pt => [
      (x - y) * COS30,
      (x + y) * SIN30 - z,
    ];

    // THE SCENE IS OPTIONAL (the mobile variant omits it). Rather than thread a
    // guard through the ~30 places the engine touches these three nodes, they
    // fall back to DETACHED stand-ins: every querySelector against the stand-in
    // returns null (each of those call sites already null-checks) and every
    // dataset write lands off-document. The four places that would actually DO
    // work — the fit/observe, the ring lookups, drawScene and the rAF loop — are
    // gated on hasScene below, so nothing animates when there is nothing to draw.
    const sceneSvg = root.querySelector<SVGElement>('.smaqmd-cityview__svg');
    const sceneStage = root.querySelector<HTMLElement>('[data-cityview]');
    const svg = sceneSvg ?? (document.createElementNS('http://www.w3.org/2000/svg', 'svg') as SVGElement);
    const container = sceneStage ?? document.createElement('div');
    // px-per-projected-ft from the last fit; frozen at pointerdown for a drag so
    // the gesture's px→ft mapping stays stable while the scene re-fits.
    let fitScale = 1;
    let viewW = 480, viewH = 380;
    let safe = { x: 52, y: 52, w: 376, h: 276 };   // SSR fallback matching the old frame
    const MAX_SCALE = 12;  // px per projected ft — stops a small room ballooning on huge monitors; tune visually
    // …and the mirror of MAX_SCALE at the other end: the DRAWN room stops growing
    // here. Past this the picture says nothing new — a big rectangle is a big
    // rectangle — while everything in it shrinks toward invisible. Measured
    // against the real fit math on a wide desktop / laptop safe area: the cleaner
    // unit falls under the UNIT_MIN_PX floor at roughly 50 ft (the readability
    // pass can no longer widen it, being capped appliance-sized), and the 0.35 ft
    // wall thickness reads under 1px by 100 ft. So the drawn box clamps and the
    // dimension LABELS keep the true feet — the same split the capacity ghost
    // already makes between its 3×-clamped drawing and its true capMaxVol.
    // Each axis clamps INDEPENDENTLY: scaling the footprint proportionally could
    // drive the short side under the 3 ft degenerate floor and blank the room.
    // The bound sits above ROOM_MAX-realistic rooms, so for anything anyone
    // actually measures the drawn box IS the entered box and no split exists.
    const SCENE_MAX = 60;    // ft — longest drawn floor side
    const SCENE_MAX_H = 20;  // ft — tallest drawn ceiling
    // trueDim / drawnDim per axis, so a clamped room's labels still read what the
    // user typed. All 1 whenever nothing is clamped, which is the normal case.
    const labelK = { L: 1, W: 1, H: 1 };
    // Air-cleaner sizing bounds. The cleaners now stand INSIDE the room as
    // appliance-sized boxes, so the world bounds are appliance-sized too: the
    // footprint scales with the room only UP TO CW_MAX, past which the units stop
    // growing so a big room's cleaners don't read as furniture-sized blocks.
    // Independently, UNIT_MIN_PX is a readability FLOOR on screen — a huge room
    // fits by zooming the whole scene out, which can shrink the (now world-capped)
    // cleaner below legibility, so the fit runs a second pass that widens the
    // cleaner in world units to clear it.
    const CW_MAX = 2.6;      // ft — cleaners stop growing with the room here
    const CW_MIN = 1.4;      // ft — world floor
    const UNIT_MIN_PX = 22;  // px — readability floor for the cleaner footprint on screen
    // The floor strip along the near x=L wall belongs to the FRONT cleaners:
    // furniture is clamped out of it, so a unit never lands inside a bed or a
    // desk. Its counterpart at the far end of the room — the BACK units' zone —
    // is not a constant, because those units move with the layout; it is the
    // rectangle backZone() derives and layoutDetails() reserves.
    const CLEANER_STRIP = 3.8;  // ft
    // The cutaway is a diorama with real thickness: the two back walls are WALL_T
    // thick (which is why you see a top cap and a cut edge on each), and the floor
    // is a slab FLOOR_D deep (which is why you see its two front edges).
    const WALL_T = 0.35;     // ft — wall thickness
    const FLOOR_D = 0.35;    // ft — floor slab depth
    const sceneSentinel = root.querySelector<HTMLElement>('[data-safe]');
    const sentinel = sceneSentinel ?? document.createElement('div');
    const hasScene = !!(sceneSvg && sceneStage && sceneSentinel);
    // The pulse's pause/play control, queried HERE rather than in the toggle
    // section below: it floats over the stage's lower-right corner, which is
    // exactly where the capacity caption lands, so syncViewport must be able to
    // measure it. The toggle wiring further down reuses this reference.
    const pulseToggle = root.querySelector<HTMLButtonElement>('[data-pulse-toggle]');
    // …its rect in STAGE coordinates, refreshed by syncViewport. Same contract as
    // `safe`: CSS owns where the button sits (and at which breakpoint), JS only
    // measures. null = not rendered, so no keep-out.
    let pauseBox: { x: number; y: number; w: number; h: number } | null = null;
    // Half of the ghost's dashed outline paints OUTSIDE the corner points the fit
    // is handed, so computeFit gives that half back on every side. Read off the
    // rendered stroke rather than typed, so the CSS stays the single source.
    const capStrokeEl = svg.querySelector<SVGElement>('[data-cap="top"]');
    const capStroke = capStrokeEl ? parseFloat(getComputedStyle(capStrokeEl).strokeWidth) || 0 : 0;
    // hasScene answers "is the scene in the document"; sceneLive answers "is it
    // WORTH DRAWING right now". They differ for exactly one case: the responsive
    // variant ships the scene at every width but CSS-hides it under 68rem — except
    // on the result step, where the narrow layout shows it as a band above the
    // card. While it is hidden the container measures 0x0, so an unguarded loop
    // would ease a pulse nobody sees and syncViewport would fit to a zero-sized
    // box, poisoning `safe` for when the scene comes back. Every other variant has
    // sceneLive === hasScene forever: 'mobile' never renders the scene, 'default'
    // never hides it.
    // This initial value must match syncSceneLive()'s condition below (data-section
    // is unset before the first renderStep, i.e. not the result step).
    const isResponsive = root.dataset.variant === 'responsive';
    let sceneLive = hasScene && !(isResponsive && mqMobile.matches);
    const syncViewport = () => {
      if (!sceneLive) return;
      viewW = container.clientWidth; viewH = container.clientHeight;
      svg.setAttribute('viewBox', `0 0 ${viewW} ${viewH}`);
      const s = sentinel.getBoundingClientRect();
      const c = container.getBoundingClientRect();
      safe = { x: s.left - c.left, y: s.top - c.top, w: s.width, h: s.height };
      // The button's box, in the same stage coordinates — measured on re-layout
      // only (never per frame): its position is CSS, and CSS only moves it when
      // the breakpoint does, which is a resize. A zero rect means it is not being
      // rendered, which is no keep-out at all.
      const p = pulseToggle?.getBoundingClientRect();
      pauseBox = p && p.width
        ? { x: p.left - c.left, y: p.top - c.top, w: p.width, h: p.height }
        : null;
      drawScene(cur.L, cur.W, cur.H);
    };
    if (hasScene) new ResizeObserver(syncViewport).observe(sentinel);
    // Everything the ring pulse needs, in SCREEN space, refreshed by drawScene.
    // A ring is a world-space circle of radius r on the floor around the unit's
    // center; the projection is linear, so its image is exactly the ellipse
    //
    //   P(θ) = C + r·(cosθ · E + sinθ · F)
    //
    // where C is the projected unit center and E/F are the projections of the
    // unit-foot world vectors +1x and +1y from it. Caching those three screen
    // vectors per cleaner is what keeps the animation tick to plain arithmetic:
    // it never re-projects, and it stays correct through a room morph or a
    // re-fit because drawScene rewrites them on the same frame it moves the room.
    // null = that cleaner isn't drawn right now.
    type RingDef = {
      cx: number; cy: number;     // projected unit center on the floor
      ex: number; ey: number;     // screen image of +1 ft along world x
      fx: number; fy: number;     // screen image of +1 ft along world y
      r0: number; rMax: number;   // world-ft radii the pulse travels between
    };
    const ringDefs: (RingDef | null)[] = [];
    // Ripples in flight per cleaner, evenly spread through the cycle, and the
    // angular resolution of each. 28 segments reads as a smooth ellipse at every
    // size this scene draws while keeping a frame's work to 3 × 28 points/cleaner.
    const RING_COUNT = 3;
    const RING_STEPS = 28;
    // How many cleaners the scene is currently drawing (mirrors the panel list,
    // capped at MAX_CLEANERS); set in recompute(), read by drawScene + the pulse.
    let sceneN = 1;
    const MAX_CLEANERS = 4;
    // The 4 × 3 ring polygons are static markup, so they're looked up ONCE here
    // rather than re-queried every frame. ringPolys[i][k] is cleaner i's ring k.
    const ringPolys: SVGElement[][] = [];
    for (let i = 0; hasScene && i < MAX_CLEANERS; i++) {
      ringPolys[i] = Array.from(
        svg.querySelectorAll<SVGElement>(`.smaqmd-cityview__rings[data-rings="${i + 1}"] .smaqmd-cityview__ring`),
      );
    }

    const ptsAttr = (pts: Pt[]) => pts.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' ');
    const setPoly = (sel: string, pts: Pt[]) => {
      const el = svg.querySelector(sel);
      if (el) el.setAttribute('points', ptsAttr(pts));
    };
    const setLabel = (name: string, at: Pt, text: string) => {
      const el = svg.querySelector(`[data-label="${name}"]`);
      if (!el) return;
      el.setAttribute('x', at[0].toFixed(1));
      el.setAttribute('y', at[1].toFixed(1));
      el.textContent = text;
    };
    const mid = (p: Pt, q: Pt): Pt => [(p[0] + q[0]) / 2, (p[1] + q[1]) / 2];

    // Room-dressing helpers: the two wrapper-group lookups + a per-poly toggle
    // that mirrors the ghost/rings pattern — style.visibility (never display), and
    // set points only when shown.
    const detailsG = svg.querySelector<SVGGElement>('[data-room-details]');
    const furnG = svg.querySelector<SVGGElement>('[data-furniture]');
    const setDetail = (sel: string, on: boolean, pts?: Pt[]) => {
      const el = svg.querySelector<SVGElement>(sel);
      if (!el) return;
      el.style.visibility = on ? '' : 'hidden';
      if (on && pts) el.setAttribute('points', ptsAttr(pts));
    };

    // N air cleaners standing ON THE FLOOR, filling the room from BOTH ends so
    // added units read as covering the room rather than crowding one wall. The
    // side assignment is FIXED by index (and mirrored by FRONT/BACK_UNIT_IDS in
    // the markup, which is what makes the units' static paint order correct):
    //
    //   1 → front (the strip along the open x=L edge)   2 → back (the x=0 wall)
    //   3 → front, beside 1                             4 → back, across from 3
    //
    // A side carrying ONE unit centers it at W/2; a side carrying TWO straddles
    // W/2 with a gap g between them, and both sides use the SAME two y-centers,
    // so every back unit stands directly across the room from its front partner
    // (1↔2, 3↔4). Within a pair the LOWER-y slot goes to the lower index (1 and
    // 2), the higher-y slot to 3 and 4. Each unit's cleaning pulse is derived from
    // its footprint alone (center + half-width), so the box below is all the ring
    // animation needs from this layout.
    type Cleaner = {
      x0: number; y0: number; x1: number; y1: number; h: number;
      side: 'front' | 'back';
    };
    const layoutCleaners = (L: number, W: number, n: number, cwOpt?: number): Cleaner[] => {
      // Base footprint: scales with the room (floor CW_MIN) but stops growing at
      // CW_MAX so big rooms don't get absurd cleaners. cwOpt (the readability
      // pass) overrides that base. The 3.2 ft cap keeps even a widened unit
      // appliance-sized, and W·0.55 keeps a lone centered unit off both side
      // walls. The absolute 0.2 ft floor only ever bites in a room already too
      // small to draw (< 3 ft), and exists so a box can never invert.
      const cwBase = Math.min(Math.max(Math.min(L, W) * 0.16, CW_MIN), CW_MAX);
      let cw = Math.min(cwOpt ?? cwBase, W * 0.55, 3.2);
      // Anti-overlap ceilings, applied once a side actually carries a pair
      // (n ≥ 3) or the two sides face each other (n ≥ 2). Both can legitimately
      // defeat the readability floor in a small room, which we accept.
      //   ACROSS the width: 2·cw + g ≤ 0.7·W with g = max(1, 0.5·cw). f(cw) is
      //   monotone, so the largest admissible cw is 0.28·W where that lands at
      //   or above the g = 0.5·cw branch point (cw ≥ 2, i.e. W ≥ 7.14 ft), and
      //   0.35·W − 0.5 below it. The pair then spans at most 70% of the width.
      //   ALONG the length: the front and back boxes must keep a 0.6 ft aisle
      //   between them → cw ≤ (L − 2.4)/2, from x0_front − x1_back ≥ 0.6.
      if (n >= 3) cw = Math.min(cw, W * 0.28 >= 2 ? W * 0.28 : W * 0.35 - 0.5);
      if (n >= 2) cw = Math.min(cw, (L - 2.4) / 2);
      cw = Math.max(cw, 0.2);
      const ch = cw * 1.5;   // a floor-standing unit is taller than it is wide
      // Gap between the two units of a pair, and the resulting slot offset from
      // the room's mid-width: each unit's CENTER sits at W/2 ∓ (cw/2 + g/2), so
      // the two boxes leave exactly g of floor between them.
      const g = Math.max(1, cw * 0.5);
      const slot = cw / 2 + g / 2;
      // Does a side carry two units? Front pairs up at n ≥ 3, back at n = 4.
      const frontPair = n >= 3, backPair = n >= 4;
      const out: Cleaner[] = [];
      for (let k = 0; k < n; k++) {
        const side: 'front' | 'back' = k % 2 === 0 ? 'front' : 'back';
        const paired = side === 'front' ? frontPair : backPair;
        // Index 0/1 take the lower-y slot of their side, 2/3 the higher one.
        const cyc = !paired ? W / 2 : W / 2 + (k < 2 ? -slot : slot);
        // Front: 1.2 ft of clearance from the x=L edge the cutaway opens on.
        // Back:  0.6 ft off the x=0 wall (a wall gap, not a walking aisle).
        const x0 = side === 'front' ? L - 1.2 - cw : 0.6;
        out.push({ x0, y0: cyc - cw / 2, x1: x0 + cw, y1: cyc + cw / 2, h: ch, side });
      }
      return out;
    };
    // The floor rectangle the BACK units occupy (plus a walking margin), or null
    // when no unit stands against the x=0 wall. layoutDetails keeps furniture out
    // of it — see the reservation rule there.
    const backZone = (cls: Cleaner[]) => {
      const back = cls.filter((c) => c.side === 'back');
      if (!back.length) return null;
      const M = 0.6;  // ft of clearance around the units
      return {
        x0: 0,
        x1: Math.max(...back.map((c) => c.x1)) + M,
        y0: Math.min(...back.map((c) => c.y0)) - M,
        y1: Math.max(...back.map((c) => c.y1)) + M,
      };
    };
    type BackZone = ReturnType<typeof backZone>;

    // Room dressing — the openings in the two walls, the rug, and the furniture
    // standing on the floor. All positions are pure, deterministic functions of
    // the eased dims — no randomness — so the dressing morphs in lockstep with the
    // room and the drag grips.
    const WIN_POOL = 2;                                 // per-wall slots; matches WINDOW_SLOTS in the frontmatter
    const WIN_W = 3.0;                                  // ft — fixed; count scales, size doesn't
    // Furniture pool, ordered BACK-TO-FRONT by (fx + fy) so document order IS
    // painter order and no runtime depth sort is needed. fx/fy place the item's
    // CENTER as a fraction of L/W; sx/sy/h are its world size in feet. minArea is
    // the floor area (ft²) at which the piece appears — growth is purely
    // area-driven, and because the 0.22 lerp is monotone each threshold fires
    // exactly once per morph, so furniture arrives one piece at a time and never
    // flickers. `snap` pins a piece flush against a wall: 'x' against x=0 (the
    // left wall), 'y' against y=0 (the right one).
    // A BED IS A WALL PIECE: its head goes against the y=0 wall, never adrift in
    // the middle of the floor. It cannot take the x=0 wall instead — that wall
    // now hosts back cleaner units 2 and 4 at mid-width, and a 5 ft-deep bed
    // would land in their reserved zone. So the y=0 wall carries three pieces
    // (dresser, bed, desk) that have to share its length; they are spaced
    // low-x → center → door-end here, and packed for real in the wall pass below.
    type FurnDef = { fx: number; fy: number; sx: number; sy: number; h: number; minArea: number; snap?: 'x' | 'y' };
    const FURN_DEFS: FurnDef[] = [
      { fx: 0.12, fy: 0.06, sx: 3.6, sy: 1.5, h: 2.7, minArea: 90,  snap: 'y' }, // 1 dresser
      { fx: 0.05, fy: 0.28, sx: 1.1, sy: 3.2, h: 5.6, minArea: 0,   snap: 'x' }, // 2 bookshelf
      { fx: 0.42, fy: 0.06, sx: 6.4, sy: 5.0, h: 1.7, minArea: 0,   snap: 'y' }, // 3 bed (head to the wall)
      { fx: 0.72, fy: 0.06, sx: 3.2, sy: 1.6, h: 2.5, minArea: 260, snap: 'y' }, // 4 desk
      { fx: 0.05, fy: 0.74, sx: 1.4, sy: 1.4, h: 2.1, minArea: 140, snap: 'x' }, // 5 nightstand
      { fx: 0.10, fy: 0.90, sx: 1.1, sy: 1.1, h: 3.0, minArea: 220 },            // 6 plant
      { fx: 0.70, fy: 0.86, sx: 1.9, sy: 1.9, h: 2.4, minArea: 320 },            // 7 armchair
    ];
    // Placement priority on the y=0 wall (FURN_DEFS indices: bed, dresser, desk).
    // NOT paint order — the table above stays sorted back-to-front, which along
    // this wall means by x, so document order is still painter order.
    const WALL_ORDER = [2, 0, 3];
    // The rug is the one flat piece — a quad on the floor at the foot of the bed,
    // no height. It follows the bed toward the y=0 wall.
    const RUG = { fx: 0.46, fy: 0.40, sx: 8.0, sy: 6.5, minArea: 150 };
    const clamp = (v: number, lo: number, hi: number) => Math.max(Math.min(v, hi), lo);
    // Evenly distributed window centers across a span: n windows sit at the
    // midpoints of n equal slots, so fixed-width windows never overlap.
    const winCenters = (span0: number, span1: number, n: number): number[] => {
      const S = span1 - span0;
      if (n < 1 || S < WIN_W) return [];
      return Array.from({ length: n }, (_, i) => span0 + (S * (i + 0.5)) / n);
    };
    type FurnBox = { x0: number; y0: number; x1: number; y1: number; h: number };
    const layoutDetails = (L: number, W: number, H: number, zone: BackZone) => {
      const degenerate = L < 3 || W < 3 || H < 3.5;
      // ONE row of windows per wall, seen from inside: sill at ~0.38H, opening
      // ~0.42H tall, both clamped so the head never runs into the ceiling.
      const sill = Math.min(3.2, H * 0.38);
      const winH = Math.min(Math.min(3.4, H * 0.42), Math.max(0.4, 0.85 * H - sill));
      // Left wall (x=0): windows spread across the full width — 1 once the wall is
      // 6 ft, a second once it is 15.
      const nL = degenerate ? 0 : (W >= 15 ? 2 : (W >= 6 ? 1 : 0));
      const winL = winCenters(0, W, nL);
      // Right wall (y=0) carries the DOOR, near the near (L,0) corner where the
      // cutaway opens, so the windows share what's left of that wall.
      const doorOn = !degenerate && L >= 8 && H >= 5;
      const doorH = Math.min(6.8, H * 0.8);
      const winSpan0 = 1.5, winSpan1 = doorOn ? L - 5.5 : L - 1.5;
      const span = winSpan1 - winSpan0;
      const nR = degenerate ? 0 : (span >= 12 ? 2 : (span >= 3 ? 1 : 0));
      const winR = winCenters(winSpan0, winSpan1, nR);
      // Furniture. A room too small to walk around gets none at all; beyond that
      // each piece is gated purely on floor area. Sizes cap at 30% of the room so
      // a bed can't swallow a small room, heights at 75% of the ceiling.
      const furn: (FurnBox | null)[] = [];
      const roomy = !degenerate && Math.min(L, W) >= 5;
      const area = L * W;
      // WALL PASS — the three y=0-wall pieces share one stretch of wall, so their
      // x-spans are packed in PRIORITY order (bed, then dresser, then desk)
      // before the pool loop below. Each takes its preferred x, is pushed off any
      // span already claimed to whichever free side is nearer, and is simply not
      // placed when the wall has nothing left — the same collapse→null rule the
      // floor clamps use. The window is [lo, hi]: WALL_LO in from the x=0 wall,
      // stopping short of the door when there is one (what used to be the desk's
      // private rule, now shared — a pushed piece could cross the door too), and
      // starting past the back cleaners' zone for any piece deep enough to reach
      // into it (the bed is 5 ft deep, so in a short room its head would
      // otherwise sit where a back unit stands).
      // WALL_LO clears the CORNER: a piece against the x=0 wall reaches x = 0.3 +
      // its width (1.4 for the bookshelf, 1.7 for the nightstand at their capped
      // widest), and the two walls' pieces would otherwise overlap where they
      // meet — the bed's head landing inside the bookshelf in a short room.
      const WALL_LO = 1.8;
      const wallX = new Map<number, number | null>();
      const taken: [number, number][] = [];
      for (const k of WALL_ORDER) {
        const d = FURN_DEFS[k];
        if (!roomy || area < d.minArea) { wallX.set(k, null); continue; }
        const sx = Math.min(d.sx, L * 0.30), sy = Math.min(d.sy, W * 0.30);
        const hi = Math.min(L - CLEANER_STRIP - sx, doorOn ? L - 4.6 - sx : Infinity);
        const lo = zone && 0.3 < zone.y1 && 0.3 + sy > zone.y0 ? Math.max(WALL_LO, zone.x1) : WALL_LO;
        if (hi < lo) { wallX.set(k, null); continue; }
        const clashOf = (v: number) => taken.find(([a, b]) => v < b - 1e-9 && v + sx > a + 1e-9);
        let x: number | null = clamp(d.fx * L - sx / 2, lo, hi);
        for (let pass = 0; x != null && pass <= taken.length; pass++) {
          const c = clashOf(x);
          if (!c) break;
          const at = x;
          const opts = [c[1], c[0] - sx].filter((v) => v >= lo - 1e-9 && v <= hi + 1e-9);
          opts.sort((p, q) => Math.abs(p - at) - Math.abs(q - at));
          x = opts.length ? opts[0] : null;
        }
        if (x == null || clashOf(x)) { wallX.set(k, null); continue; }
        taken.push([x, x + sx]);
        wallX.set(k, x);
      }
      for (let k = 0; k < FURN_DEFS.length; k++) {
        const d = FURN_DEFS[k];
        if (!roomy || area < d.minArea) { furn.push(null); continue; }
        const sx = Math.min(d.sx, L * 0.30), sy = Math.min(d.sy, W * 0.30);
        // Wall-snapped pieces sit 0.3 ft off their wall — the y=0 ones at the x
        // the wall pass above packed them into (null there means the wall could
        // not hold them). Free-standing ones center on (fx·L, fy·W) and are
        // clamped inside the floor — never into the front cleaners' strip along
        // x=L, and never over the front edge at y=W. A piece whose clamp window
        // has collapsed (the floor cannot hold it clear of both) is simply not
        // placed: at the smallest furnished sizes the armchair would otherwise be
        // pushed into the bookshelf and the cleaner.
        const hiX = L - CLEANER_STRIP - sx, hiY = W - 1 - sy;
        if ((d.snap !== 'x' && hiX < 1) || (d.snap !== 'y' && hiY < 1)) { furn.push(null); continue; }
        const wx = d.snap === 'y' ? wallX.get(k) ?? null : null;
        if (d.snap === 'y' && wx == null) { furn.push(null); continue; }
        const x0 = d.snap === 'x' ? 0.3 : d.snap === 'y' ? wx! : clamp(d.fx * L - sx / 2, 1, hiX);
        let y0 = d.snap === 'y' ? 0.3 : clamp(d.fy * W - sy / 2, 1, hiY);
        // BACK-ZONE RESERVATION (n ≥ 2). The far end of the room now belongs to
        // the x=0-wall cleaners, exactly as the near end belongs to the x=L ones
        // via CLEANER_STRIP — but the back units move with the layout, so the
        // zone is a rectangle handed in rather than a constant. The y=0-wall
        // pieces already dodged it in the wall pass (they cannot leave their
        // wall, so they dodge along x); everything else — the x-snapped
        // bookshelf and nightstand, and the free-standing pool — slides along y
        // to whichever side of the zone is nearer and still fits between the
        // floor clamps, or is not placed at all when neither side has room. That
        // is the same collapse→null rule as above, and in a room barely wider
        // than the zone it will legitimately empty the x=0 wall: a small room
        // with four cleaners is mostly cleaners.
        if (zone && d.snap !== 'y' && x0 < zone.x1 && x0 + sx > zone.x0 && y0 < zone.y1 && y0 + sy > zone.y0) {
          const near = zone.y0 - sy, far = zone.y1;   // just below / just above
          const order = Math.abs(y0 - near) <= Math.abs(y0 - far) ? [near, far] : [far, near];
          // A piece already flush against the x=0 wall may run all the way into
          // the corner (y = 0.3, the same wall gap the y=0 pieces use) — WALL_LO
          // holds that corner open for it. A free-standing piece may not: at
          // y = 0.3 it would be sitting in the middle of the other wall's row.
          const loY = d.snap === 'x' ? 0.3 : 1;
          const slotY = order.find((v) => v >= loY && v <= hiY);
          if (slotY == null) { furn.push(null); continue; }
          y0 = slotY;
        }
        furn.push({ x0, y0, x1: x0 + sx, y1: y0 + sy, h: Math.min(d.h, H * 0.75) });
      }
      // Rug — centered on (fx·L, fy·W), sized to the room, clamped like the
      // free-standing furniture so it never runs under a wall or the cleaners.
      const rugOn = roomy && area >= RUG.minArea;
      const rsx = Math.min(RUG.sx, L * 0.5), rsy = Math.min(RUG.sy, W * 0.55);
      const rx0 = clamp(RUG.fx * L - rsx / 2, 0.8, L - CLEANER_STRIP - rsx);
      const ry0 = clamp(RUG.fy * W - rsy / 2, 0.8, W - 0.8 - rsy);
      return {
        degenerate, sill, winH, doorOn, doorH, winL, winR, furn,
        rugOn, rx0, ry0, rx1: rx0 + rsx, ry1: ry0 + rsy,
      };
    };

    // ---- capacity caption placement ----
    // The caption is the ONE piece of the scene drawn outside the fitted geometry:
    // it hangs off the ghost's near corner, and a height-limited fit puts that
    // corner ON the safe-area edge — so the raw anchor pushes ~19px of text box
    // past the safe edge, which on the narrow band (12px inset) is past the stage
    // itself and the SVG slices it mid-glyph. Feeding the text to the fit is the
    // wrong lever (it would shrink the whole composition at every width for a
    // label that is usually nowhere near an edge), so the ANCHOR is clamped
    // instead, against the measured text box, under two constraints in order:
    //   1. the box sits inside the stage, inset by edgeInset()
    //   2. the box never meets the pause control's keep-out
    // This lives in drawScene's call path, which every draw routes through — the
    // rAF tick, syncViewport, and the paused / reduced-motion draws alike.
    const CAP_GAP = 8;   // px from the ghost's near corner to the caption box
    const capLabelEl = svg.querySelector<SVGGraphicsElement>('[data-label="capacity"]');
    // Cached per string, so a getBBox costs one layout per NEW reading: the number
    // changes in recompute() only, never across the frames of a morph.
    let capMetrics: { key: string; w: number; h: number; dx: number; dy: number } | null = null;
    // How far the caption keeps off the stage edge: the SMALLEST inset the safe
    // area already declares at this breakpoint (12px narrow, 24px wide). Derived
    // from the measured rect rather than typed, so it inherits the CSS spacing
    // tokens and follows them whenever they change.
    const edgeInset = () => Math.max(2, Math.min(
      safe.x, safe.y, viewW - (safe.x + safe.w), viewH - (safe.y + safe.h),
    ));
    const capLabelMetrics = (text: string) => {
      if (!capLabelEl) return null;
      if (capMetrics && capMetrics.key === text) return capMetrics;
      capLabelEl.textContent = text;
      capLabelEl.setAttribute('x', '0'); capLabelEl.setAttribute('y', '0');
      // dx/dy are the box's offset from the ANCHOR at (0,0) — left side bearing and
      // -ascent — which is what lets the clamp work in box space and back-solve the
      // anchor. getBBox is unusable inside a display:none subtree (the narrow
      // variant hides the whole stage off the result step): no metrics, no clamp,
      // and nothing cached, so the next visible draw measures for real.
      let b: DOMRect | null = null;
      try { b = capLabelEl.getBBox(); } catch { b = null; }
      if (!b || !b.width) return null;
      capMetrics = { key: text, w: b.width, h: b.height, dx: b.x, dy: b.y };
      return capMetrics;
    };
    const capLabelAt = (cx: number, cy: number, text: string): Pt => {
      // Preferred spot: down-right of the corner, over open paper at any scale.
      let x = cx + CAP_GAP, y = cy + 2 * CAP_GAP;
      const m = capLabelMetrics(text);
      if (!m) return [x, y];
      const pad = edgeInset();
      // place() takes the BOX's top-left and back-solves the text anchor.
      const place = (bx: number, by: number) => { x = bx - m.dx; y = by - m.dy; };
      place(
        clamp(x + m.dx, pad, Math.max(pad, viewW - pad - m.w)),
        clamp(y + m.dy, pad, Math.max(pad, viewH - pad - m.h)),
      );
      if (pauseBox) {
        // The button's rect grown by the same edge margin, so the caption clears it
        // by the gap it keeps from the stage edge rather than merely touching it.
        const k0x = pauseBox.x - pad, k0y = pauseBox.y - pad;
        const k1x = pauseBox.x + pauseBox.w + pad, k1y = pauseBox.y + pauseBox.h + pad;
        const bx = x + m.dx, by = y + m.dy;
        if (bx < k1x && bx + m.w > k0x && by < k1y && by + m.h > k0y) {
          // Prefer sliding LEFT of the button — same baseline, still reading off the
          // ghost's corner. Only when the caption is too long for that row does it
          // lift clear above, which always fits (the button is a corner control).
          if (k0x - m.w >= pad) place(k0x - m.w, by);
          else place(bx, Math.max(pad, k0y - m.h));
        }
      }
      return [x, y];
    };

    // Draw the whole scene at the given (already-eased) room dimensions. Every
    // world point is projected, then the entire figure is scaled + centred to
    // fill the frame, so proportions stay truthful at any absolute size.
    const drawScene = (L: number, W: number, H: number) => {
      if (!hasScene) return;
      const n = Math.min(Math.max(1, sceneN), MAX_CLEANERS);

      // Capacity ghost is flush with the room's open FRONT side (x=L) — the side
      // where the first cleaner stands — and centered on the width, so it reads
      // as the cleaners' reach from where they sit: growing back across the room
      // as coverage rises, spreading past the side walls once it outgrows them.
      // Footprint scaled by capS; cleaner-independent, so computed once and fed
      // into both fit passes.
      const drawCap = capS > 0.01;
      const gL = L * capS, gW = W * capS;
      const gx0 = L - gL;                       // far x face (negative when bigger than the room)
      const gy0 = (W - gW) / 2, gy1 = (W + gW) / 2; // centered on the width

      // The shadow pad under the diorama: the room footprint plus a margin that
      // grows with the room, at the underside of the floor slab. It also covers the
      // walls' WALL_T overhang behind the origin, so feeding its four corners to
      // the fit keeps the whole cutaway — walls included — inside the safe area.
      const shadowM = Math.max(2, 0.08 * (L + W));

      // The fit as a closure so it can run twice: pass 1 with the world-capped
      // cleaner, then — if that cleaner would render below the on-screen
      // readability floor — pass 2 with a wider (world-unit) cleaner. Everything
      // it reads besides the cleaner array (L/W/H, ghost dims, shadowM, safe,
      // MAX_SCALE) is captured from the enclosing scope.
      const computeFit = (cls: Cleaner[]) => {
        // Collect every world point that must be on-screen, then fit.
        const fitPts: Pt[] = [];
        const box = (x0: number, y0: number, x1: number, y1: number, z1: number) => {
          for (const [x, y] of [[x0, y0], [x1, y0], [x1, y1], [x0, y1]] as Pt[])
            for (const z of [0, z1]) fitPts.push(project(x, y, z));
        };
        // The room box carries all of its own dressing: furniture and cleaners are
        // clamped strictly inside it, so they need no separate feed…
        box(0, 0, L, W, H);
        // …except when the readability pass has widened a cleaner past what the
        // room can hold (a very small room on a very large screen), so the cleaner
        // boxes still go in and the two passes stay consistent.
        for (const c of cls) box(c.x0, c.y0, c.x1, c.y1, c.h);
        // Feed the ghost into the fit so the whole ghost stays inside the safe
        // area (when it's larger than the room, it's what drives the fit).
        if (drawCap) box(gx0, gy0, L, gy1, H);
        for (const [x, y] of [
          [-shadowM, -shadowM], [L + shadowM, -shadowM],
          [L + shadowM, W + shadowM], [-shadowM, W + shadowM],
        ] as Pt[]) fitPts.push(project(x, y, -FLOOR_D));

        const xs = fitPts.map((p) => p[0]);
        const ys = fitPts.map((p) => p[1]);
        const minX = Math.min(...xs), maxX = Math.max(...xs);
        const minY = Math.min(...ys), maxY = Math.max(...ys);
        // Fit into the safe area MINUS the ghost's stroke bleed. Every point above
        // is a geometric corner, but the ghost is drawn with a centred dashed
        // stroke, so half of it paints outside the corner it belongs to — and when
        // the ghost is what drives the fit (bigger than the room) that corner lands
        // exactly ON the safe edge, putting the outline's outer half past it.
        const bleed = capStroke / 2;
        const fw = Math.max(1, safe.w - capStroke);
        const fh = Math.max(1, safe.h - capStroke);
        const scale = Math.min(fw / (maxX - minX || 1), fh / (maxY - minY || 1), MAX_SCALE);
        const ox = safe.x + bleed + (fw - (maxX - minX) * scale) / 2 - minX * scale;
        const oy = safe.y + bleed + (fh - (maxY - minY) * scale) / 2 - minY * scale;
        return { scale, ox, oy };
      };

      // Pass 1: world-capped cleaner. If that footprint would paint below
      // UNIT_MIN_PX on screen (the whole scene zoomed out to fit a huge room),
      // re-lay the cleaner wider in WORLD units so it clears the readability floor,
      // then re-fit once. The 1.1 headroom compensates for pass 2's slightly
      // smaller scale (a wider cleaner is more content to fit). One extra pass only.
      let cleaners = layoutCleaners(L, W, n);
      let fit = computeFit(cleaners);
      const cw1 = cleaners[0].x1 - cleaners[0].x0;
      if (cw1 * fit.scale < UNIT_MIN_PX) {
        cleaners = layoutCleaners(L, W, n, (UNIT_MIN_PX * 1.1) / fit.scale);
        fit = computeFit(cleaners);
      }
      const { scale, ox, oy } = fit;
      fitScale = scale;
      // Room dressing is laid out AFTER the cleaners because it has to dodge
      // them: the furniture reserves the back units' zone, which depends on the
      // FINAL cleaner width (the readability pass above can widen it).
      const det = layoutDetails(L, W, H, backZone(cleaners));
      const w = (x: number, y: number, z: number): Pt => {
        const p = project(x, y, z);
        return [ox + p[0] * scale, oy + p[1] * scale];
      };

      // Shadow pad — sits on the dot paper, under the floor slab.
      setPoly('[data-ground]', [
        w(-shadowM, -shadowM, -FLOOR_D), w(L + shadowM, -shadowM, -FLOOR_D),
        w(L + shadowM, W + shadowM, -FLOOR_D), w(-shadowM, W + shadowM, -FLOOR_D),
      ]);

      // The two back walls, each as three faces: the INTERIOR face (x=0 left,
      // y=0 right), the WALL_T-wide top cap, and the cut edge where the cutaway
      // slices the wall off at the near corner.
      setPoly('[data-room="left"]', [w(0, 0, H), w(0, W, H), w(0, W, 0), w(0, 0, 0)]);
      setPoly('[data-room="right"]', [w(0, 0, H), w(L, 0, H), w(L, 0, 0), w(0, 0, 0)]);
      setPoly('[data-wall-top="left"]', [w(0, 0, H), w(0, W, H), w(-WALL_T, W, H), w(-WALL_T, 0, H)]);
      setPoly('[data-wall-top="right"]', [w(0, 0, H), w(L, 0, H), w(L, -WALL_T, H), w(0, -WALL_T, H)]);
      setPoly('[data-wall-cap="left"]', [w(0, W, H), w(-WALL_T, W, H), w(-WALL_T, W, 0), w(0, W, 0)]);
      setPoly('[data-wall-cap="right"]', [w(L, 0, H), w(L, -WALL_T, H), w(L, -WALL_T, 0), w(L, 0, 0)]);

      // The floor slab — the floor plane plus the two front edges of its depth.
      const floorQuad = [w(0, 0, 0), w(L, 0, 0), w(L, W, 0), w(0, W, 0)];
      setPoly('[data-room="floor"]', floorQuad);
      setPoly('[data-floor-edge="left"]', [w(0, W, 0), w(L, W, 0), w(L, W, -FLOOR_D), w(0, W, -FLOOR_D)]);
      setPoly('[data-floor-edge="right"]', [w(L, 0, 0), w(L, W, 0), w(L, W, -FLOOR_D), w(L, 0, -FLOOR_D)]);
      // …and the same quad again as the clip every cleaning pulse rides inside,
      // so a ring at full radius stops at the floor's edge instead of spilling
      // up the walls or out onto the dot paper (the units stand close to a wall,
      // so at least one ring is always pushing against one).
      setPoly('[data-floor-clip]', floorQuad);

      // Room dressing — re-derived every frame from the eased dims. Counts come
      // from cur: the 0.22 lerp is monotone (no overshoot), so a count steps
      // through each threshold exactly once per morph — a window opens, or a piece
      // of furniture arrives, ONE at a time as the room grows, never flickering.
      // A degenerate room (too small to read) draws bare walls + floor only, so
      // all three dressing groups go hidden together.
      if (detailsG) detailsG.style.visibility = det.degenerate ? 'hidden' : '';
      if (furnG) furnG.style.visibility = det.degenerate ? 'hidden' : '';
      if (det.degenerate) setDetail('[data-rug]', false);
      if (!det.degenerate) {
        const hw = WIN_W / 2;
        const z0 = det.sill, z1 = det.sill + det.winH;   // one row of windows per wall
        for (let s = 1; s <= WIN_POOL; s++) {
          const cl = det.winL[s - 1];   // left wall: x = 0 plane, window spans in y
          setDetail(`[data-win-l="${s}"]`, cl != null, cl != null ? [
            w(0, cl - hw, z1), w(0, cl + hw, z1), w(0, cl + hw, z0), w(0, cl - hw, z0),
          ] : undefined);
          const cr = det.winR[s - 1];   // right wall: y = 0 plane, window spans in x
          setDetail(`[data-win-r="${s}"]`, cr != null, cr != null ? [
            w(cr - hw, 0, z1), w(cr + hw, 0, z1), w(cr + hw, 0, z0), w(cr - hw, 0, z0),
          ] : undefined);
        }
        // Door on the y=0 wall, near the (L,0) corner the cutaway opens on.
        setDetail('[data-door]', det.doorOn, det.doorOn ? [
          w(L - 4.2, 0, det.doorH), w(L - 1.2, 0, det.doorH), w(L - 1.2, 0, 0), w(L - 4.2, 0, 0),
        ] : undefined);
        // Rug — the one flat piece, lying on the floor at z=0.
        setDetail('[data-rug]', det.rugOn, det.rugOn ? [
          w(det.rx0, det.ry0, 0), w(det.rx1, det.ry0, 0), w(det.rx1, det.ry1, 0), w(det.rx0, det.ry1, 0),
        ] : undefined);

        // Furniture — each piece the same 3-face mini-box as a cleaner unit, but
        // standing on the floor (z from 0 to its height). The pool is already in
        // back-to-front order, so drawing it in index order is correct depth.
        for (let k = 0; k < FURN_DEFS.length; k++) {
          const u = det.furn[k];
          const g = svg.querySelector<SVGGElement>(`[data-furn="${k + 1}"]`);
          if (g) g.style.visibility = u ? '' : 'hidden';
          if (!u) continue;
          const zt = u.h;
          setPoly(`[data-furn="${k + 1}"] [data-furn-face="top"]`,   [w(u.x0, u.y0, zt), w(u.x1, u.y0, zt), w(u.x1, u.y1, zt), w(u.x0, u.y1, zt)]);
          setPoly(`[data-furn="${k + 1}"] [data-furn-face="left"]`,  [w(u.x0, u.y1, zt), w(u.x1, u.y1, zt), w(u.x1, u.y1, 0), w(u.x0, u.y1, 0)]);
          setPoly(`[data-furn="${k + 1}"] [data-furn-face="right"]`, [w(u.x1, u.y0, zt), w(u.x1, u.y1, zt), w(u.x1, u.y1, 0), w(u.x1, u.y0, 0)]);
        }
      }

      // Capacity ghost — the same cutaway language the room uses (floor + the
      // two faces away from the viewer) at the scaled footprint, flush with the
      // open front and centered on the width. Purely decorative (pointer-events
      // inherit none). Group visibility is owned by recompute().
      //
      // DEPTH: the ghost scales uniformly, so its body is either entirely inside
      // the room (draw it in the in-front twin, over the floor and walls) or
      // extends entirely beyond it (draw it in the behind-the-walls twin at
      // [data-capg-back], so its bottom borders duck behind the back walls the
      // way real depth demands). The inactive twin is blanked, not hidden — both
      // groups' visibility belongs to recompute().
      if (drawCap) {
        const bodyG = gx0 < -1e-6 ? '[data-capg-back]' : '[data-capg]';
        const idleG = gx0 < -1e-6 ? '[data-capg]' : '[data-capg-back]';
        for (const f of ['floor', 'left', 'right']) setPoly(`${idleG} [data-cap="${f}"]`, []);
        setPoly(`${bodyG} [data-cap="floor"]`, [w(gx0, gy0, 0), w(L, gy0, 0), w(L, gy1, 0), w(gx0, gy1, 0)]);
        setPoly(`${bodyG} [data-cap="left"]`, [w(gx0, gy0, H), w(gx0, gy1, H), w(gx0, gy1, 0), w(gx0, gy0, 0)]);
        setPoly(`${bodyG} [data-cap="right"]`, [w(gx0, gy0, H), w(L, gy0, H), w(L, gy0, 0), w(gx0, gy0, 0)]);
        // Fill-less top face + near-corner vertical: the edges the three faces
        // above don't cover, completing the box outline.
        setPoly('[data-cap="top"]', [w(gx0, gy0, H), w(L, gy0, H), w(L, gy1, H), w(gx0, gy1, H)]);
        const capEdge = svg.querySelector<SVGLineElement>('[data-cap-edge]');
        if (capEdge) {
          const e0 = w(L, gy1, 0), e1 = w(L, gy1, H);
          capEdge.setAttribute('x1', `${e0[0]}`); capEdge.setAttribute('y1', `${e0[1]}`);
          capEdge.setAttribute('x2', `${e1[0]}`); capEdge.setAttribute('y2', `${e1[1]}`);
        }
        // Label just past the ghost's near corner (L, gy1) — its front edge on
        // the open side — nudged down-right so it sits over open paper at any
        // scale (the label itself paints above the room contents regardless).
        // capLabelAt() owns the rest: that corner is a fit boundary, so the nudge
        // alone would run the text off the band and under the pause control.
        const [cx, cy] = w(L, gy1, 0);
        const prefix = capClamped ? '≥' : '';
        // Match the results card's unit toggle: ft² floor area (default) or ft³ volume.
        const capFt3 = raw('units') === 'ft3';
        const capText = capFt3 ? `${fmt(capMaxVol, 0)} ft³` : `${fmt(capMaxVol / 8, 0)} ft²`;
        const capCaption = `covers a room up to ${prefix}${capText}`;
        setLabel('capacity', capLabelAt(cx, cy, capCaption), capCaption);
      }

      // Per cleaner: its cleaning-pulse group (rings lying on the floor) and its
      // unit group (the box standing on the floor). Groups beyond n are hidden via
      // style.visibility — NOT display: this scene toggles everything the same
      // way, and a group that was ever display:none has bitten WebKit here before
      // (it can come back unpainted). Visibility keeps the subtree live and the
      // floor clip resolved. (An SVGGElement has no `.hidden`, so we set the style
      // property directly.)
      ringDefs.length = 0;
      for (let i = 0; i < MAX_CLEANERS; i++) {
        const ringsG = svg.querySelector<SVGGElement>(`.smaqmd-cityview__rings[data-rings="${i + 1}"]`);
        const unitG = svg.querySelector<SVGGElement>(`.smaqmd-cityview__unitg[data-unitg="${i + 1}"]`);
        const on = i < n;
        if (ringsG) ringsG.style.visibility = on ? '' : 'hidden';
        if (unitG) unitG.style.visibility = on ? '' : 'hidden';
        if (!on) {
          // Blank as well as hide: visibility alone would leave last draw's stale
          // points on the ring polygons, which flash for a frame when the group
          // comes back at a different room size.
          ringDefs[i] = null;
          (ringPolys[i] || []).forEach((p) => p.setAttribute('points', ''));
          continue;
        }
        const c = cleaners[i];

        // The cleaning pulse's geometry, cached for the animation tick. Center is
        // the unit's footprint center; the pulse starts just outside the box
        // (0.75 × its width, so the first ring reads as leaving the unit rather
        // than being drawn on it) and travels out to rMax. rMax is a share of the
        // room's SHORT side, floored so a tiny room still shows a ripple and
        // capped so a huge room's pulse stays a local radius rather than a
        // room-spanning ring — the floor clip trims whatever overruns the walls.
        const cw = c.x1 - c.x0;
        const ucx = (c.x0 + c.x1) / 2, ucy = (c.y0 + c.y1) / 2;
        const r0 = 0.75 * cw;
        const rMax = Math.max(r0 + 0.5, Math.min(7, Math.max(2.5, 0.45 * Math.min(L, W))));
        // The projection is linear, so a world circle maps to an exact ellipse and
        // the two unit-foot basis vectors below capture it completely — one
        // subtraction each, once per cleaner per draw, instead of re-projecting
        // 84 ring points.
        const [bx, by] = w(ucx, ucy, 0);
        const [exx, exy] = w(ucx + 1, ucy, 0);
        const [fyx, fyy] = w(ucx, ucy + 1, 0);
        ringDefs[i] = {
          cx: bx, cy: by,
          ex: exx - bx, ey: exy - by,
          fx: fyx - bx, fy: fyy - by,
          r0, rMax,
        };

        // Air-cleaner unit — same three faces, appliance-sized, on the floor.
        const setUnitG = (sel: string, pts: Pt[]) => {
          const el = unitG?.querySelector(sel);
          if (el) el.setAttribute('points', ptsAttr(pts));
        };
        setUnitG('[data-unit="top"]', [w(c.x0, c.y0, c.h), w(c.x1, c.y0, c.h), w(c.x1, c.y1, c.h), w(c.x0, c.y1, c.h)]);
        setUnitG('[data-unit="left"]', [w(c.x0, c.y1, c.h), w(c.x1, c.y1, c.h), w(c.x1, c.y1, 0), w(c.x0, c.y1, 0)]);
        setUnitG('[data-unit="right"]', [w(c.x1, c.y0, c.h), w(c.x1, c.y1, c.h), w(c.x1, c.y1, 0), w(c.x1, c.y0, 0)]);
      }

      // Dimension labels around the room's LEFT-front corner (0,W) — away from
      // the cleaners on the right, so nothing collides. Length rides the FRONT
      // FLOOR EDGE, the open side of the cutaway.
      // Text reads the TRUE feet (drawn × labelK) — identical to the drawn value
      // unless SCENE_MAX has clamped the box.
      const [lx, ly] = mid(w(0, W, 0), w(L, W, 0)); setLabel('length', [lx - 4, ly + 20], `${fmt(L * labelK.L, 1)} ft`);
      // Width rides the LEFT WALL's top edge (z=H), so it meets the top of the
      // height edge at (0,W,H) — reading as height going up, then width across
      // the top. Nudge up-left (its outward normal) to sit just outside the wall.
      const [wx, wy] = mid(w(0, 0, H), w(0, W, H)); setLabel('width', [wx - 12, wy - 12], `${fmt(W * labelK.W, 1)} ft`);
      const [hx, hy] = mid(w(0, W, 0), w(0, W, H)); setLabel('height', [hx - 26, hy], `${fmt(H * labelK.H, 1)} ft`);

      // Drag grips: an invisible fat hit-line along each dimension's edge + a
      // visible knob at the edge midpoint. Positioned every draw so they track
      // the morphing room.
      const HANDLE_DEG: Record<string, number> = { length: 30, width: 150, height: 90 };
      const setLine = (dim: string, p: Pt, q: Pt) => {
        const line = svg.querySelector(`.smaqmd-cityview__hit[data-grip="${dim}"]`);
        if (line) {
          line.setAttribute('x1', p[0].toFixed(1)); line.setAttribute('y1', p[1].toFixed(1));
          line.setAttribute('x2', q[0].toFixed(1)); line.setAttribute('y2', q[1].toFixed(1));
        }
        const [mx, my] = mid(p, q);
        const handle = svg.querySelector(`.smaqmd-cityview__handle[data-grip="${dim}"]`);
        if (handle) handle.setAttribute('transform', `translate(${mx.toFixed(1)} ${my.toFixed(1)}) rotate(${HANDLE_DEG[dim]})`);
      };
      // All three edges survive the cutaway: length is the front floor edge, width
      // is the left wall's top edge, height is the left wall's cut front edge.
      setLine('length', w(0, W, 0), w(L, W, 0));
      setLine('width', w(0, 0, H), w(0, W, H)); // left wall top edge, meets top of height
      setLine('height', w(0, W, 0), w(0, W, H));

      // Repaint the pulse from the bases just cached. Doing it HERE rather than
      // only in the rAF tick is what keeps the rings correct on the draws that
      // aren't part of the animation — the initial render, and the re-fit after a
      // resize (which under prefers-reduced-motion is the only draw there is, and
      // would otherwise leave rings sitting at the previous fit's coordinates).
      paintRings();
    };

    // ---- animation loop: room morph + the cleaning pulse on each cleaner ----
    // Time scale: HOUR_SECONDS of wall-clock = one hour. ONE RING travelling from
    // the unit out to its full radius and fading out is ONE AIR CHANGE, so a fresh
    // ring leaves a cleaner every HOUR_SECONDS / ACH seconds (ACH 2 → every 2.5s).
    // RING_COUNT rings are in flight at a time, evenly spaced through the cycle, so
    // even a slow cadence reads as a continuous ripple rather than a lone blip.
    const HOUR_SECONDS = 5;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // The pulse's explicit stop (SC 2.2.2: auto-playing, indefinite motion needs
    // one). Toggled by the corner button; starts paused under
    // prefers-reduced-motion — the same standstill those users always got, now
    // reversible in either direction.
    let pulsePaused = reduced;
    const cur = { L: 12, W: 10, H: 8 };
    const tgt = { L: 12, W: 10, H: 8 };
    // Capacity ghost: the eased footprint scale (capS) toward its target
    // (capSTgt). capSTgt = √(maxVol / roomVol) clamped to 3 for the DRAWING only
    // (the stats keep the true maxVol); 0 hides the ghost. Set in recompute().
    let capS = 0;
    let capSTgt = 0;
    let capMaxVol = 0;      // true (un-clamped) largest coverable volume, for the label
    let capClamped = false; // whether the drawn scale hit the 3× clamp
    const capG = svg.querySelector<SVGGElement>('[data-capg]');
    // The behind-the-walls twin (see the markup note) — same lockstep visibility.
    const capGBack = svg.querySelector<SVGGElement>('[data-capg-back]');
    // The ghost's upper outline (top face + near vertical) and caption are a
    // sibling group drawn after the room contents (see the markup note) —
    // shown/hidden in lockstep with capG.
    const capLabel = svg.querySelector<SVGGElement>('[data-capg-top]');
    // Per-cleaner air-change cadence: laneAch[i] = that cleaner's flow × 60 ÷ room
    // volume. Zero (blank cleaner) → no pulse on that unit.
    const laneAch: number[] = [];
    // idle | pass | fail | shop (aggregate tint). 'shop' is the preview state: no
    // cleaner entered, but a room + a target are, so the scene shows what buying
    // to the recommended rating would look like. Everything that asks "is the
    // scene live?" asks `stateNow !== 'idle'`, so 'shop' animates by construction;
    // only the two places that name 'pass'/'fail' explicitly (the verdict copy and
    // the fail recolour) treat it differently.
    let stateNow = 'idle';
    let running = false;
    let last = 0;
    // Where each cleaner's pulse sits in its cycle, 0…1. One full cycle is one air
    // change for THAT cleaner; ring k rides k/RING_COUNT ahead of the phase, which
    // is what keeps the three ripples evenly spaced no matter the cadence.
    const ringPhase = new Array<number>(MAX_CLEANERS).fill(0);
    const animating = () => stateNow !== 'idle' && !pulsePaused;

    // Paint every drawn cleaner's rings at the CURRENT phase, off the screen bases
    // drawScene cached. A ring's radius travels linearly from r0 out to rMax across
    // one cycle while its stroke fades to nothing, so it dissolves at its widest
    // rather than snapping back to the unit. Called at the end of every drawScene,
    // which is what keeps the pulse correct on non-animated draws too.
    const paintRings = () => {
      for (let i = 0; i < MAX_CLEANERS; i++) {
        const d = ringDefs[i];
        const polys = ringPolys[i];
        if (!d || !polys) continue;
        for (let k = 0; k < RING_COUNT; k++) {
          const poly = polys[k];
          if (!poly) continue;
          // While paused (the corner button, or prefers-reduced-motion's
          // initial state) the phase never advances, so the rings park at their
          // static offsets (p = k/RING_COUNT): the cleaning-radius cue still
          // reads, it just doesn't travel.
          const p = (ringPhase[i] + k / RING_COUNT) % 1;
          const r = d.r0 + (d.rMax - d.r0) * p;
          const pts: string[] = [];
          for (let s = 0; s < RING_STEPS; s++) {
            const th = (s / RING_STEPS) * Math.PI * 2;
            const ca = Math.cos(th), sa = Math.sin(th);
            pts.push(
              `${(d.cx + r * (d.ex * ca + d.fx * sa)).toFixed(1)},`
              + `${(d.cy + r * (d.ey * ca + d.fy * sa)).toFixed(1)}`,
            );
          }
          poly.setAttribute('points', pts.join(' '));
          poly.setAttribute('stroke-opacity', (0.55 * (1 - p)).toFixed(2));
        }
      }
    };

    // Advance each cleaner's pulse — one cycle per air change for THAT cleaner,
    // with the interval clamped so a very high ACH doesn't strobe and a very low
    // one still visibly moves. Pure arithmetic: the repaint is drawScene's job and
    // runs immediately after on the same tick. Skip cleaners past sceneN, cleaners
    // with no flow, and (with the whole pulse) an idle scene.
    const updateRings = (dt: number) => {
      if (stateNow === 'idle' || pulsePaused) return;
      for (let i = 0; i < MAX_CLEANERS && i < sceneN; i++) {
        const ach = laneAch[i];
        if (!ach || !Number.isFinite(ach)) continue;
        // Rings pulse at a QUARTER of the air-change cadence — the literal rate
        // read as too frenetic, and half was still too lively; the slowed ripple
        // keeps the "faster cleaner, faster pulse" mapping while staying calm.
        const interval = Math.max(1.2, Math.min(80, (4 * HOUR_SECONDS) / ach));
        ringPhase[i] = (ringPhase[i] + dt / interval) % 1;
      }
    };

    // Flag every ring group the scene should NOT pulse: cleaners past sceneN, and
    // cleaners with no cadence. The CSS hides a flagged group outright, so this is
    // the per-lane counterpart to the container's data-state. It runs after EVERY
    // laneAch fill — recompute has two (the measured cleaners, and shop mode's
    // split of the target) — so the flags can never drift from the cadences.
    const syncLaneIdle = () => {
      for (let i = 0; i < MAX_CLEANERS; i++) {
        const idle = !(i < sceneN && laneAch[i] > 0);
        const g = svg.querySelector<SVGGElement>(`.smaqmd-cityview__rings[data-rings="${i + 1}"]`);
        if (!g) continue;
        if (idle) g.setAttribute('data-lane-idle', '');
        else g.removeAttribute('data-lane-idle');
      }
    };

    const frame = (ts: number) => {
      // A crossing into narrow can land mid-loop; drop out on the next tick
      // rather than waiting for the morph to finish against a hidden scene.
      if (!sceneLive) { running = false; return; }
      const dt = Math.min(0.05, (ts - last) / 1000 || 0);
      last = ts;

      // Ease the room toward the entered dimensions, and the capacity ghost's
      // footprint scale toward its target, so the ghost grows/shrinks in step.
      cur.L += (tgt.L - cur.L) * 0.22;
      cur.W += (tgt.W - cur.W) * 0.22;
      cur.H += (tgt.H - cur.H) * 0.22;
      capS += (capSTgt - capS) * 0.22;
      const morphing =
        Math.abs(tgt.L - cur.L) + Math.abs(tgt.W - cur.W) + Math.abs(tgt.H - cur.H) +
        Math.abs(capSTgt - capS) >= 0.01;
      if (!morphing) { cur.L = tgt.L; cur.W = tgt.W; cur.H = tgt.H; capS = capSTgt; }

      // Advance the pulse BEFORE drawing: drawScene re-caches each cleaner's ring
      // bases for the room's current size and then repaints from them, so this
      // order paints this tick's phase against this tick's geometry.
      updateRings(dt);
      drawScene(cur.L, cur.W, cur.H);

      if (morphing || animating()) requestAnimationFrame(frame);
      else running = false;
    };
    const startLoop = () => {
      if (!sceneLive || running) return;   /* sceneLive already implies hasScene */
      running = true;
      last = performance.now();
      requestAnimationFrame(frame);
    };
    // ---- room size across the three entry modes ----
    // roomVolume(): the true volume for the ACH math, per the chosen method.
    // sceneBox(): a drawable L×W×H box for the isometric scene, derived from
    // whatever the mode gives — area/volume modes have no real footprint, so we
    // draw a square room of the equivalent size (√area, or √(vol/8)) with a
    // standard ceiling. 0.5 fallbacks keep the scene alive while fields are blank.
    // Soft upper bounds on room size. These are NOT a validity gate — the ACH
    // arithmetic is correct at any size, so an over-size room still computes and
    // still shows a result; it only raises the [data-room-warn] alert, because at
    // this scale the overwhelmingly likely cause is a typo. The DRAG grips clamp
    // to the same numbers, so pulling an edge and typing a value can never
    // disagree about where the room stops (they used to: drag clamped at 100 ft
    // while typing had no bound at all).
    const ROOM_MAX = { length: 100, width: 100, height: 30, area: 10000, volume: 300000 };
    const ROOM_MIN = 1;
    // Is any entered field, in the CURRENT entry mode, past its bound?
    const roomOversize = (): boolean => {
      const over = (name: keyof typeof ROOM_MAX) => {
        const v = num(name);
        return Number.isFinite(v) && v > ROOM_MAX[name];
      };
      switch (raw('roomMethod')) {
        case 'dimensions': return over('length') || over('width') || over('height');
        case 'area':       return over('area') || over('height');
        case 'volume':     return over('volume');
        default:           return false;
      }
    };
    const roomVolume = (): number => {
      switch (raw('roomMethod')) {
        case 'dimensions': return num('length') * num('width') * num('height');
        case 'area':       return num('area') * num('height');
        case 'volume':     return num('volume');
        default:           return NaN;
      }
    };
    // roomArea(): the room's FLOOR AREA in ft² — the relatable unit for the result
    // (people picture square feet, not cubic feet). Exact from L×W or an entered
    // area; in volume-only mode there's no footprint, so approximate at a standard
    // 8 ft ceiling (the same assumption the coverage figure uses).
    const roomArea = (): number => {
      switch (raw('roomMethod')) {
        case 'dimensions': { const a = pos('length') * pos('width'); return a > 0 ? a : NaN; }
        case 'area':       return pos('area');
        case 'volume':     { const v = pos('volume'); return v > 0 ? v / 8 : NaN; }
        default:           return NaN;
      }
    };
    const sceneBox = (): { L: number; W: number; H: number } => {
      const method = raw('roomMethod');
      if (method === 'area') {
        const area = pos('area');
        const H = pos('height') || 8;
        const side = Number.isFinite(area) ? Math.sqrt(area) : 0.5;
        return { L: side || 0.5, W: side || 0.5, H };
      }
      if (method === 'volume') {
        const vol = pos('volume');
        const H = 8;
        const side = Number.isFinite(vol) ? Math.sqrt(vol / H) : 0.5;
        return { L: side || 0.5, W: side || 0.5, H };
      }
      return { L: pos('length') || 0.5, W: pos('width') || 0.5, H: pos('height') || 0.5 };
    };
    const morphScene = () => {
      const b = sceneBox();
      // Clamp what we DRAW at SCENE_MAX, and record how far the true box overran
      // so the dimension labels can still read the entered feet.
      tgt.L = Math.min(b.L, SCENE_MAX);
      tgt.W = Math.min(b.W, SCENE_MAX);
      tgt.H = Math.min(b.H, SCENE_MAX_H);
      labelK.L = b.L / tgt.L; labelK.W = b.W / tgt.W; labelK.H = b.H / tgt.H;
      startLoop();
    };

    // ---- scene pause (responsive variant only) ----
    // The responsive variant is the only one whose scene appears and disappears
    // during a session, so this is the only one that needs to stop and restart the
    // rAF loop. Defined here, below morphScene, because it calls it.
    //
    // TWO things can hide it under 68rem: the breakpoint itself, and the step —
    // narrow shows the scene ONLY on the result section, whose id renderStep
    // stamps on the root (and toIntro clears). The condition below is the exact
    // complement of the CSS in the 68rem block, so the loop is live if and only if
    // the band is on screen; both callers just re-run it after changing a state.
    //
    // Going dark: flipping sceneLive is enough — frame() bails on its next tick
    // and startLoop() refuses to restart, so nothing runs while the scene is
    // hidden. Coming back, two things are stale and both are SNAPPED rather than
    // replayed: the eased room box and the capacity ghost's scale, which would
    // otherwise animate from wherever the loop happened to stop to wherever the
    // inputs now say — a morph the user never triggered, of a scene they were not
    // looking at. Then refit (the container was 0x0 while hidden, and the layout
    // has by definition just changed) and restart the pulse via morphScene, which
    // ends in startLoop().
    const syncSceneLive = () => {
      const live = hasScene && !(isResponsive && mqMobile.matches && root.dataset.section !== '3');
      if (live === sceneLive) return;
      sceneLive = live;
      if (!live) return;
      cur.L = tgt.L; cur.W = tgt.W; cur.H = tgt.H;
      capS = capSTgt;
      syncViewport();
      morphScene();
    };
    if (isResponsive && hasScene) mqMobile.addEventListener('change', syncSceneLive);

    // ---- pulse pause/play ----
    // Label + glyph swap together (a media-style toggle, not aria-pressed).
    // Resuming must call startLoop(): a fully settled scene has no rAF in
    // flight to pick the phase back up. (`pulseToggle` is queried up with the
    // scene nodes — syncViewport measures the same button as a caption keep-out.)
    const syncPulseToggle = () => {
      if (!pulseToggle) return;
      const label = `${pulsePaused ? 'Play' : 'Pause'} the air-cleaning animation`;
      pulseToggle.setAttribute('aria-label', label);
      pulseToggle.setAttribute('title', label);
      pulseToggle.querySelectorAll<SVGElement>('[data-icon]').forEach((icon) => {
        icon.style.display = (icon.dataset.icon === 'pause') === pulsePaused ? 'none' : '';
      });
    };
    if (pulseToggle) {
      syncPulseToggle();
      pulseToggle.addEventListener('click', () => {
        pulsePaused = !pulsePaused;
        syncPulseToggle();
        if (!pulsePaused) startLoop();
      });
    }

    // ---- air-cleaner list (add / remove any number, capped at MAX_CLEANERS) ----
    const cleanersHost = root.querySelector<HTMLElement>('[data-cleaners]')!;
    const template = root.querySelector<HTMLTemplateElement>('[data-cleaner-template]')!;
    const cleanerBlocks = () =>
      qa('[data-cleaner-block]:not([data-removing])');
    let nextId = 0;

    // Fields duplicated when copying a cleaner — air cleaners are assumed identical
    // by default, so an added one inherits the last one's reported values.
    const CLEANER_FIELDS = ['unit', 'airflow', 'ach', 'refMethod', 'refArea', 'refLength', 'refWidth', 'refHeight'];
    // Reveal a newly added block with an ease-out expand — the enter mirror of
    // removeCleaner's collapse. Collapse is applied synchronously (no full-height
    // flash), then measured on the next frame (once the stamped esa-* fields have
    // laid out) and expanded to that height. box-sizing:border-box + overflow:hidden
    // clip the block's padding + top-border separator as it grows. Reduced motion →
    // instant, matching remove.
    const animateIn = (b: HTMLElement) => {
      if (reduced) return;
      b.style.overflow = 'hidden';
      b.style.boxSizing = 'border-box';
      b.style.blockSize = '0';
      b.style.opacity = '0';
      requestAnimationFrame(() => {
        const target = b.scrollHeight;
        const dur = 200;
        b.style.transition = `block-size ${dur}ms ease-out, opacity ${dur}ms ease-out`;
        b.style.blockSize = `${target}px`;
        b.style.opacity = '1';
        let done = false;
        const clear = () => {
          if (done) return;
          done = true;
          b.style.transition = '';
          b.style.overflow = '';
          b.style.boxSizing = '';
          b.style.blockSize = '';
          b.style.opacity = '';
        };
        b.addEventListener('transitionend', (e) => {
          if ((e as TransitionEvent).propertyName === 'block-size') clear();
        });
        window.setTimeout(clear, dur + 80);
      });
    };
    const addCleaner = (opts?: { copyLast?: boolean; animate?: boolean }) => {
      if (cleanerBlocks().length >= MAX_CLEANERS) return;
      // Copy from the last existing cleaner so its values replicate into the new
      // one. If that cleaner is blank (e.g. the initial one), the new one is blank
      // too — hence "blank for the first new one, replicate once you've entered it".
      const srcId = opts?.copyLast ? cleanerBlocks().at(-1)?.dataset.cleanerBlock : undefined;
      const frag = template.content.cloneNode(true) as DocumentFragment;
      const b = frag.querySelector<HTMLElement>('[data-cleaner-block]')!;
      const id = String(++nextId);
      b.setAttribute('data-cleaner-block', id);
      b.querySelectorAll('[data-cleaner]').forEach((el) => el.setAttribute('data-cleaner', id));
      // Stamp copied values as attributes BEFORE upgrade so each field boots
      // populated even if the esa-* element hasn't defined yet.
      if (srcId) {
        CLEANER_FIELDS.forEach((name) => {
          const val = raw(name, srcId);
          if (!val) return;
          const dst = b.querySelector(`[data-field="${name}"][data-cleaner]`);
          if (dst) dst.setAttribute('value', val);
        });
      }
      cleanersHost.appendChild(frag);
      if (opts?.animate) animateIn(b);
    };
    // The initial cleaner boots blank, so the tool opens on the "no cleaner yet →
    // here's the minimum CADR to look for" state.
    const resetCleaners = () => {
      cleanersHost.replaceChildren();
      nextId = 0;
      addCleaner();
    };

    // Collapse the clicked block in place so the eye tracks WHICH cleaner leaves.
    // It's excluded from cleanerBlocks() the moment it starts collapsing, so the
    // scene + result update immediately while the row animates out.
    const removeCleaner = (b: HTMLElement) => {
      // Move focus OFF the doomed block before anything collapses — the
      // activated Remove button is inside it, and removing a focused element
      // drops focus to <body>. Nearest surviving block's Remove button when 2+
      // remain (theirs stay visible); otherwise the Add button (the sole
      // survivor's Remove button is about to hide).
      const all = cleanerBlocks();
      const idx = all.indexOf(b);
      const rest = all.filter((x) => x !== b);
      let next: HTMLButtonElement | null = null;
      if (rest.length > 1) {
        const neighbor = rest[Math.min(idx, rest.length - 1)];
        next = neighbor.querySelector<HTMLButtonElement>('[data-remove-cleaner] button');
      }
      if (!next) next = root.querySelector<HTMLButtonElement>('[data-add-cleaner] button');
      next?.focus();
      kitAnnounce(`Air cleaner ${idx + 1} removed.`);
      b.setAttribute('data-removing', '');
      const finishNow = () => { b.remove(); morphScene(); recompute(); };
      if (reduced) { finishNow(); return; }
      const startHeight = b.offsetHeight;
      b.style.overflow = 'hidden';
      b.style.boxSizing = 'border-box';
      b.style.blockSize = `${startHeight}px`;
      b.getBoundingClientRect(); // flush the start height before transitioning
      const duration = 180;
      b.style.transition =
        `block-size ${duration}ms ease, opacity ${duration}ms ease, ` +
        `padding-block ${duration}ms ease, margin-block ${duration}ms ease, ` +
        `border-block ${duration}ms ease`;
      b.style.blockSize = '0';
      b.style.opacity = '0';
      b.style.paddingBlock = '0';
      b.style.marginBlock = '0';
      b.style.borderBlock = '0';
      let done = false;
      const finish = () => { if (done) return; done = true; finishNow(); };
      b.addEventListener('transitionend', (e) => {
        const p = (e as TransitionEvent).propertyName;
        if (p === 'block-size' || p === 'height') finish();
      });
      window.setTimeout(finish, duration + 60);
      recompute(); // update the readout now, before the collapse finishes
    };

    // ---- visibility sync (room-mode wrappers, entry-mode flag, cleaner chrome) ----
    const showEl = (el: Element | null, on: boolean) => { if (el) (el as HTMLElement).hidden = !on; };
    const syncVisibility = () => {
      // Room-entry field wrappers matching the chosen method.
      const method = raw('roomMethod') || 'dimensions';
      qa('[data-room]').forEach((el) => showEl(el, el.dataset.room!.split(' ').includes(method)));
      // Entry-mode flag drives the CSS grip gate (dimensions-only draggable edges).
      container.dataset.entryMode = method;

      // Step-2 fork: hide the whole cleaner-entry UI when the user says they have
      // none ("No"). combinedFlow() below reads the same flag, so hidden cleaners
      // contribute nothing and the result falls through to shop mode.
      showEl(root.querySelector('[data-cleaner-entry]'), raw('hasCleaner') !== 'no');

      // Per-cleaner: renumber the title + remove-button label, show Remove only
      // when >1 cleaner. Then toggle the Add button + cap note against the cap.
      const blocks = cleanerBlocks();
      blocks.forEach((b, i) => {
        const title = b.querySelector('.smaqmd-aerb__cleaner-title');
        if (title) title.textContent = `Air cleaner ${i + 1}`;
        const rm = b.querySelector('[data-remove-cleaner]');
        showEl(rm, blocks.length > 1);
        // The lego rendered a NATIVE <button aria-label title> at build time —
        // rewrite those, not the compile-time `label` prop, which no longer
        // exists as anything settable.
        const btn = rm?.querySelector<HTMLButtonElement>('button');
        if (btn) {
          const rmLabel = `Remove air cleaner ${i + 1}`;
          btn.setAttribute('aria-label', rmLabel);
          btn.setAttribute('title', rmLabel);
        }
        // Per-cleaner unit mode: show the airflow or the ACH sub-form.
        const unit = raw('unit', b.dataset.cleanerBlock!);
        showEl(b.querySelector('[data-unit-mode="airflow"]'), unit !== 'ach');
        showEl(b.querySelector('[data-unit-mode="ach"]'), unit === 'ach');
        // Reference-room entry mode inside the ACH sub-form — the same wrapper
        // rule as [data-room] above, but queried on the BLOCK so each cleaner
        // keeps its own choice.
        const refMethod = raw('refMethod', b.dataset.cleanerBlock!) || 'area';
        b.querySelectorAll<HTMLElement>('[data-ref]').forEach((el) =>
          showEl(el, el.dataset.ref!.split(' ').includes(refMethod)));
      });
      const atCap = blocks.length >= MAX_CLEANERS;
      showEl(root.querySelector('[data-add-cleaner]'), !atCap);
      showEl(root.querySelector('[data-cap-note]'), atCap);
    };

    // ---- result + flow state ----
    const block = root.querySelector<HTMLElement>('[data-result]')!;
    const setMetric = (name: string, html: string) => {
      const el = root.querySelector(`[data-metric="${name}"] .esa-stat__value`);
      // innerHTML: callers pass computed numbers + an optional unit <span>, never user input.
      if (el) el.innerHTML = html;
    };
    // A stat value's unit, rendered smaller than the number (leading space kept
    // inside the span so screen readers still read "240 CFM").
    const unit = (u: string) => `<span class="smaqmd-aerb__unit"> ${u}</span>`;
    const setReadout = (name: string, text: string) =>
      block.querySelectorAll(`[data-r="${name}"]`).forEach((el) => (el.textContent = text));
    const show = (el: Element | null, on: boolean) => {
      if (!el) return;
      const node = el as HTMLElement;
      const wasHidden = node.hidden;
      node.hidden = !on;
      // A [data-alert] block is a VISIBLE message, not a live region — announcing it
      // here keeps the kit's two regions the only ones on the page (SC 4.1.3), and
      // only on the hidden -> visible edge so a recompute does not re-announce.
      if (on && wasHidden && node.hasAttribute('data-alert')) {
        kitAnnounce(node.textContent?.trim() ?? '', { assertive: node.dataset.alert === 'assertive' });
      }
    };

    // Clean-air flow (CFM) for one cleaner block; blank/partial → 0 so empty
    // rows never block the result. Combined flow sums the live (non-removing)
    // rows. In airflow mode the reported flow is used directly; in ACH mode the
    // flow is derived from the reported ACH × the manufacturer's reference room
    // volume ÷ 60 — the same equation Option A uses. That reference volume is
    // L×W×(H‖8) or area×(H‖8), whichever way the block's refMethod says the room
    // was given (blank height → a standard 8 ft in both).
    const cleanerFlow = (id: string): number => {
      let f: number;
      if (raw('unit', id) === 'ach') {
        const refH = pos('refHeight', id) || 8;
        const refVol = raw('refMethod', id) === 'dimensions'
          ? num('refLength', id) * num('refWidth', id) * refH
          : num('refArea', id) * refH;
        f = (pos('ach', id) * refVol) / 60;
      } else {
        f = pos('airflow', id);
      }
      return Number.isFinite(f) && f > 0 ? f : 0;
    };
    // "No cleaner to check" (step-2 fork) → zero flow regardless of any stale
    // values in the hidden blocks, so the result falls through to shop mode.
    const hasCleaners = (): boolean => raw('hasCleaner') !== 'no';
    const combinedFlow = (): number =>
      hasCleaners()
        ? cleanerBlocks().reduce((sum, b) => sum + cleanerFlow(b.dataset.cleanerBlock!), 0)
        : 0;

    const showGroup = (name: string, on: boolean) =>
      show(block.querySelector(`[data-group="${name}"]`), on);

    // Information card — show exactly one verdict alert (pass / fail / shop), or
    // none. Separate from the answer headline's own data-verdict (which tints the
    // heading); these are the boxed callouts under the hero.
    const setVerdictCard = (state: string | null) =>
      block.querySelectorAll<HTMLElement>('[data-verdict-card]').forEach((el) =>
        show(el, el.dataset.verdictCard === state));

    // Result "answer" section — the direct yes/no + hero metric refs + setter.
    const answerG = block.querySelector<HTMLElement>('[data-group="answer"]');
    const answerTitle = block.querySelector<HTMLElement>('[data-answer-title]');
    // Target alerts live on the target STEP (outside [data-result]), so query them
    // on root — not block, which is the result subtree (they'd never resolve).
    const targetWarn = root.querySelector<HTMLElement>('[data-target-warn]');
    const targetInvalid = root.querySelector<HTMLElement>('[data-target-invalid]');
    const roomWarn = root.querySelector<HTMLElement>('[data-room-warn]');
    // The quick-set slider above the target field. It FOLLOWS the field — every
    // path that can alter the target (a drag, typing, the initial paint) ends in
    // recompute(), so the sync lives there and nowhere else.
    const targetSliderEl = root.querySelector<HTMLElement & { value?: number }>('[data-field="targetSlider"]');
    const SLIDER_MIN = 1, SLIDER_MAX = 8, SLIDER_STEP = 0.5;
    const syncTargetSlider = (entered: number) => {
      if (!targetSliderEl) return;
      // A blank or junk field leaves the thumb exactly where it is: there is no
      // "no value" position on a slider, and snapping it to the minimum would
      // announce a target the user never asked for.
      if (!Number.isFinite(entered)) return;
      // Clamp to the track, then round to the step. The native input snaps the
      // THUMB to the step anyway, but the lego paints its fill from the raw
      // property — rounding here keeps the fill and the thumb from disagreeing
      // by half a step on a typed 3.3. The field keeps the exact 3.3.
      const clamped = Math.min(SLIDER_MAX, Math.max(SLIDER_MIN, entered));
      const next = Math.round(clamped / SLIDER_STEP) * SLIDER_STEP;
      // Assigning the property re-renders WITHOUT firing change (the lego only
      // dispatches from its own @input handler), so this can never loop back into
      // onEdit — the guard is the lego's contract, not a flag.
      if (targetSliderEl.value !== next) targetSliderEl.value = next;
    };
    const achWrap = block.querySelector<HTMLElement>('[data-metric="ach"]');
    const achEvidence = block.querySelector<HTMLElement>('[data-ach-evidence]');
    const fixWrap = block.querySelector<HTMLElement>('[data-metric="fix"]');
    // The fix stat's label + sub are REWRITTEN per rating mode (see renderFix), so
    // they are grabbed once here alongside the wrapper rather than re-queried.
    const fixLabel = fixWrap?.querySelector<HTMLElement>('.esa-stat__label') ?? null;
    const fixSub = fixWrap?.querySelector<HTMLElement>('.esa-stat__sub') ?? null;
    const fixEquiv = fixWrap?.querySelector<HTMLElement>('[data-ach-equiv]') ?? null;
    const fixEquivRows = fixWrap?.querySelector<HTMLElement>('[data-ach-equiv-rows]') ?? null;
    const cadrHighEl = block.querySelector<HTMLElement>('[data-cadr-high]');
    const setAnswer = (title: string, verdict: 'pass' | 'fail' | 'shop' | null) => {
      if (answerTitle) answerTitle.textContent = title;
      if (answerG) {
        if (verdict) answerG.setAttribute('data-verdict', verdict);
        else answerG.removeAttribute('data-verdict');
        show(answerG, verdict != null);
      }
    };

    // Debounced polite announcer: a one-sentence summary written 600 ms after the
    // last change (drag gestures don't chatter), and only when the text differs.
    let announceTimer = 0;
    let lastAnnounce = '';
    const announce = (msg: string) => {
      window.clearTimeout(announceTimer);
      announceTimer = window.setTimeout(() => {
        if (msg !== lastAnnounce) { kitAnnounce(msg); lastAnnounce = msg; }
      }, 600);
    };

    const recompute = () => {
      syncVisibility();

      const blocks = cleanerBlocks();
      // Effective cleaner count: how many the CADR-to-buy is split across. A shopper
      // with no cleaner ("No") is buying ONE, so the divisor is 1 no matter how many
      // stale blocks linger; a checker splits across the blocks they entered.
      const cleanerCount = hasCleaners() ? Math.max(1, blocks.length) : 1;
      sceneN = Math.min(Math.max(1, blocks.length), MAX_CLEANERS);
      const target = pos('target') || 2;
      setReadout('target', fmt(target, 2));
      // A target of 0 (or less) is not a real goal — it's blocked (invalid). A
      // positive target below the CARB-recommended 2 is allowed but flagged.
      const enteredTarget = num('target');
      const targetIsInvalid = Number.isFinite(enteredTarget) && enteredTarget <= 0;
      show(targetInvalid, targetIsInvalid);
      show(roomWarn, roomOversize());
      show(targetWarn, Number.isFinite(enteredTarget) && enteredTarget > 0 && enteredTarget < 2);
      syncTargetSlider(enteredTarget);

      const flow = combinedFlow();
      const vol = roomVolume();
      const hasFlow = flow > 0;
      const hasRoom = Number.isFinite(vol) && vol > 0;
      // The shop flow's scene preview: no cleaner to measure, but a room AND a
      // real target, which is everything the recommendation is made of — so the
      // scene can show it. `target` alone can't gate this (it falls back to 2 when
      // the field is blank); a preview of a number the user hasn't given would be
      // the tool answering its own question, so it takes the ENTERED target. The
      // three result branches below key their scene state off this same flag.
      const shopPreview = !hasFlow && hasRoom
        && Number.isFinite(enteredTarget) && enteredTarget > 0;

      // Secondary readouts — room + coverage, in the unit picked by the inline
      // toggle (ft² floor area by default, ft³ volume for those who think that way).
      // Coverage volume = largest room the setup covers at target; ÷8 → floor area.
      const area = roomArea();
      const coverVol = hasFlow ? (flow * 60) / target : NaN;
      const asFt3 = raw('units') === 'ft3';
      // Which rating the "shop for" stat states (the toggle under it).
      const asAch = raw('rating') === 'ach';
      // Count-aware subject so the legend reads "Your cleaner covers" / "Your
      // cleaners cover" (this line only shows with flow, so ≥ 1 cleaner).
      setReadout('coversubj', blocks.length > 1 ? 'Your cleaners cover' : 'Your cleaner covers');
      setReadout('roomarea', hasRoom && Number.isFinite(area)
        ? (asFt3 ? `${fmt(vol, 0)} ft³` : `${fmt(area, 0)} ft²`) : '—');
      setReadout('coverarea', hasFlow
        ? (asFt3 ? `${fmt(coverVol, 0)} ft³` : `${fmt(coverVol / 8, 0)} ft²`) : '—');
      // ACH the current setup delivers + whether it meets the target. Computed once
      // here so the min-CADR guidance and the verdict below stay in agreement.
      const ach = hasFlow && hasRoom ? (flow / vol) * 60 : NaN;
      const pass = hasFlow && hasRoom && ach >= target;
      // Secondary is the coverage-vs-room COMPARISON — PASS only. On a fail the
      // evidence line already carries the shortfall and a second comparison would
      // dilute the action; in shop mode there is no cleaner to compare at all.
      showGroup('secondary', pass);

      // Capacity ghost — the largest room the cleaners cover at the target,
      // overlaid on the actual room. Only meaningful with both a flow and a room
      // (need both boxes to compare). The DRAWN footprint scale clamps at 3× so
      // an extreme target can't blow the scene out; the label + stats keep the
      // true un-clamped maxVol. data-cap-compare tells the CSS which box is bigger
      // so the LARGER one gets the more transparent fill.
      if (hasFlow && hasRoom) {
        capMaxVol = (flow * 60) / target;
        const s = Math.sqrt(capMaxVol / vol);
        capSTgt = Math.min(s, 3);
        capClamped = s > 3;
        container.dataset.capCompare = capMaxVol >= vol ? 'bigger' : 'smaller';
        if (capG) capG.style.visibility = '';
        if (capGBack) capGBack.style.visibility = '';
        if (capLabel) capLabel.style.visibility = '';
      } else if (shopPreview) {
        // Shop mode: the ghost is the RECOMMENDED setup's coverage, and the
        // recommendation is sized to this room by construction — combined CADR =
        // target × vol ÷ 60, so the volume it covers back out to is (CADR × 60) ÷
        // target = vol exactly. The ghost therefore lands FLUSH on the room box
        // (scale 1, never clamped, never the smaller of the two). That coincidence
        // is the whole point of showing it: the label reads "covers a room up to
        // <this room>", which turns an abstract rating into the box the user is
        // standing in. Computed straight from vol rather than through the CADR —
        // needCadr is declared further down, and threading it up here would make
        // the ghost depend on statement order for a value we already know.
        // (In ft² the label divides by the standard 8 ft ceiling, the same
        // convention the coverage stat uses, so a non-8 ft room reads as its
        // equivalent area rather than its literal footprint.)
        capMaxVol = vol;
        capSTgt = 1;
        capClamped = false;
        container.dataset.capCompare = 'bigger';
        if (capG) capG.style.visibility = '';
        if (capGBack) capGBack.style.visibility = '';
        if (capLabel) capLabel.style.visibility = '';
      } else {
        capSTgt = 0;
        capClamped = false;
        if (capG) capG.style.visibility = 'hidden';
        if (capGBack) capGBack.style.visibility = 'hidden';
        if (capLabel) capLabel.style.visibility = 'hidden';
      }

      // Fill each cleaner's ACH share for the pulse cadence (flow_i × 60 ÷ vol),
      // and mark idle any cleaner with no flow so its rings stay hidden.
      laneAch.length = 0;
      blocks.forEach((b, i) => {
        if (i >= MAX_CLEANERS) return;
        const f = cleanerFlow(b.dataset.cleanerBlock!);
        laneAch[i] = hasRoom && f > 0 ? (f / vol) * 60 : 0;
      });
      syncLaneIdle();

      // ANSWER + hero metric + pulse. Three result states, all with a room present
      // (the wizard gates leaving step 0 without one): a cleaner that PASSES, one
      // that FAILS, or no cleaner yet (SHOP for a rating). The hero ACH shows only
      // when there's a cleaner to measure; the fix note (need group, set above)
      // carries the shopping guidance in the fail + shop states.
      // The minimum COMBINED CADR — the total clean-air delivery all the cleaners
      // together must add up to. A CADR isn't "bought" per unit; it's the sum the
      // setup reaches, so this is independent of how many cleaners share the load.
      const needCadr = (target * vol) / 60;
      // The "shop for" stat, written in whichever rating the toggle asks for. Both
      // the FAIL and the SHOP path below render it, so it lives here as one
      // function rather than as two copies that could word the same number
      // differently.
      //   CADR — the number printed on the box, in CFM. Combined, because a CADR is
      //          not bought per unit: it is the sum the setup has to reach.
      //   ACH  — the user's own target, restated as the claim a box would have to
      //          make: N air changes an hour IN A ROOM AT LEAST THIS BIG. There is
      //          no standard test room to convert a CADR against, so the
      //          qualification is their room, not a fictional one — without it the
      //          number would be an ACH rating for no particular room, which is
      //          exactly the misreading the tool exists to correct.
      const renderFix = () => {
        if (asAch) {
          setMetric('fix', `${fmt(target, 2)}${unit('ACH')}`);
          if (fixLabel) fixLabel.textContent = 'ACH coverage to shop for';
          if (fixSub) fixSub.textContent =
            `${fmt(target, 2)} air changes per hour in your ${fmt(area, 0)} ft² room`;
          // The equivalence rows: a listing pair (A ACH, S ft²) implies a CADR of
          // A × S × 8 / 60, so the pair qualifies when S ≥ needCadr × 7.5 / A.
          // Printed at the ACH levels listings actually quote, plus the user's own
          // target when it isn't one of them; ceil keeps every row conservative.
          if (fixEquivRows) {
            const levels = [1, 2, 4, 5];
            if (target > 0 && !levels.includes(target)) levels.push(target);
            levels.sort((a, b) => a - b);
            fixEquivRows.textContent = '';
            for (const a of levels) {
              const li = document.createElement('li');
              li.textContent = `${fmt(a, 2)} ACH — covers ${fmt(Math.ceil((needCadr * 7.5) / a), 0)} ft² or more`;
              fixEquivRows.appendChild(li);
            }
          }
          show(fixEquiv, true);
        } else {
          setMetric('fix', `${fmt(needCadr, 0)}${unit('CFM (ft³/min)')}`);
          if (fixLabel) fixLabel.textContent = 'combined CADR to shop for';
          if (fixSub) fixSub.textContent = 'added up across all the air cleaners in the room';
          show(fixEquiv, false);
        }
      };
      const setPrompt = (on: boolean) => show(block.querySelector('[data-prompt="empty"]'), on);
      if (targetIsInvalid) {
        // Invalid target (≤ 0): block the verdict rather than compute one from the
        // silent default. The target-step alert tells the user how to fix it.
        show(achWrap, false);
        show(fixWrap, false);
        setAnswer('', null);
        setVerdictCard(null);
        showGroup('secondary', false);
        stateNow = 'idle';
        container.dataset.state = 'idle';
        setPrompt(true);
        announce('');
      } else if (hasFlow && hasRoom) {
        // Pass/fail: ACTION over evidence. On a pass the delivered ACH is the hero
        // (there is nothing to do). On a FAIL the CADR-to-shop-for is the only
        // hero and the delivered ACH demotes to the evidence line below it.
        setMetric('ach', fmt(ach, 1));
        setReadout('ach', fmt(ach, 1));
        show(achWrap, pass);
        show(achEvidence, !pass);
        const achSub = achWrap?.querySelector<HTMLElement>('.esa-stat__sub');
        if (achSub) achSub.textContent =
          `${pass ? 'Meets' : 'Below'} your ${fmt(target, 2)} air changes per hour target`;
        renderFix();
        show(fixWrap, !pass);
        // Fail remedies: how many MORE of the user's current (assumed-identical)
        // cleaner would reach the target, and a caution when the CADR-to-buy is
        // beyond a typical single unit (~700 CFM). Pass shows neither.
        if (!pass) {
          // "Add N more" sizes N off the WEAKEST cleaner entered, so N units like
          // yours are guaranteed to reach the target even when your cleaners differ
          // (adding stronger ones only does better). For 1 or identical cleaners
          // it's just that cleaner's own flow.
          const neededFlow = (target * vol) / 60;                 // total CFM to hit target
          const flows = blocks.map((b) => cleanerFlow(b.dataset.cleanerBlock!)).filter((f) => f > 0);
          const weakest = flows.length ? Math.min(...flows) : 0;
          const moreUnits = weakest > 0 ? Math.max(1, Math.ceil((neededFlow - flow) / weakest)) : 0;
          setReadout('moreunits', fmt(moreUnits, 0));
          setReadout('unitnoun', moreUnits === 1 ? 'air cleaner' : 'air cleaners');
        }
        // The >700 caution is SHOP-mode-only: here "Add N more" already carries
        // the multi-unit reality, so restating it would just re-clutter the fail.
        show(cadrHighEl, false);
        // "Powerful enough", not "big enough" — adequacy here is airflow (CADR), not
        // physical size; the size metaphor feeds the very misconception the tool corrects.
        const subj = blocks.length > 1 ? 'Your cleaners are' : 'Your cleaner is';
        const subjNeg = blocks.length > 1 ? "Your cleaners aren't" : "Your cleaner isn't";
        setAnswer(pass ? `${subj} powerful enough for this room` : `${subjNeg} powerful enough for this room`, pass ? 'pass' : 'fail');
        setVerdictCard(pass ? 'pass' : 'fail');
        setPrompt(false);
        stateNow = pass ? 'pass' : 'fail';
        container.dataset.state = stateNow;
        announce(
          `This setup delivers ${fmt(ach, 1)} air changes per hour, ` +
          `${pass ? 'at or above' : 'below'} your target of ${fmt(target, 1)}.`,
        );
        startLoop();
      } else if (hasRoom) {
        // Shop mode (no cleaner yet): the combined CADR to reach IS the result, so it takes
        // the hero slot alone; the ACH hero has nothing to measure yet.
        show(achWrap, false);
        show(achEvidence, false);
        renderFix();
        show(fixWrap, true);
        // Same over-700 caution in shop mode: no single typical cleaner reaches it.
        // It stays keyed to needCadr and worded in CFM in BOTH rating modes — the
        // ceiling it warns about is a limit on how much air a consumer unit can
        // physically move, which does not change because the stat above is
        // currently phrased as air changes.
        show(cadrHighEl, needCadr > 700);
        setAnswer('Shop for this rating', 'shop');
        setVerdictCard('shop');
        setPrompt(false);
        if (shopPreview) {
          // Preview the recommended setup in the scene. The units drawn are the
          // ones the user PLANS to buy — cleanerCount, the same divisor the CADR
          // guidance is written against — not blocks.length, so a shopper who
          // entered cleaners and then answered "No" doesn't get a room full of
          // units they said they don't have. Clamped to what the scene can draw.
          sceneN = Math.min(Math.max(1, cleanerCount), MAX_CLEANERS);
          // Each planned unit pulses at its SHARE of the target, so the ripples
          // together read as exactly the target rate — the same cadence the pass
          // state will show once the recommended cleaners are actually in the
          // room. Lanes past the planned count get 0 and go idle, which is why
          // this re-syncs the flags: sceneN just moved under them.
          laneAch.length = 0;
          for (let i = 0; i < MAX_CLEANERS; i++) laneAch[i] = i < sceneN ? target / sceneN : 0;
          syncLaneIdle();
          stateNow = 'shop';
          container.dataset.state = 'shop';
          startLoop();
        } else {
          // No target entered — there is no rate to preview, so the scene stays
          // idle exactly as it did before the preview existed. The ghost gate above
          // already zeroed capSTgt; wake the loop only to ease a residual ghost
          // away, the same guard the no-room branch uses.
          stateNow = 'idle';
          container.dataset.state = 'idle';
          if (capS > 0.01) startLoop();
        }
        const n = cleanerCount;
        // The announcement follows the rating mode, so what is heard matches what
        // is shown. Spelled out, not "ACH": this string is spoken.
        announce(
          asAch
            ? `Look for a listing that covers at least ${fmt(Math.ceil(needCadr * 7.5), 0)} square feet ` +
              `at 1 air change per hour, or a matching size from the on-screen list at a higher ACH.`
            : n > 1
              ? `To reach ${fmt(target, 1)} air changes per hour, your cleaners' combined ` +
                `CADR needs to be at least ${fmt(needCadr, 0)} CFM.`
              : `To reach ${fmt(target, 1)} air changes per hour in this room, look for an ` +
                `air cleaner with a CADR of at least ${fmt(needCadr, 0)} CFM.`,
        );
      } else {
        // No room (defensive — the wizard shouldn't reach results without one).
        show(achWrap, false);
        show(fixWrap, false);
        setAnswer('', null);
        setVerdictCard(null);
        stateNow = 'idle';
        container.dataset.state = 'idle';
        setPrompt(true);
        announce('');
        // Wake the loop if the ghost still has residual scale to ease away (it was
        // showing, then flow/room cleared) — otherwise it'd freeze mid-shrink.
        if (capS > 0.01) startLoop();
      }
    };

    // Numbers only (no stepper, so no negative spinning): strip to digits + one dot.
    const sanitizeNumeric = (s: string): string => {
      let out = s.replace(/[^0-9.]/g, '');
      const dot = out.indexOf('.');
      if (dot !== -1) out = out.slice(0, dot + 1) + out.slice(dot + 1).replace(/\./g, '');
      return out;
    };
    // Switching room-entry mode: prefill the newly shown (empty) area/volume field
    // from the current drawn box so the scene never jumps. round(L·W) for area,
    // round(L·W·H) for volume; only when the target field is blank.
    const prefillMode = (method: string) => {
      // Derive from tgt (the last drawn box) — NOT sceneBox(), which would read
      // the new mode's still-blank fields and derive from the 0.5 ft fallbacks.
      // labelK un-clamps the drawn box back to the entered feet, so switching
      // modes on an over-SCENE_MAX room prefills the TRUE area/volume.
      const tL = tgt.L * labelK.L, tW = tgt.W * labelK.W, tH = tgt.H * labelK.H;
      if (method === 'area') {
        const f = field('area');
        if (f && !raw('area')) f.value = String(Math.round(tL * tW));
      } else if (method === 'volume') {
        const f = field('volume');
        if (f && !raw('volume')) f.value = String(Math.round(tL * tW * tH));
      }
    };

    const onEdit = (e: Event) => {
      const el = e.target as (HTMLElement & { value?: string; dataset?: DOMStringMap }) | null;
      if (el && el.tagName === 'ESA-TEXT-FIELD') {
        const clean = sanitizeNumeric(el.value ?? '');
        if (clean !== el.value) el.value = clean;
      }
      // Prefill before the mode's fields are read for the scene box.
      if (el && el.tagName === 'ESA-RADIO-GROUP' && el.dataset?.field === 'roomMethod') {
        prefillMode(el.value ?? 'dimensions');
      }
      // The slider writes its number into the target field and stops being
      // consulted — everything downstream reads the field. No synthetic input
      // event: this IS the pipeline, and the recompute() below re-derives the
      // thumb from the field it just wrote. The branch catches both events the
      // lego produces per drag tick (its own composed `change`, and the inner
      // native `input` retargeted to the host); writing the same string twice is
      // a no-op, so neither needs to be filtered out.
      if (el && el.dataset?.field === 'targetSlider') {
        const f = field('target');
        const v = (el as unknown as { value?: number }).value;
        if (f && v != null) f.value = String(v);
      }
      morphScene();
      recompute();
    };
    root.addEventListener('input', onEdit);
    root.addEventListener('change', onEdit);

    // Add / remove cleaner (delegated). Add clones the template; remove collapses
    // the clicked block. Both funnel through morphScene()/recompute().
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-add-cleaner]')) {
        e.preventDefault();
        if (cleanerBlocks().length >= MAX_CLEANERS) return;
        // Air cleaners are assumed identical: a new one copies the last cleaner's
        // values (blank if that one is still blank), so you only re-enter what
        // differs between them.
        addCleaner({ copyLast: true, animate: true });
        morphScene();
        recompute();
        // The add that reaches the cap hides this very button (syncVisibility
        // inside recompute), which would drop focus to <body>. Land it on the
        // new block's first control, and say why the button went away — the cap
        // note appears silently otherwise.
        const atCapNow = cleanerBlocks();
        if (atCapNow.length >= MAX_CLEANERS) {
          // The new block's Remove button: the one control of its own that is
          // guaranteed light-DOM (the esa form fields are shadow), and its
          // renumbered label announces where focus landed.
          const newest = atCapNow[atCapNow.length - 1];
          newest?.querySelector<HTMLButtonElement>('[data-remove-cleaner] button')?.focus();
          const capNote = root.querySelector('[data-cap-note]');
          kitAnnounce(
            capNote?.textContent?.trim()
              || 'You have added the maximum number of air cleaners.',
          );
        }
        return;
      }
      const rm = t.closest('[data-remove-cleaner]');
      if (rm) {
        e.preventDefault();
        const b = rm.closest<HTMLElement>('[data-cleaner-block]');
        if (b && !b.hasAttribute('data-removing')) removeCleaner(b);
      }
    });

    // ---- drag-to-resize: each grip edge converts pointer delta to feet via the
    // frozen fit scale + the per-axis screen unit vector, then types the snapped
    // value into the matching esa-text-field. The onEdit pipeline does the rest.
    // Drag → feet: project the pointer delta onto each edge's screen axis. Width
    // is inverted from its raw iso axis so pulling RIGHT enlarges it (matching
    // length), rather than the geometric down-left grow direction.
    const AXIS: Record<string, Pt> = {
      length: [COS30, SIN30], width: [COS30, -SIN30], height: [0, -1],
    };
    const KEY = { length: 'L', width: 'W', height: 'H' } as const;
    type DragDim = keyof typeof KEY;
    let drag: { dim: DragDim; sx: number; sy: number; v0: number; sc: number } | null = null;

    svg.addEventListener('pointerdown', (e) => {
      // Grips only resize in dimensions mode — the other room-entry modes have no
      // draggable edges (CSS also hides the handles).
      if (raw('roomMethod') !== 'dimensions') return;
      const grip = (e.target as Element).closest?.('[data-grip]');
      if (!grip) return;
      const dim = grip.getAttribute('data-grip') as DragDim;
      // v0 is the ENTERED value, not tgt — they differ only on a room past
      // SCENE_MAX, where tgt holds the clamped drawn box and dragging from it
      // would yank the field down to the clamp.
      drag = { dim, sx: e.clientX, sy: e.clientY, v0: pos(dim) || tgt[KEY[dim]], sc: fitScale };
      (e.target as Element).setPointerCapture(e.pointerId);
      container.dataset.dragging = dim;
      e.preventDefault();
    });
    svg.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const [ux, uy] = AXIS[drag.dim];
      const ft = ((e.clientX - drag.sx) * ux + (e.clientY - drag.sy) * uy) / drag.sc;
      const next = Math.min(ROOM_MAX[drag.dim], Math.max(ROOM_MIN, Math.round((drag.v0 + ft) * 2) / 2));
      const f = field(drag.dim);
      if (f && f.value !== String(next)) {
        f.value = String(next);
        f.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });
    const endDrag = () => { drag = null; delete container.dataset.dragging; };
    svg.addEventListener('pointerup', endDrag);
    svg.addEventListener('pointercancel', endDrag);

    // ---- wizard step navigation ----
    // Steps 0 room / 1 cleaners / 2 target gate forward; step 3 is the result
    // screen. Every step lives in the DOM at once (the engine reads all fields on
    // each recompute) — this only toggles which step is visible + the chrome, and
    // gates leaving the room step on a valid room size. The scene backdrop already
    // reflects every input regardless of the step shown.
    // PLAN — which step sections this run walks, in order, as indices into
    // stepSections/TITLES. It is not a constant because the two intents are not the
    // same length: a shopper has no cleaner to describe, so their run drops section 1
    // and becomes a two-step flow. Walking them through it anyway would mean a step
    // whose only content is the answer they already gave on the opening slide.
    // The dots, the "Step n of m" counter and the nav gates all read plan.length, so
    // nothing else has to be told the flow got shorter.
    const FULL_PLAN = [0, 1, 2];
    const SHOP_PLAN = [0, 2];
    const RESULT_SECTION = 3;
    let plan: number[] = FULL_PLAN;
    const TITLES = ['What size is your room?', 'What air cleaners do you have?', "What's your air-change target?", 'Your result'];
    const wizardEl = root.querySelector<HTMLElement>('[data-wizard]');
    const introEl = root.querySelector<HTMLElement>('[data-intro]');
    const introTitle = root.querySelector<HTMLElement>('[data-intro-title]');
    const stepSections = qa('[data-step]');
    const dots = qa('[data-dot]');
    const stepCountEl = root.querySelector('[data-step-count]');
    const stepTitleEl = root.querySelector('[data-step-title]');
    const roomHint = root.querySelector<HTMLElement>('[data-room-hint]');
    const navEl = (name: string) => root.querySelector<HTMLElement>(`[data-nav="${name}"]`);
    const roomValid = () => { const v = roomVolume(); return Number.isFinite(v) && v > 0; };
    let stepIdx = 0;

    // dir: +1 advancing (Next), -1 retreating (Back), 0 no slide (initial paint).
    const renderStep = (dir = 0) => {
      const isResult = stepIdx >= plan.length;
      const section = isResult ? RESULT_SECTION : plan[stepIdx];
      // The narrow layout keys the scene's visibility off the section (result only
      // — see the 68rem block); sceneLive re-reads the same flag so the rAF loop
      // starts and stops with the band.
      root.dataset.section = String(section);
      syncSceneLive();
      stepSections.forEach((s) => show(s, Number(s.dataset.step) === section));
      // Replay the enter animation on the now-visible step, sliding in from the
      // direction of travel. Removing both direction classes + forcing a reflow
      // before re-adding restarts the animation each step change (it would
      // otherwise only run once); the step is display:block by now.
      const active = stepSections.find((s) => Number(s.dataset.step) === section);
      if (active) {
        active.classList.remove('smaqmd-wizard__step--enter-fwd', 'smaqmd-wizard__step--enter-back');
        if (dir !== 0) {
          void active.offsetWidth;
          active.classList.add(dir < 0 ? 'smaqmd-wizard__step--enter-back' : 'smaqmd-wizard__step--enter-fwd');
        }
      }
      dots.forEach((d, i) => {
        // A two-step run shows two dots. The third is hidden rather than relabelled:
        // the dots ARE the step count, so leaving a dead one on would promise a step
        // the shopper never reaches. On the result there are no steps left to count,
        // so the dots go entirely.
        show(d, !isResult && i < plan.length);
        d.toggleAttribute('data-active', i === stepIdx && !isResult);
        d.toggleAttribute('data-done', i < stepIdx);
      });
      show(root.querySelector<HTMLElement>('.smaqmd-wizard__dots'), !isResult);
      if (stepCountEl) stepCountEl.textContent = isResult ? 'Result' : `Step ${stepIdx + 1} of ${plan.length}`;
      // On the result step the verdict headline takes over the header band: the h2
      // mirrors the hidden [data-answer-title] holder recompute() wrote, and
      // data-verdict on the wizard root tints the band + title (fail = warning).
      if (stepTitleEl) {
        const t = isResult ? answerTitle?.textContent?.trim() : null;
        stepTitleEl.textContent = t && t !== '—' ? t : TITLES[section];
      }
      const verdict = isResult ? answerG?.getAttribute('data-verdict') : null;
      if (wizardEl) {
        if (verdict) wizardEl.setAttribute('data-verdict', verdict);
        else wizardEl.removeAttribute('data-verdict');
      }
      // Back is offered on the first step too when there is an opening slide to go
      // back TO — without it the intent chosen there would be unchangeable, and a
      // shopper who realises they do own a cleaner would have no way out.
      show(navEl('back'), stepIdx > 0 || !!introEl);
      show(navEl('next'), stepIdx < plan.length - 1);
      show(navEl('result'), stepIdx === plan.length - 1);
      show(navEl('restart'), isResult);
      if (roomHint && section !== 0) show(roomHint, false);
      // Re-fit the scene: the panel height changes between steps, which moves the
      // safe-area sentinel; a sync recentres the cutaway for the new frame.
      syncViewport();
      // A11y: on a real navigation (not the initial paint), move focus to the new
      // step's heading so screen-reader + keyboard users land in — and hear — the
      // step they advanced to, instead of focus being stranded on the old button.
      // The header h2 is the title on every step now, the result included.
      if (dir !== 0) (stepTitleEl as HTMLElement | null)?.focus();
    };

    const goStep = (i: number) => {
      const next = Math.min(Math.max(0, i), plan.length);
      // Forward gate: you can't leave the room step without a valid room size.
      if (next > stepIdx && plan[stepIdx] === 0 && !roomValid()) {
        if (roomHint) show(roomHint, true);
        return;
      }
      const dir = next === stepIdx ? 0 : next > stepIdx ? 1 : -1;
      stepIdx = next;
      renderStep(dir);
    };

    // Returning to the opening slide is a step change like any other, so it moves
    // focus the same way renderStep does — onto the heading of what is now on screen.
    const toIntro = () => {
      stepIdx = 0;
      // No section is on screen while the opening slide is — clear the flag so the
      // narrow layout hides the scene again (and the loop stops with it).
      delete root.dataset.section;
      syncSceneLive();
      wizardEl?.setAttribute('data-phase', 'intro');
      introTitle?.focus();
    };
    const backOrIntro = () => { if (stepIdx === 0 && introEl) toIntro(); else goStep(stepIdx - 1); };

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      // The two intent buttons on the opening slide. Each writes the answer into the
      // hasCleaner radio group — the field the engine already reads — rather than
      // introducing a second piece of state that could disagree with it. Setting the
      // property fires no event, so the two listeners that would have run are called
      // by hand.
      const intent = t.closest('[data-nav="check"], [data-nav="shop"]');
      if (intent) {
        e.preventDefault();
        const shopping = intent.matches('[data-nav="shop"]');
        const hasCleanerEl = field('hasCleaner');
        if (hasCleanerEl) hasCleanerEl.value = shopping ? 'no' : 'yes';
        syncVisibility();
        recompute();
        plan = shopping ? SHOP_PLAN : FULL_PLAN;
        stepIdx = 0;
        // Hand the card over to the step machinery, then render with a direction so
        // it reuses renderStep's own focus move onto the heading — leaving the intro
        // is a change of context, same as any step change.
        wizardEl?.setAttribute('data-phase', 'steps');
        renderStep(1);
      }
      else if (t.closest('[data-nav="next"]'))   { e.preventDefault(); goStep(stepIdx + 1); }
      else if (t.closest('[data-nav="result"]'))  { e.preventDefault(); goStep(plan.length); }
      else if (t.closest('[data-nav="back"]'))    { e.preventDefault(); backOrIntro(); }
      else if (t.closest('[data-nav="restart"]')) { e.preventDefault(); if (introEl) toIntro(); else goStep(0); }
    });
    // Clear the room-required hint the moment a valid room is entered.
    root.addEventListener('input', () => {
      if (stepIdx === 0 && roomHint && roomValid()) show(roomHint, false);
    });

    // Boot: stamp the (blank) first cleaner and draw the default scene immediately
    // (cur/tgt default to 12×10×8). Once the legos upgrade — so field .value
    // getters read entered attributes — sync the mode wrappers/entry-mode flag,
    // snap the box to the fields, and compute, opening on the "no cleaner yet →
    // minimum CADR to look for" state (room 12×10×8, target 2, no pulse).
    resetCleaners();
    drawScene(cur.L, cur.W, cur.H);
    Promise.all([
      customElements.whenDefined('esa-text-field'),
      customElements.whenDefined('esa-radio-group'),
    ]).then(() => {
      syncVisibility();
      morphScene();
      recompute();
      renderStep();
    });
  }
</script>
